{"pageProps": {"params": {"versionId": "59", "usfm": "ISA.60.ASW"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/ISA/60-8a2103247ca18faf694ab95ab3ce5587.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/ISA/60-8a2103247ca18faf694ab95ab3ce5587.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkISA\">\n        <div class=\"chapter ch60\" data-usfm=\"ISA.60\">\n            <div class=\"label\">60</div><div class=\"s1\"><span class=\"heading\">The Future Glory of Israel</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"ISA.60.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Eph. 5:14]   </span></span><span class=\"content\">Arise, shine, for your light has come,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"ISA.60.1\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 40:5; 58:8; Mal. 4:2</span></span><span class=\"content\">the glory of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> has risen upon you.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"ISA.60.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"ISA.60.2\"><span class=\"label\">2</span><span class=\"content\">For behold, darkness shall cover the earth,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ISA.60.2\"><span class=\"content\">and thick darkness the peoples;</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ISA.60.2\"><span class=\"content\">but the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> will arise upon you,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ISA.60.2\"><span class=\"content\">and his glory will be seen upon you.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ISA.60.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"ISA.60.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 42:6; 49:6; Rev. 21:24  </span></span><span class=\"content\">And nations shall come to your light,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"ISA.60.3\"><span class=\"content\">and kings to the brightness of your rising.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"ISA.60.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"ISA.60.4\"><span class=\"label\">4</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 49:18   </span></span><span class=\"content\">Lift up your eyes all around, and see;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"ISA.60.4\"><span class=\"content\">they all gather together, they come to you;</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"ISA.60.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 9; ch. 66:20  </span></span><span class=\"content\">your sons shall come from afar,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"ISA.60.4\"><span class=\"content\">and your daughters shall be carried on the hip.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"ISA.60.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"ISA.60.5\"><span class=\"label\">5</span><span class=\"content\">Then you shall see and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 34:5 </span></span><span class=\"content\">be radiant;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ISA.60.5\"><span class=\"content\">your heart shall thrill and exult,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">60:5 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">your heart shall tremble and grow wide</span></span></span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"ISA.60.5\"><span class=\"content\">because the abundance of the sea shall be turned to you,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ISA.60.5\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 61:6  </span></span><span class=\"content\">the wealth of the nations shall come to you.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"ISA.60.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"ISA.60.6\"><span class=\"label\">6</span><span class=\"content\">A multitude of camels shall cover you,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ISA.60.6\"><span class=\"content\">the young camels of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Judg. 6:5 </span></span><span class=\"content\">Midian and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 25:4 </span></span><span class=\"content\">Ephah;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ISA.60.6\"><span class=\"content\">all those from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Kgs. 10:1; Ps. 72:10 </span></span><span class=\"content\">Sheba shall come.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"ISA.60.6\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 2:11]  </span></span><span class=\"content\">They shall bring gold and frankincense,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ISA.60.6\"><span class=\"content\">and shall bring good news, the praises of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"ISA.60.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"ISA.60.7\"><span class=\"label\">7</span><span class=\"content\">All the flocks of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 21:16 </span></span><span class=\"content\">Kedar shall be gathered to you;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ISA.60.7\"><span class=\"content\">the rams of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 25:13; 28:9; 36:3 </span></span><span class=\"content\">Nebaioth shall minister to you;</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ISA.60.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 56:7   </span></span><span class=\"content\">they shall come up with acceptance on my altar,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ISA.60.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Hag. 2:7\n        </span></span><span class=\"content\">and I will beautify my beautiful house.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ISA.60.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"ISA.60.8\"><span class=\"label\">8</span><span class=\"content\">Who are these that fly like a cloud,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"ISA.60.8\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Hos. 11:11; [Gen. 8:9]</span></span><span class=\"content\">like doves to their windows?</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"ISA.60.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"ISA.60.9\"><span class=\"label\">9</span><span class=\"content\">For </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 51:5; See ch. 11:11 </span></span><span class=\"content\">the coastlands shall hope for me,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"ISA.60.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 2:16   </span></span><span class=\"content\">the ships of Tarshish first,</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"ISA.60.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Gal. 4:26   </span></span><span class=\"content\">to bring your children from afar,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"ISA.60.9\"><span class=\"content\">their silver and gold with them,</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"ISA.60.9\"><span class=\"content\">for the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> your God,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"ISA.60.9\"><span class=\"content\">and for the Holy One of Israel,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"ISA.60.9\"><span class=\"content\">because </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 44:23; 55:5</span></span><span class=\"content\">he has made you beautiful.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"ISA.60.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"ISA.60.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 45:1, 13; Zech. 6:15  </span></span><span class=\"content\">Foreigners shall build up your walls,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"ISA.60.10\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 45:1, 13; Zech. 6:15</span></span><span class=\"content\">their kings shall minister to you;</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"ISA.60.10\"><span class=\"content\">for in my wrath I struck you,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"ISA.60.10\"><span class=\"content\">but in my favor I have had mercy on you.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"ISA.60.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"ISA.60.11\"><span class=\"label\">11</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Rev. 21:25, 26]  </span></span><span class=\"content\">Your gates shall be open continually;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"ISA.60.11\"><span class=\"content\">day and night they shall not be shut,</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"ISA.60.11\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Rev. 21:25, 26]  </span></span><span class=\"content\">that people may bring to you the wealth of the nations,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"ISA.60.11\"><span class=\"content\">with their kings led in procession.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"ISA.60.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"ISA.60.12\"><span class=\"label\">12</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Zech. 14:17-19]  </span></span><span class=\"content\">For the nation and kingdom</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"ISA.60.12\"><span class=\"content\">that will not serve you shall perish;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"ISA.60.12\"><span class=\"content\">those nations shall be utterly laid waste.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"ISA.60.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"ISA.60.13\"><span class=\"label\">13</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 35:2   </span></span><span class=\"content\">The glory of Lebanon shall come to you,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"ISA.60.13\"><span class=\"content\">the cypress, the plane, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 41:19</span></span><span class=\"content\">the pine,</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"ISA.60.13\"><span class=\"content\">to beautify the place of my sanctuary,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"ISA.60.13\"><span class=\"content\">and I will make the place of my feet glorious.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"ISA.60.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"ISA.60.14\"><span class=\"label\">14</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 14:1, 2; Zech. 8:23]   </span></span><span class=\"content\">The sons of those who afflicted you</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"ISA.60.14\"><span class=\"content\">shall come bending low to you,</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"ISA.60.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 49:23; [Rev. 3:9]   </span></span><span class=\"content\">and all who despised you</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"ISA.60.14\"><span class=\"content\">shall bow down at your feet;</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"ISA.60.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 1:26; 62:2]  </span></span><span class=\"content\">they shall call you the City of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"ISA.60.14\"><span class=\"content\">the Zion of the Holy One of Israel.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"ISA.60.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"ISA.60.15\"><span class=\"label\">15</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 54:6; 62:4   </span></span><span class=\"content\">Whereas you have been forsaken and hated,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"ISA.60.15\"><span class=\"content\">with no one passing through,</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"ISA.60.15\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 47:4; [ch. 65:18]  </span></span><span class=\"content\">I will make you majestic forever,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"ISA.60.15\"><span class=\"content\">a joy from age to age.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"ISA.60.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"ISA.60.16\"><span class=\"label\">16</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 49:23; 66:11, 12]   </span></span><span class=\"content\">You shall suck the milk of nations;</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"ISA.60.16\"><span class=\"content\">you shall nurse at the breast of kings;</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"ISA.60.16\"><span class=\"content\">and you shall know that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 43:3; 49:26; [ch. 47:4] </span></span><span class=\"content\">I, the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, am your Savior</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"ISA.60.16\"><span class=\"content\">and your Redeemer, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 49:24; Ps. 132:2</span></span><span class=\"content\">the Mighty One of Jacob.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"ISA.60.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"ISA.60.17\"><span class=\"label\">17</span><span class=\"content\">Instead of bronze I will bring gold,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"ISA.60.17\"><span class=\"content\">and instead of iron I will bring silver;</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"ISA.60.17\"><span class=\"content\">instead of wood, bronze,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"ISA.60.17\"><span class=\"content\">instead of stones, iron.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"ISA.60.17\"><span class=\"content\">I will make your overseers peace</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"ISA.60.17\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 58:3]  </span></span><span class=\"content\">and your taskmasters righteousness.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"ISA.60.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"ISA.60.18\"><span class=\"label\">18</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 11:9   </span></span><span class=\"content\">Violence shall no more be heard in your land,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"ISA.60.18\"><span class=\"content\">devastation or destruction within your borders;</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"ISA.60.18\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 26:1  </span></span><span class=\"content\">you shall call your walls Salvation,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"ISA.60.18\"><span class=\"content\">and your gates Praise.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"ISA.60.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"ISA.60.19\"><span class=\"label\">19</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Zech. 14:6, 7; Rev. 21:23; 22:5; [ch. 24:23; 30:26]  </span></span><span class=\"content\">The sun shall be no more</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"ISA.60.19\"><span class=\"content\">your light by day,</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"ISA.60.19\"><span class=\"content\">nor for brightness shall the moon</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"ISA.60.19\"><span class=\"content\">give you light;</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">60:19 </span><span class=\"ft\">Masoretic Text; Dead Sea Scroll, Septuagint, Targum add </span><span class=\"fq\">by night</span></span></span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"ISA.60.19\"><span class=\"content\">but the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> will be your everlasting light,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"ISA.60.19\"><span class=\"content\">and your God will be your glory.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">60:19 </span><span class=\"ft\">Or </span><span class=\"fq\">your beauty</span></span></span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"ISA.60.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"ISA.60.20\"><span class=\"label\">20</span><span class=\"content\">Your sun shall no more go down,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"ISA.60.20\"><span class=\"content\">nor your moon withdraw itself;</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"ISA.60.20\"><span class=\"content\">for the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> will be your everlasting light,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"ISA.60.20\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 35:10; 65:19; Rev. 21:4</span></span><span class=\"content\">your days of mourning shall be ended.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"ISA.60.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"ISA.60.21\"><span class=\"label\">21</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 52:1; Jer. 31:34   </span></span><span class=\"content\">Your people shall all be righteous;</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"ISA.60.21\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 37:9; See Ezek. 37:25   </span></span><span class=\"content\">they shall possess the land forever,</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"ISA.60.21\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 61:3  </span></span><span class=\"content\">the branch of my planting, the work of my hands,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"ISA.60.21\"><span class=\"content\">that I might be glorified.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">60:21 </span><span class=\"ft\">Or </span><span class=\"fq\">that I might display my beauty</span></span></span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"ISA.60.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"ISA.60.22\"><span class=\"label\">22</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 13:31]   </span></span><span class=\"content\">The least one shall become a clan,</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"ISA.60.22\"><span class=\"content\">and the smallest one a mighty nation;</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"ISA.60.22\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Hab. 2:3\n        </span></span><span class=\"content\">I am the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"ISA.60.22\"><span class=\"content\">in its time I will hasten it.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["ISA.61"], "human": "Isaiah 61", "toc": true, "version_id": 59}, "pre