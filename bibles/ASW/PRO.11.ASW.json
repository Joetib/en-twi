{"pageProps": {"params": {"versionId": "59", "usfm": "PRO.11.ASW"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PRO/11-8d0770232ecdb2e8d70f1f78cbaa9876.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PRO/11-8d0770232ecdb2e8d70f1f78cbaa9876.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPRO\">\n        <div class=\"chapter ch11\" data-usfm=\"PRO.11\">\n            <div class=\"label\">11</div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PRO.11.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 16:11; 20:10, 23; See Lev. 19:35, 36   </span></span><span class=\"content\">A false balance is an abomination to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PRO.11.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 12:22]  </span></span><span class=\"content\">but a just weight is his delight.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PRO.11.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PRO.11.2\"><span class=\"label\">2</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 16:18; 18:12; 29:23; [Dan. 4:30, 31]   </span></span><span class=\"content\">When pride comes, then comes disgrace,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PRO.11.2\"><span class=\"content\">but with </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Mic. 6:8</span></span><span class=\"content\">the humble is wisdom.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PRO.11.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PRO.11.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 13:6   </span></span><span class=\"content\">The integrity of the upright guides them,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PRO.11.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 19:3  </span></span><span class=\"content\">but the crookedness of the treacherous destroys them.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PRO.11.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PRO.11.4\"><span class=\"label\">4</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Zeph. 1:18; See ch. 10:2   </span></span><span class=\"content\">Riches do not profit in the day of wrath,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PRO.11.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Gen. 7:1]  </span></span><span class=\"content\">but righteousness delivers from death.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PRO.11.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PRO.11.5\"><span class=\"label\">5</span><span class=\"content\">The righteousness of the blameless </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:6</span></span><span class=\"content\">keeps his way straight,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PRO.11.5\"><span class=\"content\">but the wicked falls by his own wickedness.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PRO.11.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PRO.11.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [See ver. 4 above]   </span></span><span class=\"content\">The righteousness of the upright delivers them,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PRO.11.6\"><span class=\"content\">but the treacherous </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 7:15, 16</span></span><span class=\"content\">are taken captive by their lust.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PRO.11.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PRO.11.7\"><span class=\"label\">7</span><span class=\"content\">When the wicked dies, his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 10:28 </span></span><span class=\"content\">hope will perish,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PRO.11.7\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Job 8:13, 14</span></span><span class=\"content\">the expectation of wealth</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">11:7 </span><span class=\"ft\">Or </span><span class=\"fq\">of his strength</span><span class=\"ft\">, or </span><span class=\"fq\">of iniquity</span></span></span><span class=\"content\"> perishes too.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PRO.11.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PRO.11.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 6; [ch. 21:18]  </span></span><span class=\"content\">The righteous is delivered from trouble,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PRO.11.8\"><span class=\"content\">and the wicked walks into it instead.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PRO.11.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PRO.11.9\"><span class=\"label\">9</span><span class=\"content\">With his mouth the godless man would destroy his neighbor,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PRO.11.9\"><span class=\"content\">but by knowledge the righteous are delivered.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PRO.11.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PRO.11.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 28:12; Esth. 8:15]  </span></span><span class=\"content\">When it goes well with the righteous, the city rejoices,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PRO.11.10\"><span class=\"content\">and when the wicked perish there are shouts of gladness.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PRO.11.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PRO.11.11\"><span class=\"label\">11</span><span class=\"content\">By the blessing of the upright a city is exalted,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PRO.11.11\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 10:7 </span></span><span class=\"content\">by the mouth of the wicked </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 14:1; 29:8]</span></span><span class=\"content\">it is overthrown.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PRO.11.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PRO.11.12\"><span class=\"label\">12</span><span class=\"content\">Whoever </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 14:21; [Matt. 7:1]</span></span><span class=\"content\">belittles his neighbor lacks sense,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PRO.11.12\"><span class=\"content\">but a man of understanding remains silent.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PRO.11.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PRO.11.13\"><span class=\"label\">13</span><span class=\"content\">Whoever </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 20:19; Lev. 19:16</span></span><span class=\"content\">goes about slandering reveals secrets,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PRO.11.13\"><span class=\"content\">but he who is trustworthy in spirit keeps a thing covered.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PRO.11.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PRO.11.14\"><span class=\"label\">14</span><span class=\"content\">Where there is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 15:22; 20:18; 24:6</span></span><span class=\"content\">no guidance, a people falls,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PRO.11.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 15:22; 20:18; 24:6  </span></span><span class=\"content\">but in an abundance of counselors there is safety.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PRO.11.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PRO.11.15\"><span class=\"label\">15</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 6:1; Job 17:3]  </span></span><span class=\"content\">Whoever puts up security for a stranger will surely suffer harm,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PRO.11.15\"><span class=\"content\">but he who hates striking hands in pledge is secure.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PRO.11.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PRO.11.16\"><span class=\"label\">16</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 31:30]   </span></span><span class=\"content\">A gracious woman gets honor,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PRO.11.16\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Luke 11:21]</span></span><span class=\"content\">violent men get riches.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PRO.11.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PRO.11.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 5:7]; See Matt. 25:34-40  </span></span><span class=\"content\">A man who is kind benefits himself,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PRO.11.17\"><span class=\"content\">but a cruel man hurts himself.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PRO.11.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PRO.11.18\"><span class=\"label\">18</span><span class=\"content\">The wicked earns deceptive wages,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PRO.11.18\"><span class=\"content\">but one who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Hos. 10:12; Gal. 6:8, 9; [James 3:18]</span></span><span class=\"content\">sows righteousness gets a sure reward.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"PRO.11.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"PRO.11.19\"><span class=\"label\">19</span><span class=\"content\">Whoever is steadfast in righteousness </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 10:16; 19:23 </span></span><span class=\"content\">will live,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"PRO.11.19\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Rom. 6:23; Gal. 6:8]</span></span><span class=\"content\">he who pursues evil will die.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"PRO.11.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"PRO.11.20\"><span class=\"label\">20</span><span class=\"content\">Those of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 17:20] </span></span><span class=\"content\">crooked heart are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 12:22; 16:5 </span></span><span class=\"content\">an abomination to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"PRO.11.20\"><span class=\"content\">but those of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 13:6; Ps. 119:1 </span></span><span class=\"content\">blameless ways are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Chr. 29:17</span></span><span class=\"content\">his delight.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"PRO.11.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"PRO.11.21\"><span class=\"label\">21</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 16:5   </span></span><span class=\"content\">Be assured, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 12:7; [Ps. 37:2, 9]; See Isa. 28:15-18 </span></span><span class=\"content\">an evil person will not go unpunished,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"PRO.11.21\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 112:2</span></span><span class=\"content\">the offspring of the righteous will be delivered.</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"PRO.11.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"PRO.11.22\"><span class=\"label\">22</span><span class=\"content\">Like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 24:47; Isa. 3:21; Ezek. 16:12]</span></span><span class=\"content\">a gold ring in a pig&#8217;s snout</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"PRO.11.22\"><span class=\"content\">is a beautiful woman without discretion.</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"PRO.11.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"PRO.11.23\"><span class=\"label\">23</span><span class=\"content\">The desire of the righteous ends only in good,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"PRO.11.23\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Rom. 2:8, 9  </span></span><span class=\"content\">the expectation of the wicked in wrath.</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"PRO.11.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"PRO.11.24\"><span class=\"label\">24</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 13:7   </span></span><span class=\"content\">One gives </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 37:21; 112:9; [ch. 19:17]</span></span><span class=\"content\">freely, yet grows all the richer;</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"PRO.11.24\"><span class=\"content\">another withholds what he should give, and only suffers want.</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"PRO.11.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"PRO.11.25\"><span class=\"label\">25</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See 2 Cor. 9:6-11   </span></span><span class=\"content\">Whoever brings blessing </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 13:4; 28:25 </span></span><span class=\"content\">will be enriched,</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"PRO.11.25\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Matt. 7:2]</span></span><span class=\"content\">one who waters will himself be watered.</span></span></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"PRO.11.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"PRO.11.26\"><span class=\"label\">26</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 24:24   </span></span><span class=\"content\">The people curse him who holds back grain,</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"PRO.11.26\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Job 29:13] </span></span><span class=\"content\">a blessing is on the head of him who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 42:6]</span></span><span class=\"content\">sells it.</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"PRO.11.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"PRO.11.27\"><span class=\"label\">27</span><span class=\"content\">Whoever diligently seeks good seeks favor,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">11:27 </span><span class=\"ft\">Or </span><span class=\"fq\">acceptance</span></span></span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"PRO.11.27\"><span class=\"content\">but evil comes to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 7:16</span></span><span class=\"content\">him who searches for it.</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"PRO.11.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"PRO.11.28\"><span class=\"label\">28</span><span class=\"content\">Whoever </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 49:6 </span></span><span class=\"content\">trusts in his riches will fall,</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"PRO.11.28\"><span class=\"content\">but the righteous will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jer. 17:8; See Ps. 92:12</span></span><span class=\"content\">flourish like a green leaf.</span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"PRO.11.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"PRO.11.29\"><span class=\"label\">29</span><span class=\"content\">Whoever </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 15:27 </span></span><span class=\"content\">troubles his own household will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Eccles. 5:16]</span></span><span class=\"content\">inherit the wind,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"PRO.11.29\"><span class=\"content\">and the fool will be servant to the wise of heart.</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"PRO.11.29\"><span class=\"content\">  </span></span><span class=\"verse v30\" data-usfm=\"PRO.11.30\"><span class=\"label\">30</span><span class=\"content\">The fruit of the righteous is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 3:18 </span></span><span class=\"content\">a tree of life,</span></span></div><div class=\"q2\"><span class=\"verse v30\" data-usfm=\"PRO.11.30\"><span class=\"content\">and whoever </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Dan. 12:3; James 5:20; See 1 Cor. 9:19-22</span></span><span class=\"content\">captures souls is wise.</span></span></div><div class=\"q1\"><span class=\"verse v30\" data-usfm=\"PRO.11.30\"><span class=\"content\">  </span></span><span class=\"verse v31\" data-usfm=\"PRO.11.31\"><span class=\"label\">31</span><span class=\"content\">If </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Jer. 25:29; 1 Pet. 4:18]</span></span><span class=\"content\">the righteous is repaid on earth,</span></span></div><div class=\"q2\"><span class=\"verse v31\" data-usfm=\"PRO.11.31\"><span class=\"content\">how much more the wicked and the sinner!</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PRO.12"], "human": "Proverbs 12", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PRO.10"], "human": "Proverbs 10", "toc": true, "version_id": 59}, "reference": {"usfm": ["PRO.11"], "human": "Proverbs 11", "version_id": 59}}, "usfm": "PRO.11.ASW", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good