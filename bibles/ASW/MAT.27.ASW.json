"i18n": {"defaultLocale": "en", "locales": ["af", "am", "aml", "ar", "as", "be", "bg", "bn", "ca", "ckb", "cs", "cy", "da", "de", "el", "en", "en-GB", "eo", "es", "es-ES", "et", "fa", "fi", "fr", "gu", "he", "hi", "hr", "ht", "hu", "hy", "id", "ig", "is", "it", "ja", "ka", "km", "kn", "ko", "lt", "lv", "mk", "ml", "mn", "mr", "ms", "my", "my-MM", "ne", "nl", "no", "pa", "pl", "pt", "pt-PT", "ro", "ru", "si", "sk", "sl", "sn", "sq", "sr", "sv", "sw", "ta", "te", "tg", "th", "tl", "tr", "uk", "ur", "usi", "uz", "vi", "yo", "zh-CN", "zh-HK", "zh-TW", "zu"]}}}}, "getLayoutProps": {"className": "max-w-full w-full", "showOverflowX": "true"}}, "__N_SSG": true}