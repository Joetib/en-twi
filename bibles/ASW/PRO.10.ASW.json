{"pageProps": {"params": {"versionId": "59", "usfm": "PRO.10.ASW"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PRO/10-20a7454c150d30fdb066b09841171874.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PRO/10-20a7454c150d30fdb066b09841171874.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPRO\">\n        <div class=\"chapter ch10\" data-usfm=\"PRO.10\">\n            <div class=\"label\">10</div><div class=\"s1\"><span class=\"heading\">The Proverbs of Solomon</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PRO.10.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 1:1   </span></span><span class=\"content\">The proverbs of Solomon.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PRO.10.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 29:3   </span></span><span class=\"content\">A wise son makes a glad father,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PRO.10.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 17:25; 29:15  </span></span><span class=\"content\">but a foolish son is a sorrow to his mother.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PRO.10.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PRO.10.2\"><span class=\"label\">2</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 21:6; Ezek. 7:19; Luke 12:19, 20]   </span></span><span class=\"content\">Treasures gained by wickedness do not profit,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PRO.10.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 11:4, 6  </span></span><span class=\"content\">but righteousness delivers from death.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PRO.10.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PRO.10.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 34:9, 10; 37:25; [Matt. 6:33]   </span></span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> does not let the righteous go hungry,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PRO.10.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 112:10; James 4:3]  </span></span><span class=\"content\">but he thwarts the craving of the wicked.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PRO.10.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PRO.10.4\"><span class=\"label\">4</span><span class=\"content\">A slack hand </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 6:11; 12:24; 13:4] </span></span><span class=\"content\">causes poverty,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PRO.10.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 21:5  </span></span><span class=\"content\">but the hand of the diligent makes rich.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PRO.10.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PRO.10.5\"><span class=\"label\">5</span><span class=\"content\">He who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 6:8] </span></span><span class=\"content\">gathers in summer is a prudent son,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PRO.10.5\"><span class=\"content\">but he who sleeps in harvest is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 17:2; 19:26</span></span><span class=\"content\">a son who brings shame.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PRO.10.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PRO.10.6\"><span class=\"label\">6</span><span class=\"content\">Blessings are on the head of the righteous,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PRO.10.6\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 32</span></span><span class=\"content\">the mouth of the wicked conceals violence.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">10:6 </span><span class=\"ft\">Or </span><span class=\"fq\">but violence covers the mouth of the wicked</span><span class=\"ft\">; also verse 11</span></span></span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PRO.10.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PRO.10.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 112:6   </span></span><span class=\"content\">The memory of the righteous is a blessing,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PRO.10.7\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 9:5]</span></span><span class=\"content\">the name of the wicked will rot.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PRO.10.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PRO.10.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 7:24, 25]  </span></span><span class=\"content\">The wise of heart will receive commandments,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PRO.10.8\"><span class=\"content\">but a babbling fool will come to ruin.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PRO.10.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PRO.10.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 3:23; 28:18; Ps. 23:4; Isa. 33:15, 16   </span></span><span class=\"content\">Whoever walks in integrity walks securely,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PRO.10.9\"><span class=\"content\">but he who makes his ways crooked </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Matt. 10:26; 1 Tim. 5:25]</span></span><span class=\"content\">will be found out.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PRO.10.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PRO.10.10\"><span class=\"label\">10</span><span class=\"content\">Whoever </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 6:13</span></span><span class=\"content\">winks the eye causes trouble,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PRO.10.10\"><span class=\"content\">and a babbling fool will come to ruin.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PRO.10.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PRO.10.11\"><span class=\"label\">11</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 37:30   </span></span><span class=\"content\">The mouth of the righteous is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 13:14; Ps. 36:9 </span></span><span class=\"content\">a fountain of life,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PRO.10.11\"><span class=\"content\">but the mouth of the wicked </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 6 above]</span></span><span class=\"content\">conceals violence.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PRO.10.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PRO.10.12\"><span class=\"label\">12</span><span class=\"content\">Hatred stirs up strife,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PRO.10.12\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Pet. 4:8; [James 5:20]</span></span><span class=\"content\">love covers all offenses.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PRO.10.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PRO.10.13\"><span class=\"label\">13</span><span class=\"content\">On the lips of him who has understanding, wisdom is found,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PRO.10.13\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 19:29; 26:3 </span></span><span class=\"content\">a rod is for the back of him who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 6:32</span></span><span class=\"content\">lacks sense.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PRO.10.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PRO.10.14\"><span class=\"label\">14</span><span class=\"content\">The wise </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 8; ch. 12:23] </span></span><span class=\"content\">lay up knowledge,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PRO.10.14\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 18:7</span></span><span class=\"content\">the mouth of a fool brings ruin near.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PRO.10.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PRO.10.15\"><span class=\"label\">15</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 18:11; [Ps. 52:7; Mark 10:24, 25]  </span></span><span class=\"content\">A rich man&#8217;s wealth is his strong city;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PRO.10.15\"><span class=\"content\">the poverty of the poor is their ruin.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PRO.10.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PRO.10.16\"><span class=\"label\">16</span><span class=\"content\">The wage of the righteous leads </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 11:19; 19:23</span></span><span class=\"content\">to life,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PRO.10.16\"><span class=\"content\">the gain of the wicked to sin.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PRO.10.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PRO.10.17\"><span class=\"label\">17</span><span class=\"content\">Whoever heeds instruction is on </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 6:23]</span></span><span class=\"content\">the path to life,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PRO.10.17\"><span class=\"content\">but he who rejects reproof leads others astray.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PRO.10.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PRO.10.18\"><span class=\"label\">18</span><span class=\"content\">The one who conceals hatred has lying lips,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PRO.10.18\"><span class=\"content\">and whoever utters slander is a fool.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"PRO.10.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"PRO.10.19\"><span class=\"label\">19</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 12:36, 37]   </span></span><span class=\"content\">When words are many, transgression is not lacking,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"PRO.10.19\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 17:27; [James 3:2]  </span></span><span class=\"content\">but whoever restrains his lips is prudent.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"PRO.10.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"PRO.10.20\"><span class=\"label\">20</span><span class=\"content\">The tongue of the righteous is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 8:19; 16:16</span></span><span class=\"content\">choice silver;</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"PRO.10.20\"><span class=\"content\">the heart of the wicked is of little worth.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"PRO.10.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"PRO.10.21\"><span class=\"label\">21</span><span class=\"content\">The lips of the righteous feed many,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"PRO.10.21\"><span class=\"content\">but fools die for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Hos. 4:6]</span></span><span class=\"content\">lack of sense.</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"PRO.10.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"PRO.10.22\"><span class=\"label\">22</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Gen. 24:35; 26:12; Deut. 8:18]  </span></span><span class=\"content\">The blessing of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> makes rich,</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"PRO.10.22\"><span class=\"content\">and he adds no sorrow with it.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">10:22 </span><span class=\"ft\">Or </span><span class=\"fq\">and toil adds nothing to it</span></span></span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"PRO.10.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"PRO.10.23\"><span class=\"label\">23</span><span class=\"content\">Doing wrong is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:14; 15:21 </span></span><span class=\"content\">like a joke to a fool,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"PRO.10.23\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 8:30]</span></span><span class=\"content\">wisdom is pleasure to a man of understanding.</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"PRO.10.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"PRO.10.24\"><span class=\"label\">24</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 66:4; Heb. 10:27; [Job 15:21]   </span></span><span class=\"content\">What the wicked dreads </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 3:25 </span></span><span class=\"content\">will come upon him,</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"PRO.10.24\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 145:19; Matt. 5:6; 1 John 5:14, 15</span></span><span class=\"content\">the desire of the righteous will be granted.</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"PRO.10.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"PRO.10.25\"><span class=\"label\">25</span><span class=\"content\">When </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Job 21:18; Ps. 58:9]; See Matt. 7:26, 27 </span></span><span class=\"content\">the tempest passes, the wicked is no more,</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"PRO.10.25\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 12:3; Ps. 15:5; [Matt. 7:24, 25]</span></span><span class=\"content\">the righteous is established forever.</span></span></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"PRO.10.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"PRO.10.26\"><span class=\"label\">26</span><span class=\"content\">Like vinegar to the teeth and smoke to the eyes,</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"PRO.10.26\"><span class=\"content\">so is the sluggard to those who send him.</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"PRO.10.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"PRO.10.27\"><span class=\"label\">27</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 3:2   </span></span><span class=\"content\">The fear of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> prolongs life,</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"PRO.10.27\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Job 15:32, 33  </span></span><span class=\"content\">but the years of the wicked will be short.</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"PRO.10.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"PRO.10.28\"><span class=\"label\">28</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Luke 21:28]   </span></span><span class=\"content\">The hope of the righteous brings joy,</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"PRO.10.28\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Job 8:13  </span></span><span class=\"content\">but the expectation of the wicked will perish.</span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"PRO.10.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"PRO.10.29\"><span class=\"label\">29</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 25:12; Matt. 22:16; Acts 9:2]  </span></span><span class=\"content\">The way of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is a stronghold to the blameless,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"PRO.10.29\"><span class=\"content\">but destruction to evildoers.</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"PRO.10.29\"><span class=\"content\">  </span></span><span class=\"verse v30\" data-usfm=\"PRO.10.30\"><span class=\"label\">30</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 25; Ps. 37:22, 29; 125:1   </span></span><span class=\"content\">The righteous will never be removed,</span></span></div><div class=\"q2\"><span class=\"verse v30\" data-usfm=\"PRO.10.30\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:21, 22</span></span><span class=\"content\">the wicked will not dwell in the land.</span></span></div><div class=\"q1\"><span class=\"verse v30\" data-usfm=\"PRO.10.30\"><span class=\"content\">  </span></span><span class=\"verse v31\" data-usfm=\"PRO.10.31\"><span class=\"label\">31</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 37:30\n        </span></span><span class=\"content\">The mouth of the righteous brings forth wisdom,</span></span></div><div class=\"q2\"><span class=\"verse v31\" data-usfm=\"PRO.10.31\"><span class=\"content\">but the perverse tongue will be cut off.</span></span></div><div class=\"q1\"><span class=\"verse v31\" data-usfm=\"PRO.10.31\"><span class=\"content\">  </span></span><span class=\"verse v32\" data-usfm=\"PRO.10.32\"><span class=\"label\">32</span><span class=\"content\">The lips of the righteous </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Eccles. 10:12] </span></span><span class=\"content\">know what is acceptable,</span></span></div><div class=\"q2\"><span class=\"verse v32\" data-usfm=\"PRO.10.32\"><span class=\"content\">but the mouth of the wicked, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:12</span></span><span class=\"content\">what is perverse.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PRO.11"], "human": "Proverbs 11", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PRO.9"], "human": "Proverbs 9", "toc": true, "version_id": 59}, "reference": {"usfm": ["PRO.10"], "human": "Proverbs 10", "version_id": 59}}, "usfm": "PRO.10.ASW", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Cross