{"pageProps": {"params": {"versionId": "59", "usfm": "REV.19.ASW"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/REV/19-19998fca9adeae4ad835b790ecbbe684.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/REV/19-19998fca9adeae4ad835b790ecbbe684.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}, {"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1668/32k/REV/19-9f359bb096cbd68df732f44d87d3e9a3.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1668/m4a/32k/REV/19-9f359bb096cbd68df732f44d87d3e9a3.m3u8?version_id=59"}, "id": 1668, "version_id": 59, "title": "Living Water Bible - ESV Music Project by Lutheran Bible Translators", "timing_available": false, "dramatized": true, "default": false}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkREV\">\n        <div class=\"chapter ch19\" data-usfm=\"REV.19\">\n            <div class=\"label\">19</div><div class=\"s1\"><span class=\"heading\">Rejoicing in Heaven</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"REV.19.1\"><span class=\"label\">1</span><span class=\"content\">After this I heard </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 11:15 </span></span><span class=\"content\">what seemed to be the loud voice of a great multitude in heaven, crying out,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"REV.19.1\"><span class=\"content\">&#8220;Hallelujah!</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"REV.19.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 4:11; 7:10; 12:10  </span></span><span class=\"content\">Salvation and glory and power belong to our God,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"REV.19.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"REV.19.2\"><span class=\"label\">2</span><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 15:3; 16:7 </span></span><span class=\"content\">his judgments are true and just;</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"REV.19.2\"><span class=\"content\">for he has judged </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 17:1 </span></span><span class=\"content\">the great prostitute</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"REV.19.2\"><span class=\"content\">who corrupted the earth with her immorality,</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"REV.19.2\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 32:43; 2 Kgs. 9:7; [ch. 16:6]; See ch. 6:10</span></span><span class=\"content\">has avenged on her the blood of his servants.&#8221;</span></span></div><div class=\"b\"></div><div class=\"p\"><span class=\"verse v2\" data-usfm=\"REV.19.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"REV.19.3\"><span class=\"label\">3</span><span class=\"content\">Once more they cried out,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"REV.19.3\"><span class=\"content\">&#8220;Hallelujah!</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"REV.19.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 18:9, 18; Isa. 34:10; [ch. 14:11]  </span></span><span class=\"content\">The smoke from her goes up forever and ever.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v3\" data-usfm=\"REV.19.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"REV.19.4\"><span class=\"label\">4</span><span class=\"content\">And </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:4, 6, 10; 5:14</span></span><span class=\"content\">the twenty-four elders and the four living creatures fell down and worshiped God who was seated on the throne, saying, &#8220;Amen. Hallelujah!&#8221; </span></span><span class=\"verse v5\" data-usfm=\"REV.19.5\"><span class=\"label\">5</span><span class=\"content\">And from the throne came a voice saying,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"REV.19.5\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 22:23; 113:1; 134:1; 135:1   </span></span><span class=\"content\">&#8220;Praise our God,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"REV.19.5\"><span class=\"content\">all you his servants,</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"REV.19.5\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 11:18  </span></span><span class=\"content\">you who fear him,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"REV.19.5\"><span class=\"content\">small and great.&#8221;</span></span></div><div class=\"s1\"><span class=\"heading\">The Marriage Supper of the Lamb</span></div><div class=\"m\"><span class=\"verse v5\" data-usfm=\"REV.19.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"REV.19.6\"><span class=\"label\">6</span><span class=\"content\">Then I heard what seemed to be </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Dan. 10:6; [ver. 1] </span></span><span class=\"content\">the voice of a great multitude, like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:15 </span></span><span class=\"content\">the roar of many waters and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 6:1; 14:2 </span></span><span class=\"content\">like the sound of mighty peals of thunder, crying out,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"REV.19.6\"><span class=\"content\">&#8220;Hallelujah!</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"REV.19.6\"><span class=\"content\">For the Lord our God</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"REV.19.6\"><span class=\"content\">the Almighty </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 11:15, 17; Ps. 97:1</span></span><span class=\"content\">reigns.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"REV.19.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"REV.19.7\"><span class=\"label\">7</span><span class=\"content\">Let us rejoice and exult</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"REV.19.7\"><span class=\"content\">and give him the glory,</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"REV.19.7\"><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Matt. 22:2; 25:10; Luke 12:36; 14:8; John 2:1; [Eph. 5:22-32] </span></span><span class=\"content\">the marriage of the Lamb has come,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"REV.19.7\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 21:2, 9; [Isa. 54:5; Hos. 2:19, 20]</span></span><span class=\"content\">his Bride has made herself ready;</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"REV.19.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"REV.19.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 45:13-15; Ezek. 16:10]   </span></span><span class=\"content\">it was granted her to clothe herself</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"REV.19.8\"><span class=\"content\">with fine linen, bright and pure&#8221;&#8212;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v8\" data-usfm=\"REV.19.8\"><span class=\"content\">for the fine linen is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 132:9; Isa. 61:10]</span></span><span class=\"content\">the righteous deeds of the saints.</span></span></div><div class=\"p\"><span class=\"verse v8\" data-usfm=\"REV.19.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"REV.19.9\"><span class=\"label\">9</span><span class=\"content\">And the angel said</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">19:9 </span><span class=\"ft\">Greek </span><span class=\"fq\">he said</span></span></span><span class=\"content\"> to me, &#8220;Write this: </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 14:15; See ver. 7 </span></span><span class=\"content\">Blessed are those who are invited to the marriage supper of the Lamb.&#8221; And he said to me, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 21:5; 22:6]</span></span><span class=\"content\">&#8220;These are the true words of God.&#8221; </span></span><span class=\"verse v10\" data-usfm=\"REV.19.10\"><span class=\"label\">10</span><span class=\"content\">Then </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 22:8 </span></span><span class=\"content\">I fell down at his feet to worship him, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 22:9; See Acts 10:26 </span></span><span class=\"content\">but he said to me, &#8220;You must not do that! I am a fellow servant with you and your brothers who hold to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:2; 6:9; 12:17</span></span><span class=\"content\">the testimony of Jesus. Worship God.&#8221; For the testimony of Jesus is the spirit of prophecy.</span></span></div><div class=\"s1\"><span class=\"heading\">The Rider on a White Horse</span></div><div class=\"p\"><span class=\"verse v10\" data-usfm=\"REV.19.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"REV.19.11\"><span class=\"label\">11</span><span class=\"content\">Then I saw </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ezek. 1:1 </span></span><span class=\"content\">heaven opened, and behold, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 6:2 </span></span><span class=\"content\">a white horse! The one sitting on it is called </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 3:7, 14 </span></span><span class=\"content\">Faithful and True, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 96:13; Isa. 11:4]</span></span><span class=\"content\">in righteousness he judges and makes war. </span></span><span class=\"verse v12\" data-usfm=\"REV.19.12\"><span class=\"label\">12</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:14; 2:18 </span></span><span class=\"content\">His eyes are like a flame of fire, and on his head are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 12:3] </span></span><span class=\"content\">many diadems, and he has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 16; ch. 2:17; [Prov. 30:4]</span></span><span class=\"content\">a name written that no one knows but himself. </span></span><span class=\"verse v13\" data-usfm=\"REV.19.13\"><span class=\"label\">13</span><span class=\"content\">He is clothed in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 63:2, 3 </span></span><span class=\"content\">a robe dipped in</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">19:13 </span><span class=\"ft\">Some manuscripts </span><span class=\"fq\">sprinkled with</span></span></span><span class=\"content\"> blood, and the name by which he is called is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See John 1:1</span></span><span class=\"content\">The Word of God. </span></span><span class=\"verse v14\" data-usfm=\"REV.19.14\"><span class=\"label\">14</span><span class=\"content\">And the armies of heaven, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:4; 7:9 </span></span><span class=\"content\">arrayed in fine linen, white and pure, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 14:20]</span></span><span class=\"content\">were following him on white horses. </span></span><span class=\"verse v15\" data-usfm=\"REV.19.15\"><span class=\"label\">15</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 21; See ch. 1:16 </span></span><span class=\"content\">From his mouth comes a sharp sword </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 11:4; 2 Thess. 2:8] </span></span><span class=\"content\">with which to strike down the nations, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:27; 12:5 </span></span><span class=\"content\">he will rule</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">19:15 </span><span class=\"ft\">Greek </span><span class=\"fq\">shepherd</span></span></span><span class=\"content\"> them with a rod of iron. </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 14:20; Isa. 63:3</span></span><span class=\"content\">He will tread the winepress of the fury of the wrath of God the Almighty. </span></span><span class=\"verse v16\" data-usfm=\"REV.19.16\"><span class=\"label\">16</span><span class=\"content\">On his robe and on his thigh </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 12 </span></span><span class=\"content\">he has a name written, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 17:14</span></span><span class=\"content\">King of kings and Lord of lords.</span></span></div><div class=\"p\"><span class=\"verse v16\" data-usfm=\"REV.19.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"REV.19.17\"><span class=\"label\">17</span><span class=\"content\">Then I saw an angel standing in the sun, and with a loud voice he called to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 21 </span></span><span class=\"content\">all the birds that fly directly overhead, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jer. 12:9; Ezek. 39:17 </span></span><span class=\"content\">&#8220;Come, gather for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 34:6; Jer. 46:10; Ezek. 39:19]</span></span><span class=\"content\">the great supper of God, </span></span><span class=\"verse v18\" data-usfm=\"REV.19.18\"><span class=\"label\">18</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ezek. 39:18, 20</span></span><span class=\"content\">to eat the flesh of kings, the flesh of captains, the flesh of mighty men, the flesh of horses and their riders, and the flesh of all men, both free and slave,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">19:18 </span><span class=\"ft\">For the contextual rendering of the Greek word </span><span class=\"fq\">doulos</span><span class=\"ft\">, see Preface</span></span></span><span class=\"content\"> both small and great.&#8221; </span></span><span class=\"verse v19\" data-usfm=\"REV.19.19\"><span class=\"label\">19</span><span class=\"content\">And I saw </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 11:7; 13:1 </span></span><span class=\"content\">the beast and the kings of the earth with their armies </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 16:16</span></span><span class=\"content\">gathered to make war against him who was sitting on the horse and against his army. </span></span><span class=\"verse v20\" data-usfm=\"REV.19.20\"><span class=\"label\">20</span><span class=\"content\">And the beast was captured, and with it </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 16:13; 20:10 </span></span><span class=\"content\">the false prophet </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 13:11-14 </span></span><span class=\"content\">who in its presence</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">19:20 </span><span class=\"ft\">Or </span><span class=\"fq\">on its behalf</span></span></span><span class=\"content\"> had done the signs by which he deceived those who had received the mark of the beast and those who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 13:15 </span></span><span class=\"content\">worshiped its image. These two were </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 20:10, 14, 15; [Dan. 7:11] </span></span><span class=\"content\">thrown alive into the lake of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 14:10; 21:8; See 2 Thess. 1:8</span></span><span class=\"content\">fire that burns with sulfur. </span></span><span class=\"verse v21\" data-usfm=\"REV.19.21\"><span class=\"label\">21</span><span class=\"content\">And the rest were slain by the sword </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 15 </span></span><span class=\"content\">that came from the mouth of him who was sitting on the horse, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 17</span></span><span class=\"content\">all the birds were gorged with their flesh.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["REV.20"], "human": "Revelation 20", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["REV.18"], "human": "Revelation 18", "toc": true, "version_id": 59}, "reference": {"usfm": ["REV.19"], "human": "Revelat