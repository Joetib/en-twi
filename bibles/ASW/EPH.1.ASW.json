{"pageProps": {"params": {"versionId": "59", "usfm": "EPH.1.ASW"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/EPH/1-15e72ff9b9d5c56c73337d0a7d5e31b4.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/EPH/1-15e72ff9b9d5c56c73337d0a7d5e31b4.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}, {"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1668/32k/EPH/1-ba8e65438c896229fd38fca141dbeecf.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1668/m4a/32k/EPH/1-ba8e65438c896229fd38fca141dbeecf.m3u8?version_id=59"}, "id": 1668, "version_id": 59, "title": "Living Water Bible - ESV Music Project by Lutheran Bible Translators", "timing_available": false, "dramatized": true, "default": false}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkEPH\">\n        <div class=\"chapter ch1\" data-usfm=\"EPH.1\">\n            <div class=\"label\">1</div><div class=\"s1\"><span class=\"heading\">Greeting</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"EPH.1.1\"><span class=\"label\">1</span><span class=\"content\">Paul, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 2 Cor. 1:1 </span></span><span class=\"content\">an apostle of Christ Jesus </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Cor. 1:1 </span></span><span class=\"content\">by the will of God,</span></span></div><div class=\"p\"><span class=\"verse v1\" data-usfm=\"EPH.1.1\"><span class=\"content\">To the saints who are in Ephesus, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 1:2</span></span><span class=\"content\">are faithful</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">1:1 </span><span class=\"ft\">Some manuscripts </span><span class=\"fq\">saints who are also faithful </span><span class=\"ft\">(omitting </span><span class=\"fq\">in Ephesus</span><span class=\"ft\">)</span></span></span><span class=\"content\"> in Christ Jesus:</span></span></div><div class=\"p\"><span class=\"verse v1\" data-usfm=\"EPH.1.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"EPH.1.2\"><span class=\"label\">2</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Rom. 1:7  </span></span><span class=\"content\">Grace to you and peace from God our Father and the Lord Jesus Christ.</span></span></div><div class=\"s1\"><span class=\"heading\">Spiritual Blessings in Christ</span></div><div class=\"p\"><span class=\"verse v2\" data-usfm=\"EPH.1.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"EPH.1.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        2 Cor. 1:3; 1 Pet. 1:3   </span></span><span class=\"content\">Blessed be </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Rom. 15:6 </span></span><span class=\"content\">the God and Father of our Lord Jesus Christ, who has blessed us in Christ with every spiritual blessing </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 20; ch. 2:6; 3:10; 6:12</span></span><span class=\"content\">in the heavenly places, </span></span><span class=\"verse v4\" data-usfm=\"EPH.1.4\"><span class=\"label\">4</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 2:10; 2 Thess. 2:13; 1 Pet. 1:2] </span></span><span class=\"content\">even as he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">James 2:5; [Deut. 7:6; 26:18] </span></span><span class=\"content\">chose us in him </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Tim. 1:9]; See Matt. 13:35 </span></span><span class=\"content\">before the foundation of the world, that we should be </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 5:27; Col. 1:22; 1 Thess. 4:7</span></span><span class=\"content\">holy and blameless before him. In love </span></span><span class=\"verse v5\" data-usfm=\"EPH.1.5\"><span class=\"label\">5</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 11; Rom. 8:29, 30 </span></span><span class=\"content\">he predestined us</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">1:5 </span><span class=\"ft\">Or </span><span class=\"fq\">before him in love, <span class=\"fv\">5</span> having predestined us</span></span></span><span class=\"content\"> for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Rom. 8:15 </span></span><span class=\"content\">adoption to himself as sons through Jesus Christ, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 9; [Luke 2:14; Heb. 2:4]; See Luke 12:32</span></span><span class=\"content\">according to the purpose of his will, </span></span><span class=\"verse v6\" data-usfm=\"EPH.1.6\"><span class=\"label\">6</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 12, 14 </span></span><span class=\"content\">to the praise of his glorious grace, with which he has blessed us in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[John 3:35; 10:17; Col. 1:13]; See Matt. 3:17</span></span><span class=\"content\">the Beloved. </span></span><span class=\"verse v7\" data-usfm=\"EPH.1.7\"><span class=\"label\">7</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 1:14 </span></span><span class=\"content\">In him we have </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Rom. 3:24; 1 Cor. 1:30; [ch. 4:30] </span></span><span class=\"content\">redemption </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Acts 20:28 </span></span><span class=\"content\">through his blood, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Acts 2:38 </span></span><span class=\"content\">the forgiveness of our trespasses, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 3:8, 16; Col. 1:27]; See Rom. 2:4</span></span><span class=\"content\">according to the riches of his grace, </span></span><span class=\"verse v8\" data-usfm=\"EPH.1.8\"><span class=\"label\">8</span><span class=\"content\">which he lavished upon us, in all wisdom and insight </span></span><span class=\"verse v9\" data-usfm=\"EPH.1.9\"><span class=\"label\">9</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Rom. 16:25 </span></span><span class=\"content\">making known</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">1:9 </span><span class=\"ft\">Or </span><span class=\"fq\">he lavished upon us in all wisdom and insight, making known&#160;.&#160;.&#160;.</span></span></span><span class=\"content\"> to us the mystery of his will, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 5 above] </span></span><span class=\"content\">according to his purpose, which he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 11; Rom. 8:28; 9:11]</span></span><span class=\"content\">set forth in Christ </span></span><span class=\"verse v10\" data-usfm=\"EPH.1.10\"><span class=\"label\">10</span><span class=\"content\">as a plan for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Mark 1:15 </span></span><span class=\"content\">the fullness of time, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 1:16, 20; [ch. 3:15; Phil. 2:9, 10]</span></span><span class=\"content\">to unite all things in him, things in heaven and things on earth.</span></span></div><div class=\"p\"><span class=\"verse v10\" data-usfm=\"EPH.1.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"EPH.1.11\"><span class=\"label\">11</span><span class=\"content\">In him we have obtained </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 4:20; 32:9; See ver. 14 </span></span><span class=\"content\">an inheritance, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 5 </span></span><span class=\"content\">having been predestined </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:11; [Rev. 4:11]; See Rom. 8:28 </span></span><span class=\"content\">according to the purpose of him who works all things according to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Acts 20:27]</span></span><span class=\"content\">the counsel of his will, </span></span><span class=\"verse v12\" data-usfm=\"EPH.1.12\"><span class=\"label\">12</span><span class=\"content\">so that we who were the first to hope in Christ might be </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 6, 14; [Phil. 1:11]</span></span><span class=\"content\">to the praise of his glory. </span></span><span class=\"verse v13\" data-usfm=\"EPH.1.13\"><span class=\"label\">13</span><span class=\"content\">In him you also, when you heard </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Cor. 6:7; Col. 1:5; 2 Tim. 2:15; [Acts 13:26; 15:7] </span></span><span class=\"content\">the word of truth, the gospel of your salvation, and believed in him, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:30 </span></span><span class=\"content\">were sealed with the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Acts 1:4</span></span><span class=\"content\">promised Holy Spirit, </span></span><span class=\"verse v14\" data-usfm=\"EPH.1.14\"><span class=\"label\">14</span><span class=\"content\">who is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Cor. 1:22 </span></span><span class=\"content\">the guarantee</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">1:14 </span><span class=\"ft\">Or </span><span class=\"fq\">down payment</span></span></span><span class=\"content\"> of our </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Acts 20:32; [ver. 18] </span></span><span class=\"content\">inheritance until </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Titus 2:14; See ver. 7 </span></span><span class=\"content\">we acquire </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Pet. 2:9 </span></span><span class=\"content\">possession of it,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">1:14 </span><span class=\"ft\">Or </span><span class=\"fq\">until God redeems his possession</span></span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 6, 12</span></span><span class=\"content\">to the praise of his glory.</span></span></div><div class=\"s1\"><span class=\"heading\">Thanksgiving and Prayer</span></div><div class=\"p\"><span class=\"verse v14\" data-usfm=\"EPH.1.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"EPH.1.15\"><span class=\"label\">15</span><span class=\"content\">For this reason, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 1:4; Philem. 5; See Rom. 1:8</span></span><span class=\"content\">because I have heard of your faith in the Lord Jesus and your love</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">1:15 </span><span class=\"ft\">Some manuscripts omit </span><span class=\"fq\">your love</span></span></span><span class=\"content\"> toward all the saints, </span></span><span class=\"verse v16\" data-usfm=\"EPH.1.16\"><span class=\"label\">16</span><span class=\"content\">I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 1:9 </span></span><span class=\"content\">do not cease to give thanks for you, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Rom. 1:9; 2 Tim. 1:3</span></span><span class=\"content\">remembering you in my prayers, </span></span><span class=\"verse v17\" data-usfm=\"EPH.1.17\"><span class=\"label\">17</span><span class=\"content\">that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Rom. 15:6 </span></span><span class=\"content\">the God of our Lord Jesus Christ, the Father of glory, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Col. 1:9]</span></span><span class=\"content\">may give you the Spirit of wisdom and of revelation in the knowledge of him, </span></span><span class=\"verse v18\" data-usfm=\"EPH.1.18\"><span class=\"label\">18</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Heb. 6:4; 10:32; Rev. 3:17, 18]; See Acts 26:18 </span></span><span class=\"content\">having the eyes of your hearts enlightened, that you may know what is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:4; [ch. 2:12] </span></span><span class=\"content\">the hope to which he has called you, what are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:8, 16; Col. 1:27; See ver. 7</span></span><span class=\"content\">the riches of his glorious inheritance in the saints, </span></span><span class=\"verse v19\" data-usfm=\"EPH.1.19\"><span class=\"label\">19</span><span class=\"content\">and what is the immeasurable greatness of his power toward us who believe, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:7; Phil. 3:21; Col. 1:29; 2:12 </span></span><span class=\"content\">according to the working of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 6:10; [Dan. 4:30]</span></span><span class=\"content\">his great might </span></span><span class=\"verse v20\" data-usfm=\"EPH.1.20\"><span class=\"label\">20</span><span class=\"content\">that he worked in Christ </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Acts 2:24 </span></span><span class=\"content\">when he raised him from the dead and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Mark 16:19; Acts 2:33; 1 Pet. 3:22 </span></span><span class=\"content\">seated him at his right hand </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ver. 3</span></span><span class=\"content\">in the heavenly places, </span></span><span class=\"verse v21\" data-usfm=\"EPH.1.21\"><span class=\"label\">21</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:10; Col. 2:10; See John 3:31 </span></span><span class=\"content\">far above </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Cor. 15:24 </span></span><span class=\"content\">all rule and authority and power and dominion, and above </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:15; Phil. 2:9; [Heb. 1:4] </span></span><span class=\"content\">every name that is named, not only in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Matt. 12:32]</span></span><span class=\"content\">this age but also in the one to come. </span></span><span class=\"verse v22\" data-usfm=\"EPH.1.22\"><span class=\"label\">22</span><span class=\"content\">And </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Cited from Ps. 8:6; See 1 Cor. 15:27 </span></span><span class=\"content\">he put all things under his feet and gave him as </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:15; 5:23; Col. 1:18; 2:19; [1 Cor. 11:3; Col. 2:10]</span></span><span class=\"content\">head over all things to the church, </span></span><span class=\"verse v23\" data-usfm=\"EPH.1.23\"><span class=\"label\">23</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:12, 16; 5:30; Col. 1:18, 24; [ch. 5:23; 1 Cor. 12:27] </span></span><span class=\"content\">which is his body, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:19; See John 1:16 </span></span><span class=\"content\">the fullness of him </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:10 </span></span><span class=\"content\">who fills </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Jer. 23:24; Col. 3:11]</span></span><span class=\"content\">all in all.</span></span></div>\n        </div>\n    </di