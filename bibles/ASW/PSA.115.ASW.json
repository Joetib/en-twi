{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.115.ASW"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/115-a9561315fb4be3bf42a1e12e728b10d7.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/115-a9561315fb4be3bf42a1e12e728b10d7.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch115\" data-usfm=\"PSA.115\">\n            <div class=\"label\">115</div><div class=\"s1\"><span class=\"heading\">To Your Name Give Glory</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.115.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 48:11; Ezek. 36:22; Dan. 9:18, 19]   </span></span><span class=\"content\">Not to us, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, not to us, but to your name give glory,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.115.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 36:5  </span></span><span class=\"content\">for the sake of your steadfast love and your faithfulness!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.115.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.115.2\"><span class=\"label\">2</span><span class=\"content\">Why should the nations say,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.115.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ex. 32:12; Num. 14:13, 14]; See Ps. 42:3  </span></span><span class=\"content\">&#8220;Where is their God?&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.115.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.115.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 11:4   </span></span><span class=\"content\">Our God is in the heavens;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.115.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 135:6; Dan. 4:35  </span></span><span class=\"content\">he does all that he pleases.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.115.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.115.4\"><span class=\"label\">4</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    For ver. 4-8, see Ps. 135:15-18   </span></span><span class=\"content\">Their idols are silver and gold,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.115.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Deut. 4:28; 2 Kgs. 19:18; Isa. 37:19; Acts 19:26; See Isa. 44:10-20; Jer. 10:3-5  </span></span><span class=\"content\">the work of human hands.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.115.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.115.5\"><span class=\"label\">5</span><span class=\"content\">They have mouths, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 46:7; Hab. 2:18]</span></span><span class=\"content\">but do not speak;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.115.5\"><span class=\"content\">eyes, but do not see.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.115.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.115.6\"><span class=\"label\">6</span><span class=\"content\">They have ears, but do not hear;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.115.6\"><span class=\"content\">noses, but do not smell.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.115.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.115.7\"><span class=\"label\">7</span><span class=\"content\">They have hands, but do not feel;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.115.7\"><span class=\"content\">feet, but do not walk;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.115.7\"><span class=\"content\">and they do not make a sound in their throat.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.115.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.115.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 44:9]  </span></span><span class=\"content\">Those who make them become like them;</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.115.8\"><span class=\"content\">so do all who trust in them.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PSA.115.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PSA.115.9\"><span class=\"label\">9</span><span class=\"content\">O </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 118:2-4; 135:19, 20] </span></span><span class=\"content\">Israel,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">115:9 </span><span class=\"ft\">Masoretic Text; many Hebrew manuscripts, Septuagint, Syriac </span><span class=\"fq\">O house of Israel</span></span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 37:3; 62:8 </span></span><span class=\"content\">trust in the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PSA.115.9\"><span class=\"content\">He is their </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 33:20</span></span><span class=\"content\">help and their shield.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.115.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PSA.115.10\"><span class=\"label\">10</span><span class=\"content\">O </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 9 above] </span></span><span class=\"content\">house of Aaron, trust in the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PSA.115.10\"><span class=\"content\">He is their help and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 3:3</span></span><span class=\"content\">their shield.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PSA.115.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PSA.115.11\"><span class=\"label\">11</span><span class=\"content\">You </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 22:23; 103:11, 13, 17</span></span><span class=\"content\">who fear the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, trust in the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.115.11\"><span class=\"content\">He is their help and their shield.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.115.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PSA.115.12\"><span class=\"label\">12</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> has remembered us; he will bless us;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.115.12\"><span class=\"content\">he will bless </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 118:2-4; 135:19, 20]</span></span><span class=\"content\">the house of Israel;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.115.12\"><span class=\"content\">he will bless </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 118:2-4; 135:19, 20]</span></span><span class=\"content\">the house of Aaron;</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.115.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PSA.115.13\"><span class=\"label\">13</span><span class=\"content\">he will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 112:1 </span></span><span class=\"content\">bless those who fear the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.115.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Jer. 16:6; 31:34  </span></span><span class=\"content\">both the small and the great.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PSA.115.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PSA.115.14\"><span class=\"label\">14</span><span class=\"content\">May the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 1:11</span></span><span class=\"content\">give you increase,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.115.14\"><span class=\"content\">you and your children!</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.115.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PSA.115.15\"><span class=\"label\">15</span><span class=\"content\">May </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ruth 2:20 </span></span><span class=\"content\">you be blessed by the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PSA.115.15\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 121:2; 124:8; 134:3; 146:6; Acts 14:15; Rev. 14:7; [Gen. 1:1; 14:19; Jer. 10:11]  </span></span><span class=\"content\">who made heaven and earth!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PSA.115.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PSA.115.16\"><span class=\"label\">16</span><span class=\"content\">The heavens are the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">&#8217;s heavens,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PSA.115.16\"><span class=\"content\">but the earth he has given to the children of man.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PSA.115.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PSA.115.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 6:5   </span></span><span class=\"content\">The dead do not praise the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PSA.115.17\"><span class=\"content\">nor do any who go down into </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 31:17</span></span><span class=\"content\">silence.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PSA.115.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PSA.115.18\"><span class=\"label\">18</span><span class=\"content\">But </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 113:2 </span></span><span class=\"content\">we will bless the </span><span class=\"nd\"><span class=\"content\">Lord</span></span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PSA.115.18\"><span class=\"content\">from this time forth and forevermore.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"PSA.115.18\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 104:35  </span></span><span class=\"content\">Praise the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PSA.116"], "human": "Psalm 116", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PSA.114"], "human": "Psalm 114", "toc": true, "version_id": 59}, "reference": {"usfm": ["PSA.115"], "human": "Psalm 115", "version_id": 59}}, "usfm": "PSA.115.ASW", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p> \r\n<p>Sign up to rec