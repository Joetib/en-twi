{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.122.ASW"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/122-b3c69a3bf46695c0cd2d678a5d7eca93.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/122-b3c69a3bf46695c0cd2d678a5d7eca93.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch122\" data-usfm=\"PSA.122\">\n            <div class=\"label\">122</div><div class=\"s1\"><span class=\"heading\">Let Us Go to the House of the </span><span class=\"nd\"><span class=\"heading\">Lord</span></span></div><div class=\"d\"><span class=\"content\">A Song of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See Ps. 120, title]</span></span><span class=\"content\">Ascents. Of David.</span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.122.1\"><span class=\"label\">1</span><span class=\"content\">I was glad when they said to me,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.122.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 2:3; Mic. 4:2; Zech. 8:21  </span></span><span class=\"content\">&#8220;Let us go to the house of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.122.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.122.2\"><span class=\"label\">2</span><span class=\"content\">Our feet have been standing</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.122.2\"><span class=\"content\">within your gates, O Jerusalem!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.122.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.122.3\"><span class=\"label\">3</span><span class=\"content\">Jerusalem&#8212;</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 147:2 </span></span><span class=\"content\">built as a city</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.122.3\"><span class=\"content\">that is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Neh. 4:6</span></span><span class=\"content\">bound firmly together,</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.122.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.122.4\"><span class=\"label\">4</span><span class=\"content\">to which the tribes </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 16:16 </span></span><span class=\"content\">go up,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.122.4\"><span class=\"content\">the tribes of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.122.4\"><span class=\"content\">as was </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 78:5</span></span><span class=\"content\">decreed for</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">122:4 </span><span class=\"ft\">Or </span><span class=\"fq\">as a testimony for</span></span></span><span class=\"content\"> Israel,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.122.4\"><span class=\"content\">to give thanks to the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.122.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.122.5\"><span class=\"label\">5</span><span class=\"content\">There </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 17:8; 2 Sam. 15:2; 1 Kgs. 3:16; 7:7; 2 Chr. 19:8</span></span><span class=\"content\">thrones for judgment were set,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.122.5\"><span class=\"content\">the thrones of the house of David.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.122.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.122.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 51:18; Jer. 29:7]  </span></span><span class=\"content\">Pray for the peace of Jerusalem!</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.122.6\"><span class=\"content\">&#8220;May they be secure who love you!</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.122.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.122.7\"><span class=\"label\">7</span><span class=\"content\">Peace be within your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 48:13</span></span><span class=\"content\">walls</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.122.7\"><span class=\"content\">and security within your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 48:13</span></span><span class=\"content\">towers!&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.122.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.122.8\"><span class=\"label\">8</span><span class=\"content\">For my brothers and companions&#8217; sake</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.122.8\"><span class=\"content\">I will say, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Sam. 25:6; Ps. 85:8]</span></span><span class=\"content\">&#8220;Peace be within you!&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PSA.122.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PSA.122.9\"><span class=\"label\">9</span><span class=\"content\">For the sake of the house of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> our God,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PSA.122.9\"><span class=\"content\">I will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Neh. 2:10; Esth. 10:3</span></span><span class=\"content\">seek your good.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by C