{"pageProps": {"params": {"versionId": "59", "usfm": "JOB.27.ASW"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/JOB/27-ea9f8a364d7b57f43fe35dd2aa1b290a.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/JOB/27-ea9f8a364d7b57f43fe35dd2aa1b290a.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkJOB\">\n        <div class=\"chapter ch27\" data-usfm=\"JOB.27\">\n            <div class=\"label\">27</div><div class=\"s1\"><span class=\"heading\">Job Continues: I Will Maintain My Integrity</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"JOB.27.1\"><span class=\"label\">1</span><span class=\"content\">And Job again </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 29:1; See Num. 23:7</span></span><span class=\"content\">took up his discourse, and said:</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"JOB.27.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"JOB.27.2\"><span class=\"label\">2</span><span class=\"content\">&#8220;As God lives, who has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 34:5 </span></span><span class=\"content\">taken away my right,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"JOB.27.2\"><span class=\"content\">and the Almighty, who has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ruth 1:20; 2 Kgs. 4:27]</span></span><span class=\"content\">made my soul bitter,</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"JOB.27.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"JOB.27.3\"><span class=\"label\">3</span><span class=\"content\">as long as my breath is in me,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"JOB.27.3\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 33:4; [Gen. 2:7]</span></span><span class=\"content\">the spirit of God is in my nostrils,</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"JOB.27.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"JOB.27.4\"><span class=\"label\">4</span><span class=\"content\">my lips will not speak </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 13:7</span></span><span class=\"content\">falsehood,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"JOB.27.4\"><span class=\"content\">and my tongue will not utter </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 13:7</span></span><span class=\"content\">deceit.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"JOB.27.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"JOB.27.5\"><span class=\"label\">5</span><span class=\"content\">Far be it from me to say that you are right;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"JOB.27.5\"><span class=\"content\">till I die I will not put away my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:3, 9; [ch. 13:15]</span></span><span class=\"content\">integrity from me.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"JOB.27.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"JOB.27.6\"><span class=\"label\">6</span><span class=\"content\">I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:3 </span></span><span class=\"content\">hold fast my righteousness and will not let it go;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"JOB.27.6\"><span class=\"content\">my heart does not </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Acts 23:1; 24:16; 1 Cor. 4:4]</span></span><span class=\"content\">reproach me for any of my days.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"JOB.27.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"JOB.27.7\"><span class=\"label\">7</span><span class=\"content\">&#8220;Let my enemy be as the wicked,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"JOB.27.7\"><span class=\"content\">and let him who rises up against me be as the unrighteous.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"JOB.27.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"JOB.27.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 8:13   </span></span><span class=\"content\">For what is the hope of the godless </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Matt. 16:26; [Luke 12:20]</span></span><span class=\"content\">when God cuts him off,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"JOB.27.8\"><span class=\"content\">when God takes away his life?</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"JOB.27.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"JOB.27.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 18:41; Prov. 1:28; 15:29; Isa. 1:15; Jer. 11:11; 14:12; Ezek. 8:18; Mic. 3:4; Zech. 7:13; [ch. 35:12, 13]; See Ps. 66:18  </span></span><span class=\"content\">Will God hear his cry</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"JOB.27.9\"><span class=\"content\">when distress comes upon him?</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"JOB.27.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"JOB.27.10\"><span class=\"label\">10</span><span class=\"content\">Will he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 22:26</span></span><span class=\"content\">take delight in the Almighty?</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"JOB.27.10\"><span class=\"content\">Will he call upon God at all times?</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"JOB.27.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"JOB.27.11\"><span class=\"label\">11</span><span class=\"content\">I will teach you concerning the hand of God;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"JOB.27.11\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 10:13; 23:14  </span></span><span class=\"content\">what is with the Almighty I will not conceal.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"JOB.27.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"JOB.27.12\"><span class=\"label\">12</span><span class=\"content\">Behold, all of you have seen it yourselves;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"JOB.27.12\"><span class=\"content\">why then have you become altogether vain?</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"JOB.27.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"JOB.27.13\"><span class=\"label\">13</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 20:29; [ch. 18:21; 31:2]   </span></span><span class=\"content\">&#8220;This is the portion of a wicked man with God,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"JOB.27.13\"><span class=\"content\">and the heritage that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 6:23; 15:20</span></span><span class=\"content\">oppressors receive from the Almighty:</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"JOB.27.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"JOB.27.14\"><span class=\"label\">14</span><span class=\"content\">If his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 28:41; Hos. 9:13, 16 </span></span><span class=\"content\">children are multiplied, it is for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jer. 15:2</span></span><span class=\"content\">the sword,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"JOB.27.14\"><span class=\"content\">and his descendants have not enough bread.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"JOB.27.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"JOB.27.15\"><span class=\"label\">15</span><span class=\"content\">Those who survive him the pestilence buries,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"JOB.27.15\"><span class=\"content\">and his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 78:64</span></span><span class=\"content\">widows do not weep.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"JOB.27.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"JOB.27.16\"><span class=\"label\">16</span><span class=\"content\">Though he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Zech. 9:3</span></span><span class=\"content\">heap up silver like dust,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"JOB.27.16\"><span class=\"content\">and pile up clothing like clay,</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"JOB.27.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"JOB.27.17\"><span class=\"label\">17</span><span class=\"content\">he may pile it up, but the righteous will wear it,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"JOB.27.17\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Prov. 13:22; Eccles. 2:26]</span></span><span class=\"content\">the innocent will divide the silver.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"JOB.27.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"JOB.27.18\"><span class=\"label\">18</span><span class=\"content\">He builds his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 8:14, 15 </span></span><span class=\"content\">house like a moth&#8217;s,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"JOB.27.18\"><span class=\"content\">like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 1:8 </span></span><span class=\"content\">a booth that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Song 1:6; 8:11, 12</span></span><span class=\"content\">a watchman makes.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"JOB.27.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"JOB.27.19\"><span class=\"label\">19</span><span class=\"content\">He goes to bed rich, but will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jer. 8:2; Ezek. 29:5 </span></span><span class=\"content\">do so no more;</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"JOB.27.19\"><span class=\"content\">he opens his eyes, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 24:24</span></span><span class=\"content\">his wealth is gone.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"JOB.27.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"JOB.27.20\"><span class=\"label\">20</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 18:11   </span></span><span class=\"content\">Terrors overtake him like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 22:11 </span></span><span class=\"content\">a flood;</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"JOB.27.20\"><span class=\"content\">in the night a whirlwind </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 34:20, 25; 36:20</span></span><span class=\"content\">carries him off.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"JOB.27.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"JOB.27.21\"><span class=\"label\">21</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 30:22]   </span></span><span class=\"content\">The east wind lifts him up and he is gone;</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"JOB.27.21\"><span class=\"content\">it </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 8:18</span></span><span class=\"content\">sweeps him out of his place.</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"JOB.27.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"JOB.27.22\"><span class=\"label\">22</span><span class=\"content\">It</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">27:22 </span><span class=\"ft\">Or </span><span class=\"fq\">He </span><span class=\"ft\">(that is, God); also verse 23</span></span></span><span class=\"content\"> hurls at him </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 16:13</span></span><span class=\"content\">without pity;</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"JOB.27.22\"><span class=\"content\">he flees from its</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">27:22 </span><span class=\"ft\">Or </span><span class=\"fq\">his</span><span class=\"ft\">; also verse 23</span></span></span><span class=\"content\"> power in headlong flight.</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"JOB.27.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"JOB.27.23\"><span class=\"label\">23</span><span class=\"content\">It </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Lam. 2:15; Ezek. 25:6; Nah. 3:19 </span></span><span class=\"content\">claps its hands at him</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"JOB.27.23\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Chr. 29:8; Jer. 49:17; Lam. 2:15; Ezek. 27:36; Zeph. 2:15]</span></span><span class=\"content\">hisses at him from its place.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["JOB.28"], "human": "Job 28", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["JOB.26"], "human": "Job 26", "toc": true, "version_id": 59}, "reference": {"usfm": ["JOB.27"], "human": "Job 27", "version_id": 59}}, "usfm": "JOB.27.ASW", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p> \r\n<p>Sign up to receive news and updates about the ESV:</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers. \r\nSign up to receive n