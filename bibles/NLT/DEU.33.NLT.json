{"pageProps": {"params": {"versionId": "59", "usfm": "DEU.33.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/DEU/33-97a8c479fbeabfa39bb2a75b240e3b1a.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/DEU/33-97a8c479fbeabfa39bb2a75b240e3b1a.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkDEU\">\n        <div class=\"chapter ch33\" data-usfm=\"DEU.33\">\n            <div class=\"label\">33</div><div class=\"s1\"><span class=\"heading\">Moses&#8217; Final Blessing on Israel</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"DEU.33.1\"><span class=\"label\">1</span><span class=\"content\">This is the blessing with which Moses </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Josh. 14:6; 1 Chr. 23:14; 2 Chr. 30:16; Ezra 3:2</span></span><span class=\"content\">the man of God blessed the people of Israel before his death. </span></span><span class=\"verse v2\" data-usfm=\"DEU.33.2\"><span class=\"label\">2</span><span class=\"content\">He said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"DEU.33.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ex. 19:18, 20; Judg. 5:4, 5; Ps. 68:7, 8; Hab. 3:3]   </span></span><span class=\"content\">&#8220;The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> came from Sinai</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"DEU.33.2\"><span class=\"content\">and dawned from Seir upon us;</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:2 </span><span class=\"ft\">Septuagint, Syriac, Vulgate; Hebrew </span><span class=\"fq\">them</span></span></span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"DEU.33.2\"><span class=\"content\">he shone forth from Mount Paran;</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"DEU.33.2\"><span class=\"content\">he came </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 68:17; Dan. 7:10; Acts 7:53; Gal. 3:19; Heb. 2:2; Jude 14; Rev. 5:11]</span></span><span class=\"content\">from the ten thousands of holy ones,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"DEU.33.2\"><span class=\"content\">with flaming fire</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:2 </span><span class=\"ft\">The meaning of the Hebrew word is uncertain</span></span></span><span class=\"content\"> at his right hand.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"DEU.33.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"DEU.33.3\"><span class=\"label\">3</span><span class=\"content\">Yes, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 7:7, 8; 10:15; Hos. 11:1 </span></span><span class=\"content\">he loved his people,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:3 </span><span class=\"ft\">Septuagint; Hebrew </span><span class=\"fq\">peoples</span></span></span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"DEU.33.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [John 10:27-29; Rom. 8:35, 38, 39]   </span></span><span class=\"content\">all his holy ones were in his</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:3 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">your</span></span></span><span class=\"content\"> hand;</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"DEU.33.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Luke 10:39; Acts 22:3]  </span></span><span class=\"content\">so they followed</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:3 </span><span class=\"ft\">The meaning of the Hebrew word is uncertain</span></span></span><span class=\"content\"> in your steps,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"DEU.33.3\"><span class=\"content\">receiving direction from you,</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"DEU.33.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"DEU.33.4\"><span class=\"label\">4</span><span class=\"content\">when </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">John 1:17; 7:19</span></span><span class=\"content\">Moses commanded us a law,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"DEU.33.4\"><span class=\"content\">as a possession for the assembly of Jacob.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"DEU.33.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"DEU.33.5\"><span class=\"label\">5</span><span class=\"content\">Thus the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:5 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">Thus he</span></span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Num. 23:21; [Judg. 8:23; Isa. 33:22] </span></span><span class=\"content\">became king in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 32:15</span></span><span class=\"content\">Jeshurun,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"DEU.33.5\"><span class=\"content\">when the heads of the people were gathered,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"DEU.33.5\"><span class=\"content\">all the tribes of Israel together.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"DEU.33.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"DEU.33.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Gen. 49:3, 4]  </span></span><span class=\"content\">&#8220;Let Reuben live, and not die,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"DEU.33.6\"><span class=\"content\">but let his men be few.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v6\" data-usfm=\"DEU.33.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"DEU.33.7\"><span class=\"label\">7</span><span class=\"content\">And this he said of Judah:</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"DEU.33.7\"><span class=\"content\">&#8220;Hear, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, the voice of Judah,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"DEU.33.7\"><span class=\"content\">and bring him in to his people.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"DEU.33.7\"><span class=\"content\">With your hands contend</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:7 </span><span class=\"ft\">Probable reading; Hebrew </span><span class=\"fq\">With his hands he contended</span></span></span><span class=\"content\"> for him,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"DEU.33.7\"><span class=\"content\">and be a help against his adversaries.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v7\" data-usfm=\"DEU.33.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"DEU.33.8\"><span class=\"label\">8</span><span class=\"content\">And </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 49:5] </span></span><span class=\"content\">of Levi he said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"DEU.33.8\"><span class=\"content\">&#8220;Give to Levi</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:8 </span><span class=\"ft\">Dead Sea Scroll, Septuagint; Masoretic Text lacks </span><span class=\"fq\">Give to Levi</span></span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ex. 28:30 </span></span><span class=\"content\">your Thummim,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"DEU.33.8\"><span class=\"content\">and your Urim to your godly one,</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"DEU.33.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ex. 17:7; Num. 20:13  </span></span><span class=\"content\">whom you tested at Massah,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"DEU.33.8\"><span class=\"content\">with whom you quarreled at the waters of Meribah;</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"DEU.33.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"DEU.33.9\"><span class=\"label\">9</span><span class=\"content\">who said of his father and mother,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"DEU.33.9\"><span class=\"content\">&#8216;I regard them not&#8217;;</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"DEU.33.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ex. 32:26-29   </span></span><span class=\"content\">he disowned his brothers</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"DEU.33.9\"><span class=\"content\">and ignored his children.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"DEU.33.9\"><span class=\"content\">For </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Mal. 2:4-6</span></span><span class=\"content\">they observed your word</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"DEU.33.9\"><span class=\"content\">and kept your covenant.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"DEU.33.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"DEU.33.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 17:9-11; Ezek. 44:23; See Lev. 10:11   </span></span><span class=\"content\">They shall teach Jacob your rules</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"DEU.33.10\"><span class=\"content\">and Israel your law;</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"DEU.33.10\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ex. 30:7, 8; 1 Sam. 2:28   </span></span><span class=\"content\">they shall put incense before you</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"DEU.33.10\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 51:19; Ezek. 43:27</span></span><span class=\"content\">whole burnt offerings on your altar.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"DEU.33.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"DEU.33.11\"><span class=\"label\">11</span><span class=\"content\">Bless, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, his substance,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"DEU.33.11\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ezek. 20:40, 41; 43:27; [Amos 5:22]</span></span><span class=\"content\">accept the work of his hands;</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"DEU.33.11\"><span class=\"content\">crush the loins of his adversaries,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"DEU.33.11\"><span class=\"content\">of those who hate him, that they rise not again.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v11\" data-usfm=\"DEU.33.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"DEU.33.12\"><span class=\"label\">12</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Gen. 49:27]  </span></span><span class=\"content\">Of Benjamin he said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"DEU.33.12\"><span class=\"content\">&#8220;The beloved of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> dwells in safety.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"DEU.33.12\"><span class=\"content\">The High God</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:12 </span><span class=\"ft\">Septuagint; Hebrew </span><span class=\"fq\">dwells in safety by him. He</span></span></span><span class=\"content\"> surrounds him all day long,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"DEU.33.12\"><span class=\"content\">and dwells between his shoulders.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v12\" data-usfm=\"DEU.33.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"DEU.33.13\"><span class=\"label\">13</span><span class=\"content\">And </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 49:22] </span></span><span class=\"content\">of Joseph he said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"DEU.33.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Gen. 49:25   </span></span><span class=\"content\">&#8220;Blessed by the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> be his land,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"DEU.33.13\"><span class=\"content\">with the choicest gifts of heaven </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 28; Gen. 27:28</span></span><span class=\"content\">above,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:13 </span><span class=\"ft\">Two Hebrew manuscripts and Targum; Hebrew </span><span class=\"fq\">with the dew</span></span></span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"DEU.33.13\"><span class=\"content\">and of the deep that crouches beneath,</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"DEU.33.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"DEU.33.14\"><span class=\"label\">14</span><span class=\"content\">with the choicest fruits of the sun</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"DEU.33.14\"><span class=\"content\">and the rich yield of the months,</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"DEU.33.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"DEU.33.15\"><span class=\"label\">15</span><span class=\"content\">with the finest produce of the ancient mountains</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"DEU.33.15\"><span class=\"content\">and the abundance of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 49:26; Hab. 3:6; [Ps. 90:2]</span></span><span class=\"content\">the everlasting hills,</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"DEU.33.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"DEU.33.16\"><span class=\"label\">16</span><span class=\"content\">with the best gifts of the earth and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 24:1 </span></span><span class=\"content\">its fullness</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"DEU.33.16\"><span class=\"content\">and the favor of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 3:2-4; Acts 7:30, 35</span></span><span class=\"content\">him who dwells in the bush.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"DEU.33.16\"><span class=\"content\">May these rest on the head of Joseph,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"DEU.33.16\"><span class=\"content\">on the pate of him who is prince among his brothers.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"DEU.33.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"DEU.33.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [1 Chr. 5:1]   </span></span><span class=\"content\">A firstborn bull</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:17 </span><span class=\"ft\">Dead Sea Scroll, Septuagint, Samaritan; Masoretic Text </span><span class=\"fq\">His firstborn bull</span></span></span><span class=\"content\">&#8212;he has majesty,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"DEU.33.17\"><span class=\"content\">and his horns are the horns of a </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Num. 23:22 </span></span><span class=\"content\">wild ox;</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"DEU.33.17\"><span class=\"content\">with them </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Kgs. 22:11; Ps. 44:5; Dan. 8:4 </span></span><span class=\"content\">he shall gore the peoples,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"DEU.33.17\"><span class=\"content\">all of them, to the ends of the earth;</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"DEU.33.17\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Gen. 48:19; Num. 1:33, 35]  </span></span><span class=\"content\">they are the ten thousands of Ephraim,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"DEU.33.17\"><span class=\"content\">and they are the thousands of Manasseh.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v17\" data-usfm=\"DEU.33.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"DEU.33.18\"><span class=\"label\">18</span><span class=\"content\">And of Zebulun he said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"DEU.33.18\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Gen. 49:13-15]  </span></span><span class=\"content\">&#8220;Rejoice, Zebulun, in your going out,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"DEU.33.18\"><span class=\"content\">and Issachar, in your tents.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"DEU.33.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"DEU.33.19\"><span class=\"label\">19</span><span class=\"content\">They shall call peoples </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 15:17; Isa. 2:3 </span></span><span class=\"content\">to their mountain;</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"DEU.33.19\"><span class=\"content\">there they offer </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 4:5; 51:19</span></span><span class=\"content\">right sacrifices;</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"DEU.33.19\"><span class=\"content\">for they draw from the abundance of the seas</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"DEU.33.19\"><span class=\"content\">and the hidden treasures of the sand.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v19\" data-usfm=\"DEU.33.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"DEU.33.20\"><span class=\"label\">20</span><span class=\"content\">And </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 49:19] </span></span><span class=\"content\">of Gad he said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"DEU.33.20\"><span class=\"content\">&#8220;Blessed be he who enlarges Gad!</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"DEU.33.20\"><span class=\"content\">Gad crouches </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Chr. 12:8]</span></span><span class=\"content\">like a lion;</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"DEU.33.20\"><span class=\"content\">he tears off arm and scalp.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"DEU.33.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"DEU.33.21\"><span class=\"label\">21</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Num. 32:1-5, 16-19   </span></span><span class=\"content\">He chose the best of the land for himself,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"DEU.33.21\"><span class=\"content\">for there a commander&#8217;s portion was reserved;</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"DEU.33.21\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Num. 32:31, 32; See Josh. 1:12-15; 1 Chr. 5:18-22</span></span><span class=\"content\">he came with the heads of the people,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"DEU.33.21\"><span class=\"content\">with Israel he executed the justice of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"DEU.33.21\"><span class=\"content\">and his judgments for Israel.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v21\" data-usfm=\"DEU.33.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"DEU.33.22\"><span class=\"label\">22</span><span class=\"content\">And </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 49:16] </span></span><span class=\"content\">of Dan he said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"DEU.33.22\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Gen. 49:9]   </span></span><span class=\"content\">&#8220;Dan is a lion&#8217;s cub</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"DEU.33.22\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Josh. 19:47; Judg. 18:27]  </span></span><span class=\"content\">that leaps from Bashan.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v22\" data-usfm=\"DEU.33.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"DEU.33.23\"><span class=\"label\">23</span><span class=\"content\">And </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 49:21] </span></span><span class=\"content\">of Naphtali he said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"DEU.33.23\"><span class=\"content\">&#8220;O Naphtali, sated with favor,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"DEU.33.23\"><span class=\"content\">and full of the blessing of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"DEU.33.23\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Josh. 19:32-39  </span></span><span class=\"content\">possess the lake</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:23 </span><span class=\"ft\">Or </span><span class=\"fq\">west</span></span></span><span class=\"content\"> and the south.&#8221;</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v23\" data-usfm=\"DEU.33.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"DEU.33.24\"><span class=\"label\">24</span><span class=\"content\">And </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 49:20] </span></span><span class=\"content\">of Asher he said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"DEU.33.24\"><span class=\"content\">&#8220;Most blessed of sons be Asher;</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"DEU.33.24\"><span class=\"content\">let him be the favorite of his brothers,</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"DEU.33.24\"><span class=\"content\">and let him </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Job 29:6]</span></span><span class=\"content\">dip his foot in oil.</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"DEU.33.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"DEU.33.25\"><span class=\"label\">25</span><span class=\"content\">Your bars shall be iron and bronze,</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"DEU.33.25\"><span class=\"content\">and as your days, so shall your strength be.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"DEU.33.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"DEU.33.26\"><span class=\"label\">26</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ex. 15:11   </span></span><span class=\"content\">&#8220;There is none like God, O </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 32:15 </span></span><span class=\"content\">Jeshurun,</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"DEU.33.26\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 68:33, 34; 104:3; Isa. 19:1; Hab. 3:8  </span></span><span class=\"content\">who rides through the heavens to your help,</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"DEU.33.26\"><span class=\"content\">through the skies in his majesty.</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"DEU.33.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"DEU.33.27\"><span class=\"label\">27</span><span class=\"content\">The eternal God is your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 90:1; 91:9</span></span><span class=\"content\">dwelling place,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:27 </span><span class=\"ft\">Or </span><span class=\"fq\">a dwelling place</span></span></span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"DEU.33.27\"><span class=\"content\">and underneath are the everlasting arms.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:27 </span><span class=\"ft\">Revocalization of verse 27 yields </span><span class=\"fq\">He subdues the ancient gods, and shatters the forces of old</span></span></span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"DEU.33.27\"><span class=\"content\">And he thrust out the enemy before you</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"DEU.33.27\"><span class=\"content\">and said, &#8216;Destroy.&#8217;</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"DEU.33.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"DEU.33.28\"><span class=\"label\">28</span><span class=\"content\">So Israel lived in safety,</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"DEU.33.28\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 68:26; Isa. 48:1]   </span></span><span class=\"content\">Jacob lived </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Num. 23:9</span></span><span class=\"content\">alone,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:28 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">the abode of Jacob was alone</span></span></span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"DEU.33.28\"><span class=\"content\">in a land of grain and wine,</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"DEU.33.28\"><span class=\"content\">whose heavens drop down dew.</span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"DEU.33.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"DEU.33.29\"><span class=\"label\">29</span><span class=\"content\">Happy are you, O Israel! </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Sam. 7:23] </span></span><span class=\"content\">Who is like you,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"DEU.33.29\"><span class=\"content\">a people </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 45:17 </span></span><span class=\"content\">saved by the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"DEU.33.29\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 33:20; 115:9-11  </span></span><span class=\"content\">the shield of your help,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"DEU.33.29\"><span class=\"content\">and the sword of your triumph!</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"DEU.33.29\"><span class=\"content\">Your enemies shall come fawning to you,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"DEU.33.29\"><span class=\"content\">and you shall tread upon their backs.&#8221;</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["DEU.34"], "human": "Deuteronomy 34", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["DEU.32"], "human": "Deuteronomy 32", "toc": true, "version_id": 59}, "reference": {"usfm": ["DEU.33"], "human": "Deuteronomy 33", "version_id": 59}}, "usfm": "DEU.33.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway,