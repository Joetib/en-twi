{"pageProps": {"params": {"versionId": "59", "usfm": "PRO.4.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PRO/4-0d2fbc881cf2845886cd43fa16ad7c3a.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PRO/4-0d2fbc881cf2845886cd43fa16ad7c3a.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPRO\">\n        <div class=\"chapter ch4\" data-usfm=\"PRO.4\">\n            <div class=\"label\">4</div><div class=\"s1\"><span class=\"heading\">A Father&#8217;s Wise Instruction</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PRO.4.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 1:8; [ch. 5:7; 7:24; 8:33; Ps. 34:11]   </span></span><span class=\"content\">Hear, O sons, a father&#8217;s instruction,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PRO.4.1\"><span class=\"content\">and be attentive, that you may </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:2</span></span><span class=\"content\">gain</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">4:1 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">know</span></span></span><span class=\"content\"> insight,</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PRO.4.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PRO.4.2\"><span class=\"label\">2</span><span class=\"content\">for I give you good </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 11:4</span></span><span class=\"content\">precepts;</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PRO.4.2\"><span class=\"content\">do not forsake my teaching.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PRO.4.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PRO.4.3\"><span class=\"label\">3</span><span class=\"content\">When I was a son with my father,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PRO.4.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See 1 Chr. 22:5   </span></span><span class=\"content\">tender, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Zech. 12:10</span></span><span class=\"content\">the only one in the sight of my mother,</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PRO.4.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PRO.4.4\"><span class=\"label\">4</span><span class=\"content\">he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Chr. 28:9; [Eph. 6:4] </span></span><span class=\"content\">taught me and said to me,</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PRO.4.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 3:1]   </span></span><span class=\"content\">&#8220;Let your heart hold fast my words;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PRO.4.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 7:2; Lev. 18:5; Isa. 55:3  </span></span><span class=\"content\">keep my commandments, and live.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PRO.4.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PRO.4.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 2:2   </span></span><span class=\"content\">Get wisdom; get </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 1 above]</span></span><span class=\"content\">insight;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PRO.4.5\"><span class=\"content\">do not forget, and do not turn away from the words of my mouth.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PRO.4.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PRO.4.6\"><span class=\"label\">6</span><span class=\"content\">Do not forsake her, and she will keep you;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PRO.4.6\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [2 Thess. 2:10]  </span></span><span class=\"content\">love her, and she will guard you.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PRO.4.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PRO.4.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 1:7]   </span></span><span class=\"content\">The beginning of wisdom is this: Get wisdom,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PRO.4.7\"><span class=\"content\">and whatever you get, get </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 1 above]</span></span><span class=\"content\">insight.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PRO.4.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PRO.4.8\"><span class=\"label\">8</span><span class=\"content\">Prize her highly, and she will exalt you;</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PRO.4.8\"><span class=\"content\">she will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Sam. 2:30 </span></span><span class=\"content\">honor you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Song 2:6]</span></span><span class=\"content\">if you embrace her.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PRO.4.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PRO.4.9\"><span class=\"label\">9</span><span class=\"content\">She will place on your head </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:9</span></span><span class=\"content\">a graceful garland;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PRO.4.9\"><span class=\"content\">she will bestow on you a beautiful crown.&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PRO.4.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PRO.4.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [See ver. 1 above]   </span></span><span class=\"content\">Hear, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:1 </span></span><span class=\"content\">my son, and accept my words,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PRO.4.10\"><span class=\"content\">that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 3:2</span></span><span class=\"content\">the years of your life may be many.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PRO.4.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PRO.4.11\"><span class=\"label\">11</span><span class=\"content\">I have </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Sam. 12:23</span></span><span class=\"content\">taught you the way of wisdom;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PRO.4.11\"><span class=\"content\">I have led you in the paths of uprightness.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PRO.4.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PRO.4.12\"><span class=\"label\">12</span><span class=\"content\">When you walk, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Job 18:7; Ps. 18:36; 119:45] </span></span><span class=\"content\">your step will not be hampered,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PRO.4.12\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:23</span></span><span class=\"content\">if you run, you will not stumble.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PRO.4.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PRO.4.13\"><span class=\"label\">13</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 3:18   </span></span><span class=\"content\">Keep hold of instruction; do not let go;</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PRO.4.13\"><span class=\"content\">guard her, for she is your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 22; [John 1:4; 1 John 5:12]</span></span><span class=\"content\">life.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PRO.4.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PRO.4.14\"><span class=\"label\">14</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 1:15; Ps. 1:1  </span></span><span class=\"content\">Do not enter the path of the wicked,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PRO.4.14\"><span class=\"content\">and do not walk in the way of the evil.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PRO.4.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PRO.4.15\"><span class=\"label\">15</span><span class=\"content\">Avoid it; do not go on it;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PRO.4.15\"><span class=\"content\">turn away from it and pass on.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PRO.4.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PRO.4.16\"><span class=\"label\">16</span><span class=\"content\">For they </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 36:4]</span></span><span class=\"content\">cannot sleep unless they have done wrong;</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PRO.4.16\"><span class=\"content\">they are robbed of sleep unless they have made someone stumble.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PRO.4.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PRO.4.17\"><span class=\"label\">17</span><span class=\"content\">For they eat the bread of wickedness</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PRO.4.17\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Amos 2:8]  </span></span><span class=\"content\">and drink the wine of violence.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PRO.4.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PRO.4.18\"><span class=\"label\">18</span><span class=\"content\">But </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 11:17; 22:28; Isa. 60:3; 62:1, 2; Dan. 12:3 </span></span><span class=\"content\">the path of the righteous is like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Sam. 23:4; See Ps. 97:11 </span></span><span class=\"content\">the light of dawn,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PRO.4.18\"><span class=\"content\">which shines </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 84:7] </span></span><span class=\"content\">brighter and brighter until </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 John 3:2]</span></span><span class=\"content\">full day.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"PRO.4.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"PRO.4.19\"><span class=\"label\">19</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        1 Sam. 2:9; Isa. 59:9, 10; Jer. 23:12; John 12:35; [Job 18:5]   </span></span><span class=\"content\">The way of the wicked is like deep </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Matt. 6:23] </span></span><span class=\"content\">darkness;</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"PRO.4.19\"><span class=\"content\">they do not know over what they </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[John 11:10; 1 John 2:10]</span></span><span class=\"content\">stumble.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"PRO.4.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"PRO.4.20\"><span class=\"label\">20</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 10  </span></span><span class=\"content\">My son, be attentive to my words;</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"PRO.4.20\"><span class=\"content\">incline your ear to my sayings.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"PRO.4.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"PRO.4.21\"><span class=\"label\">21</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 3:21   </span></span><span class=\"content\">Let them not escape from your sight;</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"PRO.4.21\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 2:1]  </span></span><span class=\"content\">keep them within your heart.</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"PRO.4.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"PRO.4.22\"><span class=\"label\">22</span><span class=\"content\">For they are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 13; ch. 8:35; 21:21; Deut. 32:47; [1 Tim. 4:8]</span></span><span class=\"content\">life to those who find them,</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"PRO.4.22\"><span class=\"content\">and healing to all their</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">4:22 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">his</span></span></span><span class=\"content\"> flesh.</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"PRO.4.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"PRO.4.23\"><span class=\"label\">23</span><span class=\"content\">Keep your heart with all vigilance,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"PRO.4.23\"><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Matt. 12:35] </span></span><span class=\"content\">from it flow </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 16:11]</span></span><span class=\"content\">the springs of life.</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"PRO.4.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"PRO.4.24\"><span class=\"label\">24</span><span class=\"content\">Put away from you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 6:12 </span></span><span class=\"content\">crooked speech,</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"PRO.4.24\"><span class=\"content\">and put </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:15</span></span><span class=\"content\">devious talk far from you.</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"PRO.4.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"PRO.4.25\"><span class=\"label\">25</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Heb. 12:2]  </span></span><span class=\"content\">Let your eyes look directly forward,</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"PRO.4.25\"><span class=\"content\">and your gaze be straight before you.</span></span></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"PRO.4.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"PRO.4.26\"><span class=\"label\">26</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 5:6, 21; [Heb. 12:13]   </span></span><span class=\"content\">Ponder</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">4:26 </span><span class=\"ft\">Or </span><span class=\"fq\">Make level</span></span></span><span class=\"content\"> the path of your feet;</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"PRO.4.26\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 119:5]  </span></span><span class=\"content\">then all your ways will be sure.</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"PRO.4.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"PRO.4.27\"><span class=\"label\">27</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Deut. 5:32; 28:14; Josh. 1:7; 1 Kgs. 15:5  </span></span><span class=\"content\">Do not swerve to the right or to the left;</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"PRO.4.27\"><span class=\"content\">turn your foot away from evil.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News 