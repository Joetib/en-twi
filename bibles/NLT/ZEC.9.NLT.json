{"pageProps": {"params": {"versionId": "59", "usfm": "ZEC.9.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/ZEC/9-629cf62bd5dce9923470841724f044c6.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/ZEC/9-629cf62bd5dce9923470841724f044c6.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkZEC\">\n        <div class=\"chapter ch9\" data-usfm=\"ZEC.9\">\n            <div class=\"label\">9</div><div class=\"s1\"><span class=\"heading\">Judgment on Israel&#8217;s Enemies</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"ZEC.9.1\"><span class=\"label\">1</span><span class=\"content\">The oracle of the word of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is against the land of Hadrach</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"ZEC.9.1\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Isa. 17:1</span></span><span class=\"content\">Damascus is its resting place.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"ZEC.9.1\"><span class=\"content\">For the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> has an eye on mankind</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"ZEC.9.1\"><span class=\"content\">and on all the tribes of Israel,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">9:1 </span><span class=\"ft\">Or </span><span class=\"fq\">For the eye of mankind, especially of all the tribes of Israel, is toward the </span><span class=\"ft\"><span class=\"bdit\">Lord</span>  </span></span></span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"ZEC.9.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"ZEC.9.2\"><span class=\"label\">2</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Jer. 49:23; See 1 Kgs. 8:65   </span></span><span class=\"content\">and on Hamath also, which borders on it,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ZEC.9.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Josh. 19:28, 29; Isa. 23:1, 2   </span></span><span class=\"content\">Tyre and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Josh. 19:28, 29; Isa. 23:1, 2 </span></span><span class=\"content\">Sidon, though </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ezek. 28:3-5</span></span><span class=\"content\">they are very wise.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ZEC.9.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"ZEC.9.3\"><span class=\"label\">3</span><span class=\"content\">Tyre has built herself </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Josh. 19:29] </span></span><span class=\"content\">a rampart</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"ZEC.9.3\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ezek. 28:4, 5</span></span><span class=\"content\">heaped up silver like dust,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"ZEC.9.3\"><span class=\"content\">and fine gold like the mud of the streets.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"ZEC.9.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"ZEC.9.4\"><span class=\"label\">4</span><span class=\"content\">But behold, the Lord will strip her of her possessions</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"ZEC.9.4\"><span class=\"content\">and strike down </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ezek. 26:17 </span></span><span class=\"content\">her power on the sea,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"ZEC.9.4\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ezek. 28:18</span></span><span class=\"content\">she shall be devoured by fire.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"ZEC.9.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"ZEC.9.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Zeph. 2:4  </span></span><span class=\"content\">Ashkelon shall see it, and be afraid;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ZEC.9.5\"><span class=\"content\">Gaza too, and shall writhe in anguish;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ZEC.9.5\"><span class=\"content\">Ekron also, because its hopes are confounded.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"ZEC.9.5\"><span class=\"content\">The king shall perish from Gaza;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ZEC.9.5\"><span class=\"content\">Ashkelon shall be uninhabited;</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"ZEC.9.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"ZEC.9.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Deut. 23:2]  </span></span><span class=\"content\">a mixed people</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">9:6 </span><span class=\"ft\">Or </span><span class=\"fq\">a foreign people</span><span class=\"ft\">; Hebrew </span><span class=\"fq\">a bastard</span></span></span><span class=\"content\"> shall dwell in Ashdod,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ZEC.9.6\"><span class=\"content\">and I will cut off the pride of Philistia.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"ZEC.9.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"ZEC.9.7\"><span class=\"label\">7</span><span class=\"content\">I will take away </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Lev. 3:17 </span></span><span class=\"content\">its blood from its mouth,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ZEC.9.7\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 66:17] </span></span><span class=\"content\">its abominations from between its teeth;</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ZEC.9.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 14:1]   </span></span><span class=\"content\">it too shall be a remnant for our God;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ZEC.9.7\"><span class=\"content\">it shall be like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 12:5, 6</span></span><span class=\"content\">a clan in Judah,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ZEC.9.7\"><span class=\"content\">and Ekron shall be like the Jebusites.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ZEC.9.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"ZEC.9.8\"><span class=\"label\">8</span><span class=\"content\">Then </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 2:5] </span></span><span class=\"content\">I will encamp at my house as a guard,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"ZEC.9.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 7:14   </span></span><span class=\"content\">so that none shall march to and fro;</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"ZEC.9.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 10:4; [Isa. 60:17]   </span></span><span class=\"content\">no oppressor shall again march over them,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"ZEC.9.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 12:4]  </span></span><span class=\"content\">for now I see with my own eyes.</span></span></div><div class=\"s1\"><span class=\"heading\">The Coming King of Zion</span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"ZEC.9.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"ZEC.9.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Zeph. 3:14   </span></span><span class=\"content\">Rejoice greatly, O daughter of Zion!</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"ZEC.9.9\"><span class=\"content\">Shout aloud, O daughter of Jerusalem!</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"ZEC.9.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    Cited Matt. 21:5; [John 12:15]   </span></span><span class=\"content\">Behold, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Jer. 23:5 </span></span><span class=\"content\">your king is coming to you;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"ZEC.9.9\"><span class=\"content\">righteous and having salvation is he,</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"ZEC.9.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 11:29]  </span></span><span class=\"content\">humble and mounted on a donkey,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"ZEC.9.9\"><span class=\"content\">on a colt, the foal of a donkey.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"ZEC.9.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"ZEC.9.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Hos. 1:7   </span></span><span class=\"content\">I will cut off the chariot from Ephraim</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"ZEC.9.10\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Mic. 5:10 </span></span><span class=\"content\">the war horse from Jerusalem;</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"ZEC.9.10\"><span class=\"content\">and the battle bow shall be cut off,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"ZEC.9.10\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Mic. 5:5 </span></span><span class=\"content\">he shall speak peace to the nations;</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"ZEC.9.10\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 72:8   </span></span><span class=\"content\">his rule shall be from sea to sea,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"ZEC.9.10\"><span class=\"content\">and from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ex. 23:31</span></span><span class=\"content\">the River</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">9:10 </span><span class=\"ft\">That is, the Euphrates</span></span></span><span class=\"content\"> to the ends of the earth.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"ZEC.9.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"ZEC.9.11\"><span class=\"label\">11</span><span class=\"content\">As for you also, because of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 24:8 </span></span><span class=\"content\">the blood of my covenant with you,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"ZEC.9.11\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 42:7; 51:14; 61:1   </span></span><span class=\"content\">I will set your prisoners free from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 37:24; Jer. 38:6]</span></span><span class=\"content\">the waterless pit.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"ZEC.9.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"ZEC.9.12\"><span class=\"label\">12</span><span class=\"content\">Return to your stronghold, O </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Jer. 31:17] </span></span><span class=\"content\">prisoners of hope;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"ZEC.9.12\"><span class=\"content\">today I declare that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 61:7</span></span><span class=\"content\">I will restore to you double.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"ZEC.9.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"ZEC.9.13\"><span class=\"label\">13</span><span class=\"content\">For </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 10:3, 4] </span></span><span class=\"content\">I have bent Judah as my bow;</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"ZEC.9.13\"><span class=\"content\">I have made Ephraim its arrow.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"ZEC.9.13\"><span class=\"content\">I will stir up your sons, O Zion,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"ZEC.9.13\"><span class=\"content\">against your sons, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 10:2; Ezek. 27:13</span></span><span class=\"content\">O Greece,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"ZEC.9.13\"><span class=\"content\">and wield you like a warrior&#8217;s sword.</span></span></div><div class=\"s1\"><span class=\"heading\">The </span><span class=\"nd\"><span class=\"heading\">Lord</span></span><span class=\"heading\"> Will Save His People</span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"ZEC.9.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"ZEC.9.14\"><span class=\"label\">14</span><span class=\"content\">Then the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> will appear over them,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"ZEC.9.14\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 2 Sam. 22:15 </span></span><span class=\"content\">his arrow will go forth like lightning;</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"ZEC.9.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 27:13]   </span></span><span class=\"content\">the Lord </span><span class=\"nd\"><span class=\"content\">God</span></span><span class=\"content\"> will sound the trumpet</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"ZEC.9.14\"><span class=\"content\">and will march forth in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 21:1 </span></span><span class=\"content\">the whirlwinds </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 6:6]</span></span><span class=\"content\">of the south.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"ZEC.9.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"ZEC.9.15\"><span class=\"label\">15</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> of hosts </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 12:8; [ch. 10:5] </span></span><span class=\"content\">will protect them,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"ZEC.9.15\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 12:6 </span></span><span class=\"content\">they shall devour, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 10:5] </span></span><span class=\"content\">and tread down the sling stones,</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"ZEC.9.15\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 10:7 </span></span><span class=\"content\">they shall drink and roar as if drunk with wine,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"ZEC.9.15\"><span class=\"content\">and be full like a bowl,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"ZEC.9.15\"><span class=\"content\">drenched </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Lev. 4:18, 25]</span></span><span class=\"content\">like the corners of the altar.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"ZEC.9.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"ZEC.9.16\"><span class=\"label\">16</span><span class=\"content\">On that day the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> their God will save them,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"ZEC.9.16\"><span class=\"content\">as </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 100:3 </span></span><span class=\"content\">the flock of his people;</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"ZEC.9.16\"><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 62:3; [Mal. 3:17]</span></span><span class=\"content\">like the jewels of a crown</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"ZEC.9.16\"><span class=\"content\">they shall shine on his land.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"ZEC.9.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"ZEC.9.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 62:3, 4]   </span></span><span class=\"content\">For how great is his goodness, and how great his beauty!</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"ZEC.9.17\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 62:8, 9; Jer. 31:12]  </span></span><span class=\"content\">Grain shall make the young men flourish,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"ZEC.9.17\"><span class=\"content\">and new wine the young women.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["ZEC.10"], "human": "Zechariah 10", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["ZEC.8"], "human": "Zechariah 8", "toc": true, "version_id": 59}, "reference": {"usfm": ["ZEC.9"], "human": "Zechariah 9", "version_id": 59}}, "usfm": "ZEC.9.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard