{"pageProps": {"params": {"versionId": "59", "usfm": "2SA.22.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/2SA/22-ddf4cadcee8eae177b7a658a94593501.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/2SA/22-ddf4cadcee8eae177b7a658a94593501.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bk2SA\">\n        <div class=\"chapter ch22\" data-usfm=\"2SA.22\">\n            <div class=\"label\">22</div><div class=\"s1\"><span class=\"heading\">David&#8217;s Song of Deliverance</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"2SA.22.1\"><span class=\"label\">1</span><span class=\"content\">And David spoke </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ex. 15:1; Judg. 5:1; 1 Chr. 16:7]</span></span><span class=\"content\">to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> the words of this song on the day when the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> delivered him from the hand of all his enemies, and from the hand of Saul. </span></span><span class=\"verse v2\" data-usfm=\"2SA.22.2\"><span class=\"label\">2</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">For ver. 1-51, see Ps. 18:2-50 </span></span><span class=\"content\">He said,</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"2SA.22.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Deut. 32:4; Ps. 31:3; 71:3; 91:2; 144:2  </span></span><span class=\"content\">&#8220;The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is my rock and my fortress and my deliverer,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"2SA.22.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"2SA.22.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 32, 47   </span></span><span class=\"content\">my</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:3 </span><span class=\"ft\">Septuagint (compare Psalm 18:2); Hebrew lacks </span><span class=\"fq\">my</span></span></span><span class=\"content\"> God, my rock, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Heb. 2:13] </span></span><span class=\"content\">in whom I take refuge,</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"2SA.22.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 31; Gen. 15:1   </span></span><span class=\"content\">my shield, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 1:69 </span></span><span class=\"content\">the horn of my salvation,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"2SA.22.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 9:9; 59:9, 16, 17; 62:2, 6; [Prov. 18:10]   </span></span><span class=\"content\">my stronghold and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 14:6; 46:7, 11; 71:7; Jer. 16:19</span></span><span class=\"content\">my refuge,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"2SA.22.3\"><span class=\"content\">my savior; you save me from violence.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"2SA.22.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"2SA.22.4\"><span class=\"label\">4</span><span class=\"content\">I call upon the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, who is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Chr. 16:25; Ps. 48:1; 96:4</span></span><span class=\"content\">worthy to be praised,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"2SA.22.4\"><span class=\"content\">and I am saved from my enemies.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"2SA.22.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"2SA.22.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 42:7; 93:4; Jonah 2:3]  </span></span><span class=\"content\">&#8220;For the waves of death encompassed me,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"2SA.22.5\"><span class=\"content\">the torrents of destruction assailed me;</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:5 </span><span class=\"ft\">Or </span><span class=\"fq\">terrified me</span></span></span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"2SA.22.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"2SA.22.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 116:3\n        </span></span><span class=\"content\">the cords of Sheol entangled me;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"2SA.22.6\"><span class=\"content\">the snares of death confronted me.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"2SA.22.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"2SA.22.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 116:4; 120:1; Jonah 2:2   </span></span><span class=\"content\">&#8220;In my distress I called upon the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"2SA.22.7\"><span class=\"content\">to my God I called.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"2SA.22.7\"><span class=\"content\">From his temple he heard my voice,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"2SA.22.7\"><span class=\"content\">and my cry </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 18:6</span></span><span class=\"content\">came to his ears.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"2SA.22.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"2SA.22.8\"><span class=\"label\">8</span><span class=\"content\">&#8220;Then </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Judg. 5:4; Ps. 77:18; 97:4 </span></span><span class=\"content\">the earth reeled and rocked;</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"2SA.22.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Job 26:11]  </span></span><span class=\"content\">the foundations of the heavens trembled</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"2SA.22.8\"><span class=\"content\">and quaked, because he was angry.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"2SA.22.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"2SA.22.9\"><span class=\"label\">9</span><span class=\"content\">Smoke went up from his nostrils,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:9 </span><span class=\"ft\">Or </span><span class=\"fq\">in his wrath</span></span></span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"2SA.22.9\"><span class=\"content\">and devouring fire from his mouth;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"2SA.22.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 13  </span></span><span class=\"content\">glowing coals flamed forth from him.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"2SA.22.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"2SA.22.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 144:5   </span></span><span class=\"content\">He bowed the heavens and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 64:1 </span></span><span class=\"content\">came down;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"2SA.22.10\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ex. 20:21; 1 Kgs. 8:12; Ps. 97:2]  </span></span><span class=\"content\">thick darkness was under his feet.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"2SA.22.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"2SA.22.11\"><span class=\"label\">11</span><span class=\"content\">He rode on a cherub and flew;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"2SA.22.11\"><span class=\"content\">he was seen on </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 104:3</span></span><span class=\"content\">the wings of the wind.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"2SA.22.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"2SA.22.12\"><span class=\"label\">12</span><span class=\"content\">He made </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 10 above] </span></span><span class=\"content\">darkness around him </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 36:29</span></span><span class=\"content\">his canopy,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"2SA.22.12\"><span class=\"content\">thick clouds, a gathering of water.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"2SA.22.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"2SA.22.13\"><span class=\"label\">13</span><span class=\"content\">Out of the brightness before him</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"2SA.22.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 9  </span></span><span class=\"content\">coals of fire flamed forth.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"2SA.22.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"2SA.22.14\"><span class=\"label\">14</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Job 37:4; Ps. 29:3  </span></span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> thundered from heaven,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"2SA.22.14\"><span class=\"content\">and the Most High uttered his voice.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"2SA.22.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"2SA.22.15\"><span class=\"label\">15</span><span class=\"content\">And he sent out </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 32:23; Ps. 7:13; 77:17; 144:6; Hab. 3:11</span></span><span class=\"content\">arrows and scattered them;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"2SA.22.15\"><span class=\"content\">lightning, and routed them.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"2SA.22.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"2SA.22.16\"><span class=\"label\">16</span><span class=\"content\">Then the channels of the sea were seen;</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"2SA.22.16\"><span class=\"content\">the foundations of the world were laid bare,</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"2SA.22.16\"><span class=\"content\">at the rebuke of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"2SA.22.16\"><span class=\"content\">at the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 15:8</span></span><span class=\"content\">blast of the breath of his nostrils.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"2SA.22.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"2SA.22.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 144:7\n        </span></span><span class=\"content\">&#8220;He sent from on high, he took me;</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"2SA.22.17\"><span class=\"content\">he drew me out of many waters.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"2SA.22.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"2SA.22.18\"><span class=\"label\">18</span><span class=\"content\">He rescued me from my strong enemy,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"2SA.22.18\"><span class=\"content\">from those who hated me,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"2SA.22.18\"><span class=\"content\">for they were too mighty for me.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"2SA.22.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"2SA.22.19\"><span class=\"label\">19</span><span class=\"content\">They confronted me in the day of my calamity,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"2SA.22.19\"><span class=\"content\">but the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> was my support.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"2SA.22.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"2SA.22.20\"><span class=\"label\">20</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 31:8; 118:5   </span></span><span class=\"content\">He brought me out into a broad place;</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"2SA.22.20\"><span class=\"content\">he rescued me, because </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 15:26</span></span><span class=\"content\">he delighted in me.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"2SA.22.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"2SA.22.21\"><span class=\"label\">21</span><span class=\"content\">&#8220;The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Sam. 26:23; 1 Kgs. 8:32; Ps. 7:8 </span></span><span class=\"content\">dealt with me according to my righteousness;</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"2SA.22.21\"><span class=\"content\">according to the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 24:4]</span></span><span class=\"content\">cleanness of my hands he rewarded me.</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"2SA.22.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"2SA.22.22\"><span class=\"label\">22</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Gen. 18:19; Prov. 8:32  </span></span><span class=\"content\">For I have kept the ways of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"2SA.22.22\"><span class=\"content\">and have not wickedly departed from my God.</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"2SA.22.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"2SA.22.23\"><span class=\"label\">23</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 119:30, 102  </span></span><span class=\"content\">For all his rules were before me,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"2SA.22.23\"><span class=\"content\">and from his statutes I did not turn aside.</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"2SA.22.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"2SA.22.24\"><span class=\"label\">24</span><span class=\"content\">I was </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 6:9; 17:1; Job 1:1]</span></span><span class=\"content\">blameless before him,</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"2SA.22.24\"><span class=\"content\">and I kept myself from guilt.</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"2SA.22.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"2SA.22.25\"><span class=\"label\">25</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [See ver. 21 above]  </span></span><span class=\"content\">And the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> has rewarded me according to my righteousness,</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"2SA.22.25\"><span class=\"content\">according to my cleanness in his sight.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"2SA.22.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"2SA.22.26\"><span class=\"label\">26</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 5:7]   </span></span><span class=\"content\">&#8220;With the merciful you show yourself merciful;</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"2SA.22.26\"><span class=\"content\">with the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 24 above]</span></span><span class=\"content\">blameless man you show yourself blameless;</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"2SA.22.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"2SA.22.27\"><span class=\"label\">27</span><span class=\"content\">with the purified you deal purely,</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"2SA.22.27\"><span class=\"content\">and with the crooked you make yourself seem tortuous.</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"2SA.22.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"2SA.22.28\"><span class=\"label\">28</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 72:12, 13]   </span></span><span class=\"content\">You save a humble people,</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"2SA.22.28\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 2:11, 12, 17; Luke 1:51]  </span></span><span class=\"content\">but your eyes are on the haughty to bring them down.</span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"2SA.22.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"2SA.22.29\"><span class=\"label\">29</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Job 29:3; Ps. 27:1; [ch. 21:17]  </span></span><span class=\"content\">For you are my lamp, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"2SA.22.29\"><span class=\"content\">and my God lightens my darkness.</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"2SA.22.29\"><span class=\"content\">  </span></span><span class=\"verse v30\" data-usfm=\"2SA.22.30\"><span class=\"label\">30</span><span class=\"content\">For by you I can run against a troop,</span></span></div><div class=\"q2\"><span class=\"verse v30\" data-usfm=\"2SA.22.30\"><span class=\"content\">and by my God I can leap over a wall.</span></span></div><div class=\"q1\"><span class=\"verse v30\" data-usfm=\"2SA.22.30\"><span class=\"content\">  </span></span><span class=\"verse v31\" data-usfm=\"2SA.22.31\"><span class=\"label\">31</span><span class=\"content\">This God&#8212;</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 32:4; Matt. 5:48 </span></span><span class=\"content\">his way is perfect;</span></span></div><div class=\"q2\"><span class=\"verse v31\" data-usfm=\"2SA.22.31\"><span class=\"content\">the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Prov. 30:5 </span></span><span class=\"content\">word of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> proves true;</span></span></div><div class=\"q2\"><span class=\"verse v31\" data-usfm=\"2SA.22.31\"><span class=\"content\">he is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 3; Ps. 5:12; 33:20; 59:11; 84:9</span></span><span class=\"content\">a shield for all those who take refuge in him.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v31\" data-usfm=\"2SA.22.31\"><span class=\"content\">  </span></span><span class=\"verse v32\" data-usfm=\"2SA.22.32\"><span class=\"label\">32</span><span class=\"content\">&#8220;For who is God, but the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">?</span></span></div><div class=\"q2\"><span class=\"verse v32\" data-usfm=\"2SA.22.32\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ver. 2  </span></span><span class=\"content\">And who is a rock, except our God?</span></span></div><div class=\"q1\"><span class=\"verse v32\" data-usfm=\"2SA.22.32\"><span class=\"content\">  </span></span><span class=\"verse v33\" data-usfm=\"2SA.22.33\"><span class=\"label\">33</span><span class=\"content\">This God is my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 2; Ps. 28:8; 31:3, 4</span></span><span class=\"content\">strong refuge</span></span></div><div class=\"q2\"><span class=\"verse v33\" data-usfm=\"2SA.22.33\"><span class=\"content\">and has made my</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:33 </span><span class=\"ft\">Or </span><span class=\"fq\">his</span><span class=\"ft\">; also verse 34</span></span></span><span class=\"content\"> way blameless.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:33 </span><span class=\"ft\">Compare Psalm 18:32; Hebrew </span><span class=\"fq\">he has blamelessly set my way free</span><span class=\"ft\">, or </span><span class=\"fq\">he has made my way spring up blamelessly</span></span></span></span></div><div class=\"q1\"><span class=\"verse v33\" data-usfm=\"2SA.22.33\"><span class=\"content\">  </span></span><span class=\"verse v34\" data-usfm=\"2SA.22.34\"><span class=\"label\">34</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 2:18   </span></span><span class=\"content\">He made my feet like the feet of a deer</span></span></div><div class=\"q2\"><span class=\"verse v34\" data-usfm=\"2SA.22.34\"><span class=\"content\">and set me secure </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 32:13; 33:29; Isa. 58:14</span></span><span class=\"content\">on the heights.</span></span></div><div class=\"q1\"><span class=\"verse v34\" data-usfm=\"2SA.22.34\"><span class=\"content\">  </span></span><span class=\"verse v35\" data-usfm=\"2SA.22.35\"><span class=\"label\">35</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 144:1\n        </span></span><span class=\"content\">He trains my hands for war,</span></span></div><div class=\"q2\"><span class=\"verse v35\" data-usfm=\"2SA.22.35\"><span class=\"content\">so that my arms can bend a bow of bronze.</span></span></div><div class=\"q1\"><span class=\"verse v35\" data-usfm=\"2SA.22.35\"><span class=\"content\">  </span></span><span class=\"verse v36\" data-usfm=\"2SA.22.36\"><span class=\"label\">36</span><span class=\"content\">You have given me the shield of your salvation,</span></span></div><div class=\"q2\"><span class=\"verse v36\" data-usfm=\"2SA.22.36\"><span class=\"content\">and your gentleness made me great.</span></span></div><div class=\"q1\"><span class=\"verse v36\" data-usfm=\"2SA.22.36\"><span class=\"content\">  </span></span><span class=\"verse v37\" data-usfm=\"2SA.22.37\"><span class=\"label\">37</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Prov. 4:12\n        </span></span><span class=\"content\">You gave a wide place for my steps under me,</span></span></div><div class=\"q2\"><span class=\"verse v37\" data-usfm=\"2SA.22.37\"><span class=\"content\">and my feet</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:37 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">ankles</span></span></span><span class=\"content\"> did not slip;</span></span></div><div class=\"q1\"><span class=\"verse v37\" data-usfm=\"2SA.22.37\"><span class=\"content\">  </span></span><span class=\"verse v38\" data-usfm=\"2SA.22.38\"><span class=\"label\">38</span><span class=\"content\">I pursued my enemies and destroyed them,</span></span></div><div class=\"q2\"><span class=\"verse v38\" data-usfm=\"2SA.22.38\"><span class=\"content\">and did not turn back until they were consumed.</span></span></div><div class=\"q1\"><span class=\"verse v38\" data-usfm=\"2SA.22.38\"><span class=\"content\">  </span></span><span class=\"verse v39\" data-usfm=\"2SA.22.39\"><span class=\"label\">39</span><span class=\"content\">I consumed them; I thrust them through, so that they did not rise;</span></span></div><div class=\"q2\"><span class=\"verse v39\" data-usfm=\"2SA.22.39\"><span class=\"content\">they fell </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Mal. 4:3]</span></span><span class=\"content\">under my feet.</span></span></div><div class=\"q1\"><span class=\"verse v39\" data-usfm=\"2SA.22.39\"><span class=\"content\">  </span></span><span class=\"verse v40\" data-usfm=\"2SA.22.40\"><span class=\"label\">40</span><span class=\"content\">For you equipped me with strength for the battle;</span></span></div><div class=\"q2\"><span class=\"verse v40\" data-usfm=\"2SA.22.40\"><span class=\"content\">you made </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 44:5; 59:1</span></span><span class=\"content\">those who rise against me sink under me.</span></span></div><div class=\"q1\"><span class=\"verse v40\" data-usfm=\"2SA.22.40\"><span class=\"content\">  </span></span><span class=\"verse v41\" data-usfm=\"2SA.22.41\"><span class=\"label\">41</span><span class=\"content\">You </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 23:27</span></span><span class=\"content\">made my enemies turn their backs to me,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:41 </span><span class=\"ft\">Or </span><span class=\"fq\">You gave me my enemies&#8217; necks</span></span></span></span></div><div class=\"q2\"><span class=\"verse v41\" data-usfm=\"2SA.22.41\"><span class=\"content\">those who hated me, and I destroyed them.</span></span></div><div class=\"q1\"><span class=\"verse v41\" data-usfm=\"2SA.22.41\"><span class=\"content\">  </span></span><span class=\"verse v42\" data-usfm=\"2SA.22.42\"><span class=\"label\">42</span><span class=\"content\">They looked, but there was none to save;</span></span></div><div class=\"q2\"><span class=\"verse v42\" data-usfm=\"2SA.22.42\"><span class=\"content\">they cried to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Sam. 28:6; Prov. 1:28; [Isa. 1:15; Mic. 3:4]</span></span><span class=\"content\">he did not answer them.</span></span></div><div class=\"q1\"><span class=\"verse v42\" data-usfm=\"2SA.22.42\"><span class=\"content\">  </span></span><span class=\"verse v43\" data-usfm=\"2SA.22.43\"><span class=\"label\">43</span><span class=\"content\">I beat them fine </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Kgs. 13:7 </span></span><span class=\"content\">as the dust of the earth;</span></span></div><div class=\"q2\"><span class=\"verse v43\" data-usfm=\"2SA.22.43\"><span class=\"content\">I crushed them and stamped them down </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 10:6; Mic. 7:10; Zech. 10:5</span></span><span class=\"content\">like the mire of the streets.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v43\" data-usfm=\"2SA.22.43\"><span class=\"content\">  </span></span><span class=\"verse v44\" data-usfm=\"2SA.22.44\"><span class=\"label\">44</span><span class=\"content\">&#8220;You delivered me from strife with my people;</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:44 </span><span class=\"ft\">Septuagint </span><span class=\"fq\">with the peoples</span></span></span></span></div><div class=\"q2\"><span class=\"verse v44\" data-usfm=\"2SA.22.44\"><span class=\"content\">you kept me as the head of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 8:1-14 </span></span><span class=\"content\">the nations;</span></span></div><div class=\"q2\"><span class=\"verse v44\" data-usfm=\"2SA.22.44\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 55:5\n        </span></span><span class=\"content\">people whom I had not known served me.</span></span></div><div class=\"q1\"><span class=\"verse v44\" data-usfm=\"2SA.22.44\"><span class=\"content\">  </span></span><span class=\"verse v45\" data-usfm=\"2SA.22.45\"><span class=\"label\">45</span><span class=\"content\">Foreigners came cringing to me;</span></span></div><div class=\"q2\"><span class=\"verse v45\" data-usfm=\"2SA.22.45\"><span class=\"content\">as soon as they heard of me, they obeyed me.</span></span></div><div class=\"q1\"><span class=\"verse v45\" data-usfm=\"2SA.22.45\"><span class=\"content\">  </span></span><span class=\"verse v46\" data-usfm=\"2SA.22.46\"><span class=\"label\">46</span><span class=\"content\">Foreigners lost heart</span></span></div><div class=\"q2\"><span class=\"verse v46\" data-usfm=\"2SA.22.46\"><span class=\"content\">and came trembling</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:46 </span><span class=\"ft\">Compare Psalm 18:45; Hebrew </span><span class=\"fq\">equipped themselves</span></span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Mic. 7:17</span></span><span class=\"content\">out of their fortresses.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v46\" data-usfm=\"2SA.22.46\"><span class=\"content\">  </span></span><span class=\"verse v47\" data-usfm=\"2SA.22.47\"><span class=\"label\">47</span><span class=\"content\">&#8220;The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> lives, and blessed be my rock,</span></span></div><div class=\"q2\"><span class=\"verse v47\" data-usfm=\"2SA.22.47\"><span class=\"content\">and exalted be </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 3, 32 </span></span><span class=\"content\">my God, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 32:15; Ps. 89:26; 95:1</span></span><span class=\"content\">the rock of my salvation,</span></span></div><div class=\"q1\"><span class=\"verse v47\" data-usfm=\"2SA.22.47\"><span class=\"content\">  </span></span><span class=\"verse v48\" data-usfm=\"2SA.22.48\"><span class=\"label\">48</span><span class=\"content\">the God who gave me vengeance</span></span></div><div class=\"q2\"><span class=\"verse v48\" data-usfm=\"2SA.22.48\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 144:2</span></span><span class=\"content\">brought down peoples under me,</span></span></div><div class=\"q1\"><span class=\"verse v48\" data-usfm=\"2SA.22.48\"><span class=\"content\">  </span></span><span class=\"verse v49\" data-usfm=\"2SA.22.49\"><span class=\"label\">49</span><span class=\"content\">who brought me out from my enemies;</span></span></div><div class=\"q2\"><span class=\"verse v49\" data-usfm=\"2SA.22.49\"><span class=\"content\">you exalted me above </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 40 above] </span></span><span class=\"content\">those who rose against me;</span></span></div><div class=\"q2\"><span class=\"verse v49\" data-usfm=\"2SA.22.49\"><span class=\"content\">you delivered me from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 140:1</span></span><span class=\"content\">men of violence.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v49\" data-usfm=\"2SA.22.49\"><span class=\"content\">  </span></span><span class=\"verse v50\" data-usfm=\"2SA.22.50\"><span class=\"label\">50</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    Cited Rom. 15:9  </span></span><span class=\"content\">&#8220;For this I will praise you, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, among the nations,</span></span></div><div class=\"q2\"><span class=\"verse v50\" data-usfm=\"2SA.22.50\"><span class=\"content\">and sing praises to your name.</span></span></div><div class=\"q1\"><span class=\"verse v50\" data-usfm=\"2SA.22.50\"><span class=\"content\">  </span></span><span class=\"verse v51\" data-usfm=\"2SA.22.51\"><span class=\"label\">51</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 144:10]   </span></span><span class=\"content\">Great salvation he brings</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">22:51 </span><span class=\"ft\">Or </span><span class=\"fq\">He is a tower of salvation</span></span></span><span class=\"content\"> to his king,</span></span></div><div class=\"q2\"><span class=\"verse v51\" data-usfm=\"2SA.22.51\"><span class=\"content\">and shows steadfast love to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Sam. 16:12, 13; Ps. 89:20] </span></span><span class=\"content\">his anointed,</span></span></div><div class=\"q2\"><span class=\"verse v51\" data-usfm=\"2SA.22.51\"><span class=\"content\">to David and his offspring </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 7:12, 13; Ps. 89:29</span></span><span class=\"content\">forever.&#8221;</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["2SA.23"], "human": "2 Samuel 23", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["2SA.21"], "human": "2 Samuel 21", "toc": true, "version_id": 59}, "reference": {"usfm": ["2SA.22"], "human": "2 Samuel 22", "version_id": 59}}, "usfm": "2SA.22.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p> \r\n<p>Sign up to receive news and updates about the ESV:</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), 