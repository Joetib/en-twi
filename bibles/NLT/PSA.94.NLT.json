{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.94.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/94-b0a5f01bd952e29429637b63c7ddb9dd.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/94-b0a5f01bd952e29429637b63c7ddb9dd.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch94\" data-usfm=\"PSA.94\">\n            <div class=\"label\">94</div><div class=\"s1\"><span class=\"heading\">The </span><span class=\"nd\"><span class=\"heading\">Lord</span></span><span class=\"heading\"> Will Not Forsake His People</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.94.1\"><span class=\"label\">1</span><span class=\"content\">O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, God of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 32:35, 41, 43; Isa. 35:4; Jer. 51:56; Nah. 1:2; Rom. 12:19 </span></span><span class=\"content\">vengeance,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.94.1\"><span class=\"content\">O God of vengeance, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 50:2</span></span><span class=\"content\">shine forth!</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.94.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.94.2\"><span class=\"label\">2</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 7:6   </span></span><span class=\"content\">Rise up, O </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 58:11 </span></span><span class=\"content\">judge of the earth;</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.94.2\"><span class=\"content\">repay to the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 1:51</span></span><span class=\"content\">proud what they deserve!</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.94.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.94.3\"><span class=\"label\">3</span><span class=\"content\">O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Rev. 6:10; See Ps. 74:10 </span></span><span class=\"content\">how long shall the wicked,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.94.3\"><span class=\"content\">how long shall </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Job 20:5]</span></span><span class=\"content\">the wicked exult?</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.94.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.94.4\"><span class=\"label\">4</span><span class=\"content\">They pour out their </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 31:18; 1 Sam. 2:3; [Jude 15] </span></span><span class=\"content\">arrogant words;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.94.4\"><span class=\"content\">all </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 92:7, 9; 125:5</span></span><span class=\"content\">the evildoers boast.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.94.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.94.5\"><span class=\"label\">5</span><span class=\"content\">They </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Prov. 22:22; Isa. 3:15]</span></span><span class=\"content\">crush your people, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.94.5\"><span class=\"content\">and afflict your heritage.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.94.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.94.6\"><span class=\"label\">6</span><span class=\"content\">They kill </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 10:2]</span></span><span class=\"content\">the widow and the sojourner,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.94.6\"><span class=\"content\">and murder </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 10:2]</span></span><span class=\"content\">the fatherless;</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.94.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.94.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Job 22:13  </span></span><span class=\"content\">and they say, &#8220;The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> does not see;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.94.7\"><span class=\"content\">the God of Jacob does not perceive.&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.94.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.94.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 49:10  </span></span><span class=\"content\">Understand, O dullest of the people!</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.94.8\"><span class=\"content\">Fools, when will you be wise?</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PSA.94.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PSA.94.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ex. 4:11; Prov. 20:12]  </span></span><span class=\"content\">He who planted the ear, does he not hear?</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.94.9\"><span class=\"content\">He who formed the eye, does he not see?</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.94.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PSA.94.10\"><span class=\"label\">10</span><span class=\"content\">He who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Job 12:23] </span></span><span class=\"content\">disciplines the nations, does he not rebuke?</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PSA.94.10\"><span class=\"content\">He who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Job 35:11</span></span><span class=\"content\">teaches man knowledge&#8212;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PSA.94.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PSA.94.11\"><span class=\"label\">11</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    Cited 1 Cor. 3:20   </span></span><span class=\"content\">the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">&#8212;knows the thoughts of man,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.94.11\"><span class=\"content\">that they are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 30:5, 11]</span></span><span class=\"content\">but a breath.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">94:11 </span><span class=\"ft\">Septuagint </span><span class=\"fq\">they are futile</span></span></span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.94.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PSA.94.12\"><span class=\"label\">12</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Prov. 3:11, 12; Heb. 12:5, 6; See Job 5:17   </span></span><span class=\"content\">Blessed is the man whom you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 8:5; 1 Cor. 11:32</span></span><span class=\"content\">discipline, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.94.12\"><span class=\"content\">and whom you teach out of your law,</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.94.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PSA.94.13\"><span class=\"label\">13</span><span class=\"content\">to give him </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 34:29 </span></span><span class=\"content\">rest from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 49:5 </span></span><span class=\"content\">days of trouble,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.94.13\"><span class=\"content\">until </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 55:23</span></span><span class=\"content\">a pit is dug for the wicked.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PSA.94.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PSA.94.14\"><span class=\"label\">14</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        1 Sam. 12:22; Rom. 11:2   </span></span><span class=\"content\">For the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> will not forsake his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 32:9</span></span><span class=\"content\">people;</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.94.14\"><span class=\"content\">he will not abandon his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 32:9</span></span><span class=\"content\">heritage;</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.94.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PSA.94.15\"><span class=\"label\">15</span><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 42:3] </span></span><span class=\"content\">justice will return to the righteous,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PSA.94.15\"><span class=\"content\">and all the upright in heart will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Sam. 12:14; 1 Kgs. 14:8</span></span><span class=\"content\">follow it.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PSA.94.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PSA.94.16\"><span class=\"label\">16</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 12:5  </span></span><span class=\"content\">Who rises up for me against the wicked?</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PSA.94.16\"><span class=\"content\">Who stands up for me against evildoers?</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PSA.94.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PSA.94.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 124:1, 2   </span></span><span class=\"content\">If the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> had not been my help,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PSA.94.17\"><span class=\"content\">my soul would soon have lived in the land of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 31:17</span></span><span class=\"content\">silence.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PSA.94.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PSA.94.18\"><span class=\"label\">18</span><span class=\"content\">When I thought, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 38:16; [Ps. 73:2] </span></span><span class=\"content\">&#8220;My foot slips,&#8221;</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PSA.94.18\"><span class=\"content\">your steadfast love, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 20:2]</span></span><span class=\"content\">held me up.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"PSA.94.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"PSA.94.19\"><span class=\"label\">19</span><span class=\"content\">When the cares of my heart are many,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"PSA.94.19\"><span class=\"content\">your consolations cheer my soul.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"PSA.94.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"PSA.94.20\"><span class=\"label\">20</span><span class=\"content\">Can </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Amos 6:3] </span></span><span class=\"content\">wicked rulers be allied with you,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"PSA.94.20\"><span class=\"content\">those who frame</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">94:20 </span><span class=\"ft\">Or </span><span class=\"fq\">fashion</span></span></span><span class=\"content\"> injustice by </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 50:16; 58:2; Isa. 10:1</span></span><span class=\"content\">statute?</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"PSA.94.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"PSA.94.21\"><span class=\"label\">21</span><span class=\"content\">They </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Matt. 27:1 </span></span><span class=\"content\">band together against the life of the righteous</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"PSA.94.21\"><span class=\"content\">and condemn </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Matt. 27:4</span></span><span class=\"content\">the innocent to death.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">94:21 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">condemn innocent blood</span></span></span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"PSA.94.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"PSA.94.22\"><span class=\"label\">22</span><span class=\"content\">But the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> has become my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 9:9 </span></span><span class=\"content\">stronghold,</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"PSA.94.22\"><span class=\"content\">and my God </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 18:2 </span></span><span class=\"content\">the rock of my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 14:6</span></span><span class=\"content\">refuge.</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"PSA.94.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"PSA.94.23\"><span class=\"label\">23</span><span class=\"content\">He will bring back on them </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 7:16; 34:21; [Prov. 2:22] </span></span><span class=\"content\">their iniquity</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"PSA.94.23\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 92:9]</span></span><span class=\"content\">wipe them out for their wickedness;</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"PSA.94.23\"><span class=\"content\">the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> our God will wipe them out.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PSA.95"], "human": "Psalm 95", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PSA.93"], "human": "Psalm 93", "toc": true, "version_id": 59}, "reference": {"usfm": ["PSA.94"], "human": "Psalm 94", "version_id": 59}}, "usfm": "PSA.94.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News