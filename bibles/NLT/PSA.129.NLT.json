{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.129.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/129-159612c717a04acf382d25fbc1a6f924.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/129-159612c717a04acf382d25fbc1a6f924.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch129\" data-usfm=\"PSA.129\">\n            <div class=\"label\">129</div><div class=\"s1\"><span class=\"heading\">They Have Afflicted Me from My Youth</span></div><div class=\"d\"><span class=\"content\">A Song of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See Ps. 120, title]</span></span><span class=\"content\">Ascents.</span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.129.1\"><span class=\"label\">1</span><span class=\"content\">&#8220;Greatly</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">129:1 </span><span class=\"ft\">Or </span><span class=\"fq\">Often</span><span class=\"ft\">; also verse 2</span></span></span><span class=\"content\"> have they </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ex. 1:14; Judg. 3:8, 14; 4:3; 6:2; 10:8] </span></span><span class=\"content\">afflicted me </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 47:12; Jer. 2:2; 22:21; Hos. 2:15 </span></span><span class=\"content\">from my youth&#8221;&#8212;</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.129.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 124:1\n        </span></span><span class=\"content\">let Israel now say&#8212;</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.129.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.129.2\"><span class=\"label\">2</span><span class=\"content\">&#8220;Greatly have they </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 1 above] </span></span><span class=\"content\">afflicted me </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 1 above] </span></span><span class=\"content\">from my youth,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.129.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [2 Cor. 4:8-10]  </span></span><span class=\"content\">yet they have not prevailed against me.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.129.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.129.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Mic. 3:12   </span></span><span class=\"content\">The plowers plowed </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 50:6; 51:23]</span></span><span class=\"content\">upon my back;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.129.3\"><span class=\"content\">they made long their furrows.&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.129.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.129.4\"><span class=\"label\">4</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is righteous;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.129.4\"><span class=\"content\">he has cut </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 2:3</span></span><span class=\"content\">the cords of the wicked.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.129.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.129.5\"><span class=\"label\">5</span><span class=\"content\">May all who hate Zion</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.129.5\"><span class=\"content\">be </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 35:4</span></span><span class=\"content\">put to shame and turned backward!</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.129.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.129.6\"><span class=\"label\">6</span><span class=\"content\">Let them be like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Kgs. 19:26; Isa. 37:27 </span></span><span class=\"content\">the grass on the housetops,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.129.6\"><span class=\"content\">which </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 37:2; Job 8:12</span></span><span class=\"content\">withers before it grows up,</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.129.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.129.7\"><span class=\"label\">7</span><span class=\"content\">with which the reaper does not fill his hand</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.129.7\"><span class=\"content\">nor the binder of sheaves his arms,</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.129.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.129.8\"><span class=\"label\">8</span><span class=\"content\">nor do those who pass by say,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.129.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ruth 2:4   </span></span><span class=\"content\">&#8220;The blessing of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> be upon you!</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.129.8\"><span class=\"content\">We </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 118:26</span></span><span class=\"content\">bless you in the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!&#8221;</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PSA.130"], "human": "Psalm 130", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PSA.128"],