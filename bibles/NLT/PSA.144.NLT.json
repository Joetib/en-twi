{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.144.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/144-5e4f2841d96f53aed4b385c98fd1dcfc.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/144-5e4f2841d96f53aed4b385c98fd1dcfc.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch144\" data-usfm=\"PSA.144\">\n            <div class=\"label\">144</div><div class=\"s1\"><span class=\"heading\">My Rock and My Fortress</span></div><div class=\"d\"><span class=\"content\">Of David.</span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.144.1\"><span class=\"label\">1</span><span class=\"content\">Blessed be the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 18:2, 31, 46 </span></span><span class=\"content\">rock,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.144.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 18:34\n        </span></span><span class=\"content\">who trains my hands for war,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.144.1\"><span class=\"content\">and my fingers for battle;</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.144.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.144.2\"><span class=\"label\">2</span><span class=\"content\">he is my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 59:10, 17; Jonah 2:8] </span></span><span class=\"content\">steadfast love and my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 18:2; 91:2 </span></span><span class=\"content\">fortress,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.144.2\"><span class=\"content\">my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 18:2; 59:9 </span></span><span class=\"content\">stronghold and my deliverer,</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.144.2\"><span class=\"content\">my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 7:10; 18:2 </span></span><span class=\"content\">shield and he in whom I take refuge,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.144.2\"><span class=\"content\">who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 18:47</span></span><span class=\"content\">subdues peoples</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">144:2 </span><span class=\"ft\">Many Hebrew manuscripts, Dead Sea Scroll, Jerome, Syriac, Aquila; most Hebrew manuscripts </span><span class=\"fq\">subdues my people</span></span></span><span class=\"content\"> under me.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.144.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.144.3\"><span class=\"label\">3</span><span class=\"content\">O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 8:4 </span></span><span class=\"content\">what is man that you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 31:7</span></span><span class=\"content\">regard him,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.144.3\"><span class=\"content\">or the son of man that you think of him?</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.144.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.144.4\"><span class=\"label\">4</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 39:5   </span></span><span class=\"content\">Man is like a breath;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.144.4\"><span class=\"content\">his days are like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 102:11; 109:23 </span></span><span class=\"content\">a passing </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 8:9</span></span><span class=\"content\">shadow.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.144.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.144.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 18:9; [Isa. 64:1]   </span></span><span class=\"content\">Bow your heavens, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, and come down!</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.144.5\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 104:32  </span></span><span class=\"content\">Touch the mountains so that they smoke!</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.144.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.144.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 18:14  </span></span><span class=\"content\">Flash forth the lightning and scatter them;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.144.6\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 18:14  </span></span><span class=\"content\">send out your arrows and rout them!</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.144.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.144.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 18:16   </span></span><span class=\"content\">Stretch out your hand from on high;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.144.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 69:14   </span></span><span class=\"content\">rescue me and deliver me from the many waters,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.144.7\"><span class=\"content\">from the hand </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 18:44, 45</span></span><span class=\"content\">of foreigners,</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.144.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.144.8\"><span class=\"label\">8</span><span class=\"content\">whose mouths speak </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 12:2; 41:6 </span></span><span class=\"content\">lies</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.144.8\"><span class=\"content\">and whose right hand is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 106:26; Gen. 14:22; Deut. 32:40; Isa. 62:8]</span></span><span class=\"content\">a right hand of falsehood.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PSA.144.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PSA.144.9\"><span class=\"label\">9</span><span class=\"content\">I will sing </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 33:2, 3</span></span><span class=\"content\">a new song to you, O God;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PSA.144.9\"><span class=\"content\">upon </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 33:2, 3</span></span><span class=\"content\">a ten-stringed harp I will play to you,</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.144.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PSA.144.10\"><span class=\"label\">10</span><span class=\"content\">who gives victory to kings,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PSA.144.10\"><span class=\"content\">who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 18:50</span></span><span class=\"content\">rescues David his servant from the cruel sword.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PSA.144.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PSA.144.11\"><span class=\"label\">11</span><span class=\"content\">Rescue me and deliver me</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.144.11\"><span class=\"content\">from the hand </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 7 above] </span></span><span class=\"content\">of foreigners,</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.144.11\"><span class=\"content\">whose mouths speak </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 8 above]</span></span><span class=\"content\">lies</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.144.11\"><span class=\"content\">and whose right hand is a right hand of falsehood.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.144.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PSA.144.12\"><span class=\"label\">12</span><span class=\"content\">May our sons in their youth</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.144.12\"><span class=\"content\">be like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 128:3] </span></span><span class=\"content\">plants full grown,</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.144.12\"><span class=\"content\">our daughters like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Zech. 9:15]</span></span><span class=\"content\">corner pillars</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.144.12\"><span class=\"content\">cut for the structure of a palace;</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.144.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PSA.144.13\"><span class=\"label\">13</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Joel 2:24]   </span></span><span class=\"content\">may our granaries be full,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.144.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 30:23]  </span></span><span class=\"content\">providing all kinds of produce;</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PSA.144.13\"><span class=\"content\">may our sheep bring forth thousands</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.144.13\"><span class=\"content\">and ten thousands in our fields;</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PSA.144.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PSA.144.14\"><span class=\"label\">14</span><span class=\"content\">may our cattle be heavy with young,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.144.14\"><span class=\"content\">suffering no mishap or failure in bearing;</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">144:14 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">with no breaking in or going out</span></span></span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.144.14\"><span class=\"content\">may there be no </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 24:11; Jer. 14:2; 46:12]</span></span><span class=\"content\">cry of distress in our streets!</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.144.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PSA.144.15\"><span class=\"label\">15</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Deut. 33:29   </span></span><span class=\"content\">Blessed are the people to whom such blessings fall!</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PSA.144.15\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 33:12; 146:5  </span></span><span class=\"content\">Blessed are the people whose God is the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PSA.145"], "human": "Psalm 145", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PSA.143"], "human": "Psalm 143", "toc": true, "version_id": 59}, "reference": {"usfm": ["PSA.144"], "human": "Psalm 144", "version_id": 59}}, "usfm": "PSA.144.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": 