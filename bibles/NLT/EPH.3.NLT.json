{"pageProps": {"params": {"versionId": "59", "usfm": "EPH.3.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/EPH/3-90334de664deca5eb6ff2d24e7ab883b.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/EPH/3-90334de664deca5eb6ff2d24e7ab883b.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}, {"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1668/32k/EPH/3-0a6d9a7461e53a2de141fb29702a8551.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1668/m4a/32k/EPH/3-0a6d9a7461e53a2de141fb29702a8551.m3u8?version_id=59"}, "id": 1668, "version_id": 59, "title": "Living Water Bible - ESV Music Project by Lutheran Bible Translators", "timing_available": false, "dramatized": true, "default": false}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkEPH\">\n        <div class=\"chapter ch3\" data-usfm=\"EPH.3\">\n            <div class=\"label\">3</div><div class=\"s1\"><span class=\"heading\">The Mystery of the Gospel Revealed</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"EPH.3.1\"><span class=\"label\">1</span><span class=\"content\">For this reason I, Paul, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:1; Acts 23:18; Phil. 1:7; [ch. 6:20] </span></span><span class=\"content\">a prisoner of Christ Jesus </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 13; Col. 1:24</span></span><span class=\"content\">on behalf of you Gentiles&#8212; </span></span><span class=\"verse v2\" data-usfm=\"EPH.3.2\"><span class=\"label\">2</span><span class=\"content\">assuming that you have heard of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:10; Col. 1:25; 1 Tim. 1:4 </span></span><span class=\"content\">the stewardship of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 7; ch. 4:7; See Acts 11:23; Rom. 1:5</span></span><span class=\"content\">God&#8217;s grace that was given to me for you, </span></span><span class=\"verse v3\" data-usfm=\"EPH.3.3\"><span class=\"label\">3</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Acts 22:17, 21; 26:16-18 </span></span><span class=\"content\">how the mystery was made known to me </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Dan. 2:29]; See Rom. 16:25; 2 Cor. 12:1 </span></span><span class=\"content\">by revelation, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 1:9, 10]</span></span><span class=\"content\">as I have written briefly. </span></span><span class=\"verse v4\" data-usfm=\"EPH.3.4\"><span class=\"label\">4</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Cor. 11:6] </span></span><span class=\"content\">When you read this, you can perceive my insight into </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 4:3</span></span><span class=\"content\">the mystery of Christ, </span></span><span class=\"verse v5\" data-usfm=\"EPH.3.5\"><span class=\"label\">5</span><span class=\"content\">which was not made known to the sons of men in other generations as it has now been revealed to his holy apostles and prophets by the Spirit. </span></span><span class=\"verse v6\" data-usfm=\"EPH.3.6\"><span class=\"label\">6</span><span class=\"content\">This mystery is</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">3:6 </span><span class=\"ft\">The words </span><span class=\"fq\">This mystery is </span><span class=\"ft\">are inferred from verse 4</span></span></span><span class=\"content\"> that the Gentiles are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Gal. 3:29 </span></span><span class=\"content\">fellow heirs, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:16 </span></span><span class=\"content\">members of the same body, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 5:7</span></span><span class=\"content\">partakers of the promise in Christ Jesus through the gospel.</span></span></div><div class=\"p\"><span class=\"verse v6\" data-usfm=\"EPH.3.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"EPH.3.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Col. 1:23, 25   </span></span><span class=\"content\">Of this gospel I was made </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 2 Cor. 3:6 </span></span><span class=\"content\">a minister according to the gift of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ver. 2 </span></span><span class=\"content\">God&#8217;s grace, which was given me </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 20]; See ch. 1:19</span></span><span class=\"content\">by the working of his power. </span></span><span class=\"verse v8\" data-usfm=\"EPH.3.8\"><span class=\"label\">8</span><span class=\"content\">To me, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Cor. 15:9 </span></span><span class=\"content\">though I am the very least of all the saints, this grace was given, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Acts 9:15 </span></span><span class=\"content\">to preach to the Gentiles the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Job 5:9; Rom. 11:33] </span></span><span class=\"content\">unsearchable </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:18; Rom. 2:4</span></span><span class=\"content\">riches of Christ, </span></span><span class=\"verse v9\" data-usfm=\"EPH.3.9\"><span class=\"label\">9</span><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ver. 2, 3 </span></span><span class=\"content\">to bring to light for everyone what is the plan of the mystery </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 1:26 </span></span><span class=\"content\">hidden for ages in</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">3:9 </span><span class=\"ft\">Or </span><span class=\"fq\">by</span></span></span><span class=\"content\"> God, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Rev. 4:11; [ch. 2:10]</span></span><span class=\"content\">who created all things, </span></span><span class=\"verse v10\" data-usfm=\"EPH.3.10\"><span class=\"label\">10</span><span class=\"content\">so that through the church the manifold </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Rom. 11:33 </span></span><span class=\"content\">wisdom of God </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Pet. 1:12] </span></span><span class=\"content\">might now be made known to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:21; [ch. 6:12] </span></span><span class=\"content\">the rulers and authorities </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:3</span></span><span class=\"content\">in the heavenly places. </span></span><span class=\"verse v11\" data-usfm=\"EPH.3.11\"><span class=\"label\">11</span><span class=\"content\">This was </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:11</span></span><span class=\"content\">according to the eternal purpose that he has realized in Christ Jesus our Lord, </span></span><span class=\"verse v12\" data-usfm=\"EPH.3.12\"><span class=\"label\">12</span><span class=\"content\">in whom we have </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Heb. 4:16; 10:19 </span></span><span class=\"content\">boldness and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 2:18 </span></span><span class=\"content\">access with </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Cor. 3:4 </span></span><span class=\"content\">confidence through our </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Mark 11:22; Phil. 3:9</span></span><span class=\"content\">faith in him. </span></span><span class=\"verse v13\" data-usfm=\"EPH.3.13\"><span class=\"label\">13</span><span class=\"content\">So I ask you not to lose heart over what I am suffering </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 1 </span></span><span class=\"content\">for you, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Cor. 1:6]</span></span><span class=\"content\">which is your glory.</span></span></div><div class=\"s1\"><span class=\"heading\">Prayer for Spiritual Strength</span></div><div class=\"p\"><span class=\"verse v13\" data-usfm=\"EPH.3.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"EPH.3.14\"><span class=\"label\">14</span><span class=\"content\">For this reason I bow my knees before the Father, </span></span><span class=\"verse v15\" data-usfm=\"EPH.3.15\"><span class=\"label\">15</span><span class=\"content\">from whom </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:10, 21</span></span><span class=\"content\">every family</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">3:15 </span><span class=\"ft\">Or </span><span class=\"fq\">from whom all fatherhood</span><span class=\"ft\">; the Greek word </span><span class=\"fq\">patria </span><span class=\"ft\">in verse 15 is closely related to the word for </span><span class=\"fq\">Father </span><span class=\"ft\">in verse 14</span></span></span><span class=\"content\"> in heaven and on earth is named, </span></span><span class=\"verse v16\" data-usfm=\"EPH.3.16\"><span class=\"label\">16</span><span class=\"content\">that according to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ver. 8 </span></span><span class=\"content\">the riches of his glory </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Cor. 16:13; [ch. 6:10; Phil. 4:13; Col. 1:11] </span></span><span class=\"content\">he may grant you to be strengthened with power through his Spirit </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Rom. 7:22</span></span><span class=\"content\">in your inner being, </span></span><span class=\"verse v17\" data-usfm=\"EPH.3.17\"><span class=\"label\">17</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 2:22] </span></span><span class=\"content\">so that Christ may dwell in your hearts through faith&#8212;that you, being </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 2:7 </span></span><span class=\"content\">rooted and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 1:23</span></span><span class=\"content\">grounded in love, </span></span><span class=\"verse v18\" data-usfm=\"EPH.3.18\"><span class=\"label\">18</span><span class=\"content\">may have strength to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[John 1:5] </span></span><span class=\"content\">comprehend with all the saints what is the breadth and length and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Rom. 8:39; [Job 11:8, 9]</span></span><span class=\"content\">height and depth, </span></span><span class=\"verse v19\" data-usfm=\"EPH.3.19\"><span class=\"label\">19</span><span class=\"content\">and to know the love of Christ </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Phil. 4:7] </span></span><span class=\"content\">that surpasses knowledge, that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 2:10 </span></span><span class=\"content\">you may be filled with all </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:23</span></span><span class=\"content\">the fullness of God.</span></span></div><div class=\"p\"><span class=\"verse v19\" data-usfm=\"EPH.3.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"EPH.3.20\"><span class=\"label\">20</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Rom. 16:25; Jude 24   </span></span><span class=\"content\">Now to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Cor. 9:8] </span></span><span class=\"content\">him who is able to do far more abundantly than all that we ask or think, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 7]</span></span><span class=\"content\">according to the power at work within us, </span></span><span class=\"verse v21\" data-usfm=\"EPH.3.21\"><span class=\"label\">21</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Rom. 11:36</span></span><span class=\"content\">to him be glory in the church and in Christ Jesus throughout all generations, forever and ever. Amen.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["EPH.4"], "human": "Ephesians 4", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["EPH.2"], "human": "Ephesians 2", "toc": true, "version_id": 59}, "reference": {"usfm": ["EPH.3"], "human": "Ephesians 3", "version_id": 59}}, "usfm": "EPH.3.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</