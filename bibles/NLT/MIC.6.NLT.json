{"pageProps": {"params": {"versionId": "59", "usfm": "MIC.6.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/MIC/6-b97d5d6cc0eb97c5839bd928998dbec6.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/MIC/6-b97d5d6cc0eb97c5839bd928998dbec6.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkMIC\">\n        <div class=\"chapter ch6\" data-usfm=\"MIC.6\">\n            <div class=\"label\">6</div><div class=\"s1\"><span class=\"heading\">The Indictment of the </span><span class=\"nd\"><span class=\"heading\">Lord</span></span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"MIC.6.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 1:2  </span></span><span class=\"content\">Hear what the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> says:</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"MIC.6.1\"><span class=\"content\">Arise, plead your case before the mountains,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"MIC.6.1\"><span class=\"content\">and let the hills hear your voice.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"MIC.6.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"MIC.6.2\"><span class=\"label\">2</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 50:1, 4; Ezek. 36:4   </span></span><span class=\"content\">Hear, you mountains, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 1:18; See Hos. 4:1</span></span><span class=\"content\">the indictment of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"MIC.6.2\"><span class=\"content\">and you enduring foundations of the earth,</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"MIC.6.2\"><span class=\"content\">for the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> has an indictment against his people,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"MIC.6.2\"><span class=\"content\">and he will contend with Israel.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"MIC.6.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"MIC.6.3\"><span class=\"label\">3</span><span class=\"content\">&#8220;O my people, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 5:4; [Jer. 2:5, 31] </span></span><span class=\"content\">what have I done to you?</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"MIC.6.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 43:22, 23; [Mal. 1:13]  </span></span><span class=\"content\">How have I wearied you? Answer me!</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"MIC.6.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"MIC.6.4\"><span class=\"label\">4</span><span class=\"content\">For </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 12:51; Hos. 12:13; Amos 2:10 </span></span><span class=\"content\">I brought you up from the land of Egypt</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"MIC.6.4\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Sam. 7:23 </span></span><span class=\"content\">redeemed you from the house of slavery,</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"MIC.6.4\"><span class=\"content\">and I sent before you Moses,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"MIC.6.4\"><span class=\"content\">Aaron, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 15:20; Num. 12:1, 2</span></span><span class=\"content\">Miriam.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"MIC.6.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"MIC.6.5\"><span class=\"label\">5</span><span class=\"content\">O my people, remember </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Num. 22:5 </span></span><span class=\"content\">what Balak king of Moab devised,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"MIC.6.5\"><span class=\"content\">and what Balaam the son of Beor answered him,</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"MIC.6.5\"><span class=\"content\">and what happened from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Num. 25:1 </span></span><span class=\"content\">Shittim to Gilgal,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"MIC.6.5\"><span class=\"content\">that you may know </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Judg. 5:11]</span></span><span class=\"content\">the righteous acts of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.&#8221;</span></span></div><div class=\"s1\"><span class=\"heading\">What Does the </span><span class=\"nd\"><span class=\"heading\">Lord</span></span><span class=\"heading\"> Require?</span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"MIC.6.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"MIC.6.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Hos. 5:6; Heb. 10:4]   </span></span><span class=\"content\">&#8220;With what shall I come before the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"MIC.6.6\"><span class=\"content\">and bow myself before </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 57:15</span></span><span class=\"content\">God on high?</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"MIC.6.6\"><span class=\"content\">Shall I come before him with burnt offerings,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"MIC.6.6\"><span class=\"content\">with calves a year old?</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"MIC.6.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"MIC.6.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See 1 Sam. 15:22   </span></span><span class=\"content\">Will the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> be pleased with</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:7 </span><span class=\"ft\">Or </span><span class=\"fq\">Will the </span><span class=\"ft\"><span class=\"bdit\">Lord</span>  </span><span class=\"fq\">accept</span></span></span><span class=\"content\"> thousands of rams,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"MIC.6.7\"><span class=\"content\">with ten thousands of rivers of oil?</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"MIC.6.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        2 Kgs. 3:27; 16:3; 21:6; 23:10; [Lev. 18:21]  </span></span><span class=\"content\">Shall I give my firstborn for my transgression,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"MIC.6.7\"><span class=\"content\">the fruit of my body for the sin of my soul?&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"MIC.6.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"MIC.6.8\"><span class=\"label\">8</span><span class=\"content\">He has told you, O man, what is good;</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"MIC.6.8\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Deut. 10:12] </span></span><span class=\"content\">what does the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> require of you</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"MIC.6.8\"><span class=\"content\">but to do justice, and to love kindness,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:8 </span><span class=\"ft\">Or </span><span class=\"fq\">steadfast love</span></span></span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"MIC.6.8\"><span class=\"content\">and to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 5:22]</span></span><span class=\"content\">walk humbly with your God?</span></span></div><div class=\"s1\"><span class=\"heading\">Destruction of the Wicked</span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"MIC.6.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"MIC.6.9\"><span class=\"label\">9</span><span class=\"content\">The voice of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> cries to the city&#8212;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"MIC.6.9\"><span class=\"content\">and it is sound wisdom to fear </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 30:27 </span></span><span class=\"content\">your name:</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"MIC.6.9\"><span class=\"content\">&#8220;Hear of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 10:5; 30:32</span></span><span class=\"content\">the rod and of him who appointed it!</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:9 </span><span class=\"ft\">The meaning of the Hebrew is uncertain</span></span></span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"MIC.6.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"MIC.6.10\"><span class=\"label\">10</span><span class=\"content\">Can I forget any longer the treasures</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:10 </span><span class=\"ft\">Or </span><span class=\"fq\">Are there still treasures</span></span></span><span class=\"content\"> of wickedness in the house of the wicked,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"MIC.6.10\"><span class=\"content\">and the scant measure that is accursed?</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"MIC.6.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"MIC.6.11\"><span class=\"label\">11</span><span class=\"content\">Shall I acquit the man </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Hos. 12:7</span></span><span class=\"content\">with wicked scales</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"MIC.6.11\"><span class=\"content\">and with a bag of deceitful weights?</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"MIC.6.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"MIC.6.12\"><span class=\"label\">12</span><span class=\"content\">Your</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:12 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">whose</span></span></span><span class=\"content\"> rich men are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Amos 3:10; Hab. 1:2, 3 </span></span><span class=\"content\">full of violence;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"MIC.6.12\"><span class=\"content\">your inhabitants </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Hos. 7:13 </span></span><span class=\"content\">speak lies,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"MIC.6.12\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jer. 9:8</span></span><span class=\"content\">their tongue is deceitful in their mouth.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"MIC.6.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"MIC.6.13\"><span class=\"label\">13</span><span class=\"content\">Therefore I strike you with a grievous blow,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"MIC.6.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 7:13  </span></span><span class=\"content\">making you desolate because of your sins.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"MIC.6.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"MIC.6.14\"><span class=\"label\">14</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Hos. 4:10\n        </span></span><span class=\"content\">You shall eat, but not be satisfied,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"MIC.6.14\"><span class=\"content\">and there shall be hunger within you;</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"MIC.6.14\"><span class=\"content\">you shall put away, but not preserve,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"MIC.6.14\"><span class=\"content\">and what you preserve I will give to the sword.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"MIC.6.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"MIC.6.15\"><span class=\"label\">15</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Zeph. 1:13; Hag. 1:6]  </span></span><span class=\"content\">You shall sow, but not reap;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"MIC.6.15\"><span class=\"content\">you shall tread olives, but not anoint yourselves with oil;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"MIC.6.15\"><span class=\"content\">you shall tread grapes, but not drink wine.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"MIC.6.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"MIC.6.16\"><span class=\"label\">16</span><span class=\"content\">For you have kept the statutes of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Kgs. 16:25, 26; [ch. 1:13] </span></span><span class=\"content\">Omri,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:16 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">For the statutes of Omri are kept</span></span></span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"MIC.6.16\"><span class=\"content\">and all the works of the house of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Kgs. 16:30-33; 21:25, 26 </span></span><span class=\"content\">Ahab;</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"MIC.6.16\"><span class=\"content\">and you have walked in their counsels,</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"MIC.6.16\"><span class=\"content\">that I may make you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 2 Chr. 29:8 </span></span><span class=\"content\">a desolation, and your</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:16 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">its</span></span></span><span class=\"content\"> inhabitants </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 2 Chr. 29:8 </span></span><span class=\"content\">a hissing;</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"MIC.6.16\"><span class=\"content\">so you shall bear </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 25:8</span></span><span class=\"content\">the scorn of my people.&#8221;</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["MIC.7"], "human": "Micah 7", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["MIC.5"], "human": "Micah 5", "toc": true, "version_id": 59}, "reference": {"usfm": ["MIC.6"], "human": "Micah 6", "version_id": 59}}, "usfm": "MIC.6.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p> \r\n<p>Sign up to receive news and updates about the ESV:</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers. \r\nSign up to receive news and updates about the ESV:"}, "reader_footer_url": "https://mailchi.mp/23d38157d688/dfka2d5wyd"}, "_nextI18Next": {"initialI18nStore": {"en": {"common":