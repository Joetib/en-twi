{"pageProps": {"params": {"versionId": "59", "usfm": "ECC.7.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/ECC/7-8d5c6564bfe9b948cd9dfc878ba84a17.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/ECC/7-8d5c6564bfe9b948cd9dfc878ba84a17.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkECC\">\n        <div class=\"chapter ch7\" data-usfm=\"ECC.7\">\n            <div class=\"label\">7</div><div class=\"s1\"><span class=\"heading\">The Contrast of Wisdom and Folly</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"ECC.7.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Prov. 22:1; [Song 1:3]   </span></span><span class=\"content\">A good name is better than precious ointment,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"ECC.7.1\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:2</span></span><span class=\"content\">the day of death than the day of birth.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"ECC.7.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"ECC.7.2\"><span class=\"label\">2</span><span class=\"content\">It is better to go to the house of mourning</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ECC.7.2\"><span class=\"content\">than to go to the house of feasting,</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ECC.7.2\"><span class=\"content\">for this is the end of all mankind,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ECC.7.2\"><span class=\"content\">and the living will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 90:12]</span></span><span class=\"content\">lay it to heart.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ECC.7.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"ECC.7.3\"><span class=\"label\">3</span><span class=\"content\">Sorrow is better than laughter,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"ECC.7.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [2 Cor. 7:10]  </span></span><span class=\"content\">for by sadness of face the heart is made glad.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"ECC.7.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"ECC.7.4\"><span class=\"label\">4</span><span class=\"content\">The heart of the wise is in the house of mourning,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"ECC.7.4\"><span class=\"content\">but the heart of fools is in the house of mirth.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"ECC.7.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"ECC.7.5\"><span class=\"label\">5</span><span class=\"content\">It is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Prov. 13:18; 15:31, 32; [Ps. 141:5]</span></span><span class=\"content\">better for a man to hear the rebuke of the wise</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ECC.7.5\"><span class=\"content\">than to hear the song of fools.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"ECC.7.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"ECC.7.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Joel 2:5]   </span></span><span class=\"content\">For as the crackling of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 58:9; 118:12]</span></span><span class=\"content\">thorns under a pot,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ECC.7.6\"><span class=\"content\">so is the laughter of the fools;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ECC.7.6\"><span class=\"content\">this also is vanity.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">7:6 </span><span class=\"ft\">The Hebrew term </span><span class=\"fq\">hebel </span><span class=\"ft\">can refer to a &#8220;vapor&#8221; or &#8220;mere breath&#8221; (see note on 1:2)</span></span></span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"ECC.7.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"ECC.7.7\"><span class=\"label\">7</span><span class=\"content\">Surely </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 4:1] </span></span><span class=\"content\">oppression drives the wise into madness,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ECC.7.7\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 16:19; See Prov. 17:8</span></span><span class=\"content\">a bribe corrupts the heart.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ECC.7.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"ECC.7.8\"><span class=\"label\">8</span><span class=\"content\">Better is the end of a thing than its beginning,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"ECC.7.8\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Prov. 14:29</span></span><span class=\"content\">the patient in spirit is better than the proud in spirit.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"ECC.7.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"ECC.7.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Prov. 14:17; 16:32; James 1:19]   </span></span><span class=\"content\">Be not quick in your spirit to become angry,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"ECC.7.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Eph. 4:26]  </span></span><span class=\"content\">for anger lodges in the heart</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">7:9 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">in the bosom</span></span></span><span class=\"content\"> of fools.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"ECC.7.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"ECC.7.10\"><span class=\"label\">10</span><span class=\"content\">Say not, &#8220;Why were the former days better than these?&#8221;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"ECC.7.10\"><span class=\"content\">For it is not from wisdom that you ask this.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"ECC.7.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"ECC.7.11\"><span class=\"label\">11</span><span class=\"content\">Wisdom is good with an inheritance,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"ECC.7.11\"><span class=\"content\">an advantage to those who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 6:5; 11:7</span></span><span class=\"content\">see the sun.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"ECC.7.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"ECC.7.12\"><span class=\"label\">12</span><span class=\"content\">For the protection of wisdom is like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 10:19] </span></span><span class=\"content\">the protection of money,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"ECC.7.12\"><span class=\"content\">and the advantage of knowledge is that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Prov. 3:18</span></span><span class=\"content\">wisdom preserves the life of him who has it.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"ECC.7.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"ECC.7.13\"><span class=\"label\">13</span><span class=\"content\">Consider </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 3:11] </span></span><span class=\"content\">the work of God:</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"ECC.7.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 1:15; Job 12:14; Isa. 14:27]  </span></span><span class=\"content\">who can make straight what he has made crooked?</span></span></div><div class=\"b\"></div><div class=\"p\"><span class=\"verse v13\" data-usfm=\"ECC.7.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"ECC.7.14\"><span class=\"label\">14</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 3:4, 22; Deut. 28:47]   </span></span><span class=\"content\">In the day of prosperity be joyful, and in the day of adversity consider: God has made the one as well as the other, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 3:22; 6:12]</span></span><span class=\"content\">so that man may not find out anything that will be after him.</span></span></div><div class=\"p\"><span class=\"verse v14\" data-usfm=\"ECC.7.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"ECC.7.15\"><span class=\"label\">15</span><span class=\"content\">In my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 6:12; 9:9 </span></span><span class=\"content\">vain</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">7:15 </span><span class=\"ft\">The Hebrew term </span><span class=\"fq\">hebel </span><span class=\"ft\">can refer to a &#8220;vapor&#8221; or &#8220;mere breath&#8221; (see note on 1:2)</span></span></span><span class=\"content\"> life I have seen everything. There is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 8:14 </span></span><span class=\"content\">a righteous man who perishes in his righteousness, and there is a wicked man who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 8:12, 13</span></span><span class=\"content\">prolongs his life in his evildoing. </span></span><span class=\"verse v16\" data-usfm=\"ECC.7.16\"><span class=\"label\">16</span><span class=\"content\">Be not overly righteous, and do not </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Rom. 12:3]</span></span><span class=\"content\">make yourself too wise. Why should you destroy yourself? </span></span><span class=\"verse v17\" data-usfm=\"ECC.7.17\"><span class=\"label\">17</span><span class=\"content\">Be not overly wicked, neither be a fool. </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Prov. 10:27]; See Job 22:16</span></span><span class=\"content\">Why should you die before your time? </span></span><span class=\"verse v18\" data-usfm=\"ECC.7.18\"><span class=\"label\">18</span><span class=\"content\">It is good that you should take hold of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 17] </span></span><span class=\"content\">this, and from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 16] </span></span><span class=\"content\">that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 11:6</span></span><span class=\"content\">withhold not your hand, for the one who fears God shall come out from both of them.</span></span></div><div class=\"p\"><span class=\"verse v18\" data-usfm=\"ECC.7.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"ECC.7.19\"><span class=\"label\">19</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 9:16, 18; Prov. 21:22; 24:5  </span></span><span class=\"content\">Wisdom gives strength to the wise man more than ten rulers who are in a city.</span></span></div><div class=\"p\"><span class=\"verse v19\" data-usfm=\"ECC.7.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"ECC.7.20\"><span class=\"label\">20</span><span class=\"content\">Surely </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Kgs. 8:46</span></span><span class=\"content\">there is not a righteous man on earth who does good and never sins.</span></span></div><div class=\"p\"><span class=\"verse v20\" data-usfm=\"ECC.7.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"ECC.7.21\"><span class=\"label\">21</span><span class=\"content\">Do not take to heart all the things that people say, lest you hear </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Prov. 30:10</span></span><span class=\"content\">your servant cursing you. </span></span><span class=\"verse v22\" data-usfm=\"ECC.7.22\"><span class=\"label\">22</span><span class=\"content\">Your heart knows that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gal. 6:1]</span></span><span class=\"content\">many times you yourself have cursed others.</span></span></div><div class=\"p\"><span class=\"verse v22\" data-usfm=\"ECC.7.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"ECC.7.23\"><span class=\"label\">23</span><span class=\"content\">All this I have tested by wisdom. </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Rom. 1:22]</span></span><span class=\"content\">I said, &#8220;I will be wise,&#8221; but it was far from me. </span></span><span class=\"verse v24\" data-usfm=\"ECC.7.24\"><span class=\"label\">24</span><span class=\"content\">That which has been is far off, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Rom. 11:33] </span></span><span class=\"content\">deep, very deep; </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 28:12, 20; [1 Tim. 6:16]</span></span><span class=\"content\">who can find it out?</span></span></div><div class=\"p\"><span class=\"verse v24\" data-usfm=\"ECC.7.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"ECC.7.25\"><span class=\"label\">25</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 1:17  </span></span><span class=\"content\">I turned my heart to know and to search out and to seek wisdom and the scheme of things, and to know the wickedness of folly and the foolishness that is madness. </span></span><span class=\"verse v26\" data-usfm=\"ECC.7.26\"><span class=\"label\">26</span><span class=\"content\">And I find something more </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Prov. 5:4 </span></span><span class=\"content\">bitter than death: </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Prov. 2:16 </span></span><span class=\"content\">the woman whose heart is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Prov. 12:12; [Prov. 23:28] </span></span><span class=\"content\">snares and nets, and whose hands are fetters. He who pleases God escapes her, but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Prov. 22:14</span></span><span class=\"content\">the sinner is taken by her. </span></span><span class=\"verse v27\" data-usfm=\"ECC.7.27\"><span class=\"label\">27</span><span class=\"content\">Behold, this is what I found, says </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:1</span></span><span class=\"content\">the Preacher, while adding one thing to another to find the scheme of things&#8212; </span></span><span class=\"verse v28\" data-usfm=\"ECC.7.28\"><span class=\"label\">28</span><span class=\"content\">which my soul has sought repeatedly, but I have not found. </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 33:23; [ver. 20] </span></span><span class=\"content\">One man among a thousand I found, but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Kgs. 11:3]</span></span><span class=\"content\">a woman among all these I have not found. </span></span><span class=\"verse v29\" data-usfm=\"ECC.7.29\"><span class=\"label\">29</span><span class=\"content\">See, this alone I found, that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 1:27] </span></span><span class=\"content\">God made man upright, but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 3:6, 7]</span></span><span class=\"content\">they have sought out many schemes.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["ECC.8"], "human": "Ecclesiastes 8", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["ECC.6"], "human": "Ecclesiastes 6", "toc": true, "version_id": 59}, "reference": {"usfm": ["ECC.7"], "human": "Ecclesiastes 7", "version_id": 59}}, "usfm": "ECC.7.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": 