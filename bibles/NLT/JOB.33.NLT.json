{"pageProps": {"params": {"versionId": "59", "usfm": "JOB.33.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/JOB/33-4d5d5bfbbeacf3fdf051d84f1ccf51da.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/JOB/33-4d5d5bfbbeacf3fdf051d84f1ccf51da.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkJOB\">\n        <div class=\"chapter ch33\" data-usfm=\"JOB.33\">\n            <div class=\"label\">33</div><div class=\"s1\"><span class=\"heading\">Elihu Rebukes Job</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"JOB.33.1\"><span class=\"label\">1</span><span class=\"content\">&#8220;But now, hear my speech, O Job,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"JOB.33.1\"><span class=\"content\">and listen to all my words.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"JOB.33.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"JOB.33.2\"><span class=\"label\">2</span><span class=\"content\">Behold, I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:1</span></span><span class=\"content\">open my mouth;</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"JOB.33.2\"><span class=\"content\">the tongue in my mouth speaks.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"JOB.33.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"JOB.33.3\"><span class=\"label\">3</span><span class=\"content\">My words declare the uprightness of my heart,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"JOB.33.3\"><span class=\"content\">and what my lips know they speak sincerely.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"JOB.33.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"JOB.33.4\"><span class=\"label\">4</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 27:3   </span></span><span class=\"content\">The Spirit of God has made me,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"JOB.33.4\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 32:8; Gen. 2:7; [Ezek. 37:9; Acts 17:25]</span></span><span class=\"content\">the breath of the Almighty gives me life.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"JOB.33.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"JOB.33.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 32   </span></span><span class=\"content\">Answer me, if you can;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"JOB.33.5\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 13:18; 23:4; [Ps. 5:3]  </span></span><span class=\"content\">set your words in order before me; take your stand.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"JOB.33.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"JOB.33.6\"><span class=\"label\">6</span><span class=\"content\">Behold, I am toward God as you are;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"JOB.33.6\"><span class=\"content\">I too was pinched off from a piece of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 4:19</span></span><span class=\"content\">clay.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"JOB.33.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"JOB.33.7\"><span class=\"label\">7</span><span class=\"content\">Behold, no </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 9:34, 35; 13:21 </span></span><span class=\"content\">fear of me need terrify you;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"JOB.33.7\"><span class=\"content\">my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 23:2]</span></span><span class=\"content\">pressure will not be heavy upon you.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"JOB.33.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"JOB.33.8\"><span class=\"label\">8</span><span class=\"content\">&#8220;Surely you have spoken in my ears,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"JOB.33.8\"><span class=\"content\">and I have heard the sound of your words.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"JOB.33.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"JOB.33.9\"><span class=\"label\">9</span><span class=\"content\">You say, &#8216;I am </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 9:21; 10:7; 11:4; 12:4; 13:18; 16:17; 23:10, 11; 27:5; 29:14; 32:1; 34:5 </span></span><span class=\"content\">pure, without </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 34:6</span></span><span class=\"content\">transgression;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"JOB.33.9\"><span class=\"content\">I am clean, and there is no iniquity in me.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"JOB.33.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"JOB.33.10\"><span class=\"label\">10</span><span class=\"content\">Behold, he finds occasions against me,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"JOB.33.10\"><span class=\"content\">he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 13:24</span></span><span class=\"content\">counts me as his enemy,</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"JOB.33.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"JOB.33.11\"><span class=\"label\">11</span><span class=\"content\">he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 13:27 </span></span><span class=\"content\">puts my feet in the stocks</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"JOB.33.11\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 10:14; 14:16; 31:4</span></span><span class=\"content\">watches all my paths.&#8217;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"JOB.33.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"JOB.33.12\"><span class=\"label\">12</span><span class=\"content\">&#8220;Behold, in this you are not right. I will answer you,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"JOB.33.12\"><span class=\"content\">for God is greater than man.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"JOB.33.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"JOB.33.13\"><span class=\"label\">13</span><span class=\"content\">Why do you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 13:3; 16:21; 31:35; 40:2 </span></span><span class=\"content\">contend against him,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"JOB.33.13\"><span class=\"content\">saying, &#8216;He </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 9:12</span></span><span class=\"content\">will answer none of man&#8217;s</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:13 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">his</span></span></span><span class=\"content\"> words&#8217;?</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:13 </span><span class=\"ft\">Or </span><span class=\"fq\">He will not answer for any of his own words</span></span></span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"JOB.33.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"JOB.33.14\"><span class=\"label\">14</span><span class=\"content\">For God </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 40:5; Ps. 62:11] </span></span><span class=\"content\">speaks in one way,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"JOB.33.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 29   </span></span><span class=\"content\">and in two, though man </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Sam. 3:4, 6]</span></span><span class=\"content\">does not perceive it.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"JOB.33.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"JOB.33.15\"><span class=\"label\">15</span><span class=\"content\">In </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Num. 12:6 </span></span><span class=\"content\">a dream, in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:13 </span></span><span class=\"content\">a vision of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 17:3</span></span><span class=\"content\">the night,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"JOB.33.15\"><span class=\"content\">when </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:13 </span></span><span class=\"content\">deep sleep falls on men,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"JOB.33.15\"><span class=\"content\">while they slumber on their beds,</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"JOB.33.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"JOB.33.16\"><span class=\"label\">16</span><span class=\"content\">then he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 36:10, 15; Ps. 40:6; Isa. 50:5</span></span><span class=\"content\">opens the ears of men</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"JOB.33.16\"><span class=\"content\">and terrifies</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:16 </span><span class=\"ft\">Or </span><span class=\"fq\">seals</span></span></span><span class=\"content\"> them with warnings,</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"JOB.33.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"JOB.33.17\"><span class=\"label\">17</span><span class=\"content\">that he may turn man aside from his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 36:9</span></span><span class=\"content\">deed</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"JOB.33.17\"><span class=\"content\">and conceal pride from a man;</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"JOB.33.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"JOB.33.18\"><span class=\"label\">18</span><span class=\"content\">he keeps back his soul from the pit,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"JOB.33.18\"><span class=\"content\">his life from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 36:12</span></span><span class=\"content\">perishing by the sword.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"JOB.33.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"JOB.33.19\"><span class=\"label\">19</span><span class=\"content\">&#8220;Man is also rebuked with pain on his bed</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"JOB.33.19\"><span class=\"content\">and with continual strife in his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 30:17</span></span><span class=\"content\">bones,</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"JOB.33.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"JOB.33.20\"><span class=\"label\">20</span><span class=\"content\">so that his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 107:18 </span></span><span class=\"content\">life loathes bread,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"JOB.33.20\"><span class=\"content\">and his appetite </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Prov. 23:3</span></span><span class=\"content\">the choicest food.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"JOB.33.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"JOB.33.21\"><span class=\"label\">21</span><span class=\"content\">His flesh is so wasted away that it cannot be seen,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"JOB.33.21\"><span class=\"content\">and his bones that were not seen </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 22:17]</span></span><span class=\"content\">stick out.</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"JOB.33.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"JOB.33.22\"><span class=\"label\">22</span><span class=\"content\">His soul draws near </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 24, 28 </span></span><span class=\"content\">the pit,</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"JOB.33.22\"><span class=\"content\">and his life to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Sam. 24:16, 17; Ps. 78:49</span></span><span class=\"content\">those who bring death.</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"JOB.33.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"JOB.33.23\"><span class=\"label\">23</span><span class=\"content\">If there be for him </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 16:7; 22:11; 48:16; Ps. 34:7; Isa. 63:9; [Mal. 3:1] </span></span><span class=\"content\">an angel,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"JOB.33.23\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Gen. 42:23; Isa. 43:27   </span></span><span class=\"content\">a mediator, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Eccles. 7:28; [Song 5:10] </span></span><span class=\"content\">one of the thousand,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"JOB.33.23\"><span class=\"content\">to declare to man what is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Prov. 14:2; Ezek. 18:21, 22]</span></span><span class=\"content\">right for him,</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"JOB.33.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"JOB.33.24\"><span class=\"label\">24</span><span class=\"content\">and he is merciful to him, and says,</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"JOB.33.24\"><span class=\"content\">&#8216;Deliver him from going down into the pit;</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"JOB.33.24\"><span class=\"content\">I have found </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 36:18; Ps. 49:7</span></span><span class=\"content\">a ransom;</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"JOB.33.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"JOB.33.25\"><span class=\"label\">25</span><span class=\"content\">let his flesh </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Kgs. 5:14; [Heb. 9:12]</span></span><span class=\"content\">become fresh with youth;</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"JOB.33.25\"><span class=\"content\">let him return to the days of his youthful vigor&#8217;;</span></span></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"JOB.33.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"JOB.33.26\"><span class=\"label\">26</span><span class=\"content\">then man</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">33:26 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">he</span></span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 22:27 </span></span><span class=\"content\">prays to God, and he accepts him;</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"JOB.33.26\"><span class=\"content\">he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 17:15 </span></span><span class=\"content\">sees his face with a shout of joy,</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"JOB.33.26\"><span class=\"content\">and he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Sam. 12:13; Prov. 28:13; Luke 15:21-24; 1 John 1:9]</span></span><span class=\"content\">restores to man his righteousness.</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"JOB.33.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"JOB.33.27\"><span class=\"label\">27</span><span class=\"content\">He sings before men and says:</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"JOB.33.27\"><span class=\"content\">&#8216;I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 106:6; [Rom. 6:21]</span></span><span class=\"content\">sinned and perverted what was right,</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"JOB.33.27\"><span class=\"content\">and it was not repaid to me.</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"JOB.33.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"JOB.33.28\"><span class=\"label\">28</span><span class=\"content\">He has redeemed my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 38:17 </span></span><span class=\"content\">soul from going down </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 22, 24 </span></span><span class=\"content\">into the pit,</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"JOB.33.28\"><span class=\"content\">and my life shall </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 3:9]</span></span><span class=\"content\">look upon the light.&#8217;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"JOB.33.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"JOB.33.29\"><span class=\"label\">29</span><span class=\"content\">&#8220;Behold, God does all these things,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"JOB.33.29\"><span class=\"content\">twice, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 14</span></span><span class=\"content\">three times, with a man,</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"JOB.33.29\"><span class=\"content\">  </span></span><span class=\"verse v30\" data-usfm=\"JOB.33.30\"><span class=\"label\">30</span><span class=\"content\">to bring back his soul from the pit,</span></span></div><div class=\"q2\"><span class=\"verse v30\" data-usfm=\"JOB.33.30\"><span class=\"content\">that he may be lighted with </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 56:13</span></span><span class=\"content\">the light of life.</span></span></div><div class=\"q1\"><span class=\"verse v30\" data-usfm=\"JOB.33.30\"><span class=\"content\">  </span></span><span class=\"verse v31\" data-usfm=\"JOB.33.31\"><span class=\"label\">31</span><span class=\"content\">Pay attention, O Job, listen to me;</span></span></div><div class=\"q2\"><span class=\"verse v31\" data-usfm=\"JOB.33.31\"><span class=\"content\">be silent, and I will speak.</span></span></div><div class=\"q1\"><span class=\"verse v31\" data-usfm=\"JOB.33.31\"><span class=\"content\">  </span></span><span class=\"verse v32\" data-usfm=\"JOB.33.32\"><span class=\"label\">32</span><span class=\"content\">If you have any words, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 5 </span></span><span class=\"content\">answer me;</span></span></div><div class=\"q2\"><span class=\"verse v32\" data-usfm=\"JOB.33.32\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 34:33  </span></span><span class=\"content\">speak, for I desire to justify you.</span></span></div><div class=\"q1\"><span class=\"verse v32\" data-usfm=\"JOB.33.32\"><span class=\"content\">  </span></span><span class=\"verse v33\" data-usfm=\"JOB.33.33\"><span class=\"label\">33</span><span class=\"content\">If not, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 34:11</span></span><span class=\"content\">listen to me;</span></span></div><div class=\"q2\"><span class=\"verse v33\" data-usfm=\"JOB.33.33\"><span class=\"content\">be silent, and I will teach you wisdom.&#8221;</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["JOB.34"], "human": "Job 34", "toc": true, "version_id": 59}, "previous": {"c