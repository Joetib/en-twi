{"pageProps": {"params": {"versionId": "59", "usfm": "JOB.23.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/JOB/23-a6c70798e7a7fe98e65a893da48b1f99.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/JOB/23-a6c70798e7a7fe98e65a893da48b1f99.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkJOB\">\n        <div class=\"chapter ch23\" data-usfm=\"JOB.23\">\n            <div class=\"label\">23</div><div class=\"s1\"><span class=\"heading\">Job Replies: Where Is God?</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"JOB.23.1\"><span class=\"label\">1</span><span class=\"content\">Then Job answered and said:</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"JOB.23.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"JOB.23.2\"><span class=\"label\">2</span><span class=\"content\">&#8220;Today also my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 10:1; 21:4 </span></span><span class=\"content\">complaint is bitter;</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">23:2 </span><span class=\"ft\">Or </span><span class=\"fq\">defiant</span></span></span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"JOB.23.2\"><span class=\"content\">my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 32:4]</span></span><span class=\"content\">hand is heavy on account of my groaning.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"JOB.23.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"JOB.23.3\"><span class=\"label\">3</span><span class=\"content\">Oh, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 13:3; 16:21] </span></span><span class=\"content\">that I knew where I might find him,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"JOB.23.3\"><span class=\"content\">that I might come even to his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 9:7, 8; Isa. 57:15, 16]</span></span><span class=\"content\">seat!</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"JOB.23.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"JOB.23.4\"><span class=\"label\">4</span><span class=\"content\">I would </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 33:5</span></span><span class=\"content\">lay my case before him</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"JOB.23.4\"><span class=\"content\">and fill my mouth with arguments.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"JOB.23.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"JOB.23.5\"><span class=\"label\">5</span><span class=\"content\">I would know what he would answer me</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"JOB.23.5\"><span class=\"content\">and understand what he would say to me.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"JOB.23.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"JOB.23.6\"><span class=\"label\">6</span><span class=\"content\">Would he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 9:34; 13:21]</span></span><span class=\"content\">contend with me in the greatness of his power?</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"JOB.23.6\"><span class=\"content\">No; he would pay attention to me.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"JOB.23.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"JOB.23.7\"><span class=\"label\">7</span><span class=\"content\">There an upright man could argue with him,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"JOB.23.7\"><span class=\"content\">and I would be acquitted forever by my judge.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"JOB.23.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"JOB.23.8\"><span class=\"label\">8</span><span class=\"content\">&#8220;Behold, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 9:11; 35:14</span></span><span class=\"content\">I go forward, but he is not there,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"JOB.23.8\"><span class=\"content\">and backward, but I do not perceive him;</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"JOB.23.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"JOB.23.9\"><span class=\"label\">9</span><span class=\"content\">on the left hand when he is working, I do not behold him;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"JOB.23.9\"><span class=\"content\">he turns to the right hand, but I do not see him.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"JOB.23.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"JOB.23.10\"><span class=\"label\">10</span><span class=\"content\">But he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 139:1-3 </span></span><span class=\"content\">knows </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 139:24 </span></span><span class=\"content\">the way that I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 9:35] </span></span><span class=\"content\">take;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"JOB.23.10\"><span class=\"content\">when he has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 17:3; 26:2; 66:10; 139:23; Zech. 13:9; Mal. 3:3; 1 Pet. 1:7; Rev. 3:18; [James 1:12]</span></span><span class=\"content\">tried me, I shall come out as gold.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"JOB.23.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"JOB.23.11\"><span class=\"label\">11</span><span class=\"content\">My foot </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 17:5; 44:18 </span></span><span class=\"content\">has held fast to his steps;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"JOB.23.11\"><span class=\"content\">I have kept his way and have </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 125:5</span></span><span class=\"content\">not turned aside.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"JOB.23.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"JOB.23.12\"><span class=\"label\">12</span><span class=\"content\">I have not departed from the commandment of his lips;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"JOB.23.12\"><span class=\"content\">I have </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 119:11] </span></span><span class=\"content\">treasured the words of his mouth more than my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 119:103; John 4:32, 34]</span></span><span class=\"content\">portion of food.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"JOB.23.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"JOB.23.13\"><span class=\"label\">13</span><span class=\"content\">But he is unchangeable,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">23:13 </span><span class=\"ft\">Or </span><span class=\"fq\">one</span></span></span><span class=\"content\"> and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 9:12; 12:14] </span></span><span class=\"content\">who can turn him back?</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"JOB.23.13\"><span class=\"content\">What he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 115:3</span></span><span class=\"content\">desires, that he does.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"JOB.23.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"JOB.23.14\"><span class=\"label\">14</span><span class=\"content\">For he will complete what he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Thess. 3:3] </span></span><span class=\"content\">appoints for me,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"JOB.23.14\"><span class=\"content\">and many such things are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 10:13; 27:11]</span></span><span class=\"content\">in his mind.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"JOB.23.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"JOB.23.15\"><span class=\"label\">15</span><span class=\"content\">Therefore I am terrified at his presence;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"JOB.23.15\"><span class=\"content\">when I consider, I am in dread of him.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"JOB.23.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"JOB.23.16\"><span class=\"label\">16</span><span class=\"content\">God has made my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 20:3; [Ps. 22:14]</span></span><span class=\"content\">heart faint;</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"JOB.23.16\"><span class=\"content\">the Almighty has terrified me;</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"JOB.23.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"JOB.23.17\"><span class=\"label\">17</span><span class=\"content\">yet I am not silenced because of the darkness,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"JOB.23.17\"><span class=\"content\">nor because thick darkness covers my face.</span></span></div><div class=\"b\"></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["JOB.24"], "human": "Job 24", "toc": true, "version_id": 59}, 