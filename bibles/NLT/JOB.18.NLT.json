{"pageProps": {"params": {"versionId": "59", "usfm": "JOB.18.NLT"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/JOB/18-f391e6959442a18a6667c1b97eb02cac.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/JOB/18-f391e6959442a18a6667c1b97eb02cac.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkJOB\">\n        <div class=\"chapter ch18\" data-usfm=\"JOB.18\">\n            <div class=\"label\">18</div><div class=\"s1\"><span class=\"heading\">Bildad Speaks: God Punishes the Wicked</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"JOB.18.1\"><span class=\"label\">1</span><span class=\"content\">Then </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:11; 8:1</span></span><span class=\"content\">Bildad the Shuhite answered and said:</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"JOB.18.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"JOB.18.2\"><span class=\"label\">2</span><span class=\"content\">&#8220;How long will you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Matt. 22:15; Mark 12:13; Luke 20:20]</span></span><span class=\"content\">hunt for words?</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"JOB.18.2\"><span class=\"content\">Consider, and then we will speak.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"JOB.18.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"JOB.18.3\"><span class=\"label\">3</span><span class=\"content\">Why are we counted as </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 73:22</span></span><span class=\"content\">cattle?</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"JOB.18.3\"><span class=\"content\">Why are we stupid in your sight?</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"JOB.18.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"JOB.18.4\"><span class=\"label\">4</span><span class=\"content\">You who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 16:9 </span></span><span class=\"content\">tear yourself in your anger,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"JOB.18.4\"><span class=\"content\">shall the earth be forsaken for you,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"JOB.18.4\"><span class=\"content\">or </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 14:18</span></span><span class=\"content\">the rock be removed out of its place?</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"JOB.18.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"JOB.18.5\"><span class=\"label\">5</span><span class=\"content\">&#8220;Indeed, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 21:17; Prov. 13:9; 20:20; 24:20; See Ps. 18:28</span></span><span class=\"content\">the light of the wicked is put out,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"JOB.18.5\"><span class=\"content\">and the flame of his fire does not shine.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"JOB.18.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"JOB.18.6\"><span class=\"label\">6</span><span class=\"content\">The light is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 10:22</span></span><span class=\"content\">dark in his tent,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"JOB.18.6\"><span class=\"content\">and his lamp above him is put out.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"JOB.18.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"JOB.18.7\"><span class=\"label\">7</span><span class=\"content\">His strong steps are shortened,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"JOB.18.7\"><span class=\"content\">and his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 5:13]</span></span><span class=\"content\">own schemes throw him down.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"JOB.18.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"JOB.18.8\"><span class=\"label\">8</span><span class=\"content\">For he is cast into a net by his own feet,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"JOB.18.8\"><span class=\"content\">and he walks on its mesh.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"JOB.18.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"JOB.18.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 140:5\n        </span></span><span class=\"content\">A trap seizes him by the heel;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"JOB.18.9\"><span class=\"content\">a snare lays hold of him.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"JOB.18.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"JOB.18.10\"><span class=\"label\">10</span><span class=\"content\">A rope is hidden for him in the ground,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"JOB.18.10\"><span class=\"content\">a trap for him in the path.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"JOB.18.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"JOB.18.11\"><span class=\"label\">11</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 15:21; 20:25; 27:20; 30:15; Jer. 6:25; 46:5; 49:29  </span></span><span class=\"content\">Terrors frighten him on every side,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"JOB.18.11\"><span class=\"content\">and chase him at his heels.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"JOB.18.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"JOB.18.12\"><span class=\"label\">12</span><span class=\"content\">His strength is famished,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"JOB.18.12\"><span class=\"content\">and calamity is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 38:17</span></span><span class=\"content\">ready for his stumbling.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"JOB.18.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"JOB.18.13\"><span class=\"label\">13</span><span class=\"content\">It consumes the parts of his skin;</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"JOB.18.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 14:30\n        </span></span><span class=\"content\">the firstborn of death consumes his limbs.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"JOB.18.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"JOB.18.14\"><span class=\"label\">14</span><span class=\"content\">He is torn from the tent in which he trusted</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"JOB.18.14\"><span class=\"content\">and is brought to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Rev. 9:11]</span></span><span class=\"content\">the king of terrors.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"JOB.18.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"JOB.18.15\"><span class=\"label\">15</span><span class=\"content\">In his tent dwells that which is none of his;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"JOB.18.15\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 11:6; Ezek. 38:22  </span></span><span class=\"content\">sulfur is scattered over his habitation.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"JOB.18.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"JOB.18.16\"><span class=\"label\">16</span><span class=\"content\">His </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 29:19; Hos. 9:16 </span></span><span class=\"content\">roots dry up beneath,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"JOB.18.16\"><span class=\"content\">and his branches </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 14:2</span></span><span class=\"content\">wither above.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"JOB.18.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"JOB.18.17\"><span class=\"label\">17</span><span class=\"content\">His </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 34:16; Prov. 10:7; [Ps. 109:13, 15]</span></span><span class=\"content\">memory perishes from the earth,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"JOB.18.17\"><span class=\"content\">and he has no name in the street.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"JOB.18.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"JOB.18.18\"><span class=\"label\">18</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 10:21, 22  </span></span><span class=\"content\">He is thrust from light into darkness,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"JOB.18.18\"><span class=\"content\">and driven out of the world.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"JOB.18.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"JOB.18.19\"><span class=\"label\">19</span><span class=\"content\">He has no </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 14:22</span></span><span class=\"content\">posterity or progeny among his people,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"JOB.18.19\"><span class=\"content\">and no survivor where he used to live.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"JOB.18.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"JOB.18.20\"><span class=\"label\">20</span><span class=\"content\">They of the west are appalled at his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 37:13; Jer. 50:27; Ezek. 21:25, 29; Obad. 12; [1 Sam. 26:10] </span></span><span class=\"content\">day,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"JOB.18.20\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 21:6]</span></span><span class=\"content\">horror seizes them of the east.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"JOB.18.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"JOB.18.21\"><span class=\"label\">21</span><span class=\"content\">Surely such are the dwellings of the unrighteous,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"JOB.18.21\"><span class=\"content\">such is the place of him who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Judg. 2:10; Jer. 9:3; 10:25; 1 Thess. 4:8; 2 Thess. 1:8</span></span><span class=\"content\">knows not God.&#8221;</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["JOB.19"], "human": "Job 19", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["JOB.17"], "human": "Job 17", "toc": true, "version_id": 59}, "reference": {"usfm": ["JOB.18"], "human": "Job 18", "version_id": 59}}, "usfm": "JOB.18.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyrig