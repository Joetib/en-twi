note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 7]; See Ps. 69:34 </span></span><span class=\"content\">from the heavens;</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.148.1\"><span class=\"content\">praise him </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Matt. 21:9</span></span><span class=\"content\">in the heights!</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.148.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.148.2\"><span class=\"label\">2</span><span class=\"content\">Praise him, all his angels;</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.148.2\"><span class=\"content\">praise him, all his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 103:20, 21</span></span><span class=\"content\">hosts!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.148.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.148.3\"><span class=\"label\">3</span><span class=\"content\">Praise him, sun and moon,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.148.3\"><span class=\"content\">praise him, all you shining stars!</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.148.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.148.4\"><span class=\"label\">4</span><span class=\"content\">Praise him, you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 68:33; Deut. 10:14; Neh. 9:6; See 1 Kgs. 8:27 </span></span><span class=\"content\">highest heavens,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.148.4\"><span class=\"content\">and you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 1:7</span></span><span class=\"content\">waters above the heavens!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.148.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.148.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 13   </span></span><span class=\"content\">Let them praise the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.148.5\"><span class=\"content\">For </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 33:6, 9</span></span><span class=\"content\">he commanded and they were created.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.148.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.148.6\"><span class=\"label\">6</span><span class=\"content\">And he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 119:90, 91 </span></span><span class=\"content\">established them forever and ever;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.148.6\"><span class=\"content\">he gave </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Job 28:26; Jer. 31:35, 36; 33:25] </span></span><span class=\"content\">a decree, and it shall not </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 104:9; Esth. 1:19; Job 14:5]</span></span><span class=\"content\">pass away.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">148:6 </span><span class=\"ft\">Or </span><span class=\"fq\">it shall not be transgressed</span></span></span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.148.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.148.7\"><span class=\"label\">7</span><span class=\"content\">Praise the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 1] </span></span><span class=\"content\">from the earth,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.148.7\"><span class=\"content\">you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 1:21]; See Ps. 74:13</span></span><span class=\"content\">great sea creatures and all deeps,</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.148.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.148.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 18:12; 105:32   </span></span><span class=\"content\">fire and hail, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 147:16 </span></span><span class=\"content\">snow and mist,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.148.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 107:25   </span></span><span class=\"content\">stormy wind </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 103:20; See Ps. 147:15-18</span></span><span class=\"content\">fulfilling his word!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PSA.148.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PSA.148.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 44:23; 49:13; 55:12   </span></span><span class=\"content\">Mountains and all hills,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PSA.148.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Gen. 1:11   </span></span><span class=\"content\">fruit trees and all </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 104:16</span></span><span class=\"content\">cedars!</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.148.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PSA.148.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Gen. 1:24   </span></span><span class=\"content\">Beasts and all livestock,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PSA.148.10\"><span class=\"content\">creeping things and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 1:20, 21</span></span><span class=\"content\">flying birds!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PSA.148.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PSA.148.11\"><span class=\"label\">11</span><span class=\"content\">Kings of the earth and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Rev. 7:9]</span></span><span class=\"content\">all peoples,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.148.11\"><span class=\"content\">princes and all rulers of the earth!</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.148.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PSA.148.12\"><span class=\"label\">12</span><span class=\"content\">Young men and maidens together,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.148.12\"><span class=\"content\">old men and children!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.148.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PSA.148.13\"><span class=\"label\">13</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 5   </span></span><span class=\"content\">Let them praise the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.148.13\"><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 8:1 </span></span><span class=\"content\">his name alone is exalted;</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.148.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 113:4  </span></span><span class=\"content\">his majesty is above earth and heaven.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PSA.148.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PSA.148.14\"><span class=\"label\">14</span><span class=\"content\">He has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Sam. 2:1 </span></span><span class=\"content\">raised up a horn for his people,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.148.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Deut. 10:21; Jer. 17:14]   </span></span><span class=\"content\">praise for all his saints,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.148.14\"><span class=\"content\">for the people of Israel who are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 4:7; Eph. 2:17 </span></span><span class=\"content\">near to him.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.148.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 135:1  </span></span><span class=\"content\">Praise the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PSA.149"], "human": "Psalm 149", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PSA.147"], "human": "Psalm 147", "toc": true, "version_id": 59}, "reference": {"usfm": ["PSA.148"], "human": "Psalm 148", "version_id": 59}}, "usfm": "PSA.148.NLT", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway /