{"pageProps": {"params": {"versionId": "59", "usfm": "PRO.12.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PRO/12-275cfd1165d3fa2f867578b2ac70838a.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PRO/12-275cfd1165d3fa2f867578b2ac70838a.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPRO\">\n        <div class=\"chapter ch12\" data-usfm=\"PRO.12\">\n            <div class=\"label\">12</div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PRO.12.1\"><span class=\"label\">1</span><span class=\"content\">Whoever loves discipline loves knowledge,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PRO.12.1\"><span class=\"content\">but he who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 5:12; 15:10 </span></span><span class=\"content\">hates reproof is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 49:10</span></span><span class=\"content\">stupid.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PRO.12.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PRO.12.2\"><span class=\"label\">2</span><span class=\"content\">A good man </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 8:35</span></span><span class=\"content\">obtains favor from the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PRO.12.2\"><span class=\"content\">but a man of evil devices he condemns.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PRO.12.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PRO.12.3\"><span class=\"label\">3</span><span class=\"content\">No one is established by wickedness,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PRO.12.3\"><span class=\"content\">but the root of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 10:25</span></span><span class=\"content\">the righteous will never be moved.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PRO.12.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PRO.12.4\"><span class=\"label\">4</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 31:10   </span></span><span class=\"content\">An excellent wife is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Song 3:11 </span></span><span class=\"content\">the crown of her husband,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PRO.12.4\"><span class=\"content\">but she who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 10:5 </span></span><span class=\"content\">brings shame is like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 14:30</span></span><span class=\"content\">rottenness in his bones.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PRO.12.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PRO.12.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 12:35]  </span></span><span class=\"content\">The thoughts of the righteous are just;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PRO.12.5\"><span class=\"content\">the counsels of the wicked are deceitful.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PRO.12.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PRO.12.6\"><span class=\"label\">6</span><span class=\"content\">The words of the wicked </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:11 </span></span><span class=\"content\">lie in wait for blood,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PRO.12.6\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 14:3</span></span><span class=\"content\">the mouth of the upright delivers them.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PRO.12.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PRO.12.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 11:21   </span></span><span class=\"content\">The wicked are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 34:25 </span></span><span class=\"content\">overthrown and are no more,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PRO.12.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 10:25, 30]  </span></span><span class=\"content\">but the house of the righteous will stand.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PRO.12.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PRO.12.8\"><span class=\"label\">8</span><span class=\"content\">A man is commended according to his good sense,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PRO.12.8\"><span class=\"content\">but one of twisted mind is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Sam. 20:30]</span></span><span class=\"content\">despised.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PRO.12.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PRO.12.9\"><span class=\"label\">9</span><span class=\"content\">Better to be lowly and have a servant</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PRO.12.9\"><span class=\"content\">than to play the great man and lack bread.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PRO.12.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PRO.12.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Deut. 25:4]  </span></span><span class=\"content\">Whoever is righteous has regard for the life of his beast,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PRO.12.10\"><span class=\"content\">but the mercy of the wicked is cruel.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PRO.12.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PRO.12.11\"><span class=\"label\">11</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 28:19   </span></span><span class=\"content\">Whoever works his land </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 20:13 </span></span><span class=\"content\">will have plenty of bread,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PRO.12.11\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 28:19   </span></span><span class=\"content\">but he who follows </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Judg. 9:4</span></span><span class=\"content\">worthless pursuits lacks sense.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PRO.12.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PRO.12.12\"><span class=\"label\">12</span><span class=\"content\">Whoever is wicked covets </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 10:9]</span></span><span class=\"content\">the spoil of evildoers,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PRO.12.12\"><span class=\"content\">but the root of the righteous bears fruit.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PRO.12.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PRO.12.13\"><span class=\"label\">13</span><span class=\"content\">An evil man is ensnared </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 18:7; [Ps. 64:8; Matt. 12:37] </span></span><span class=\"content\">by the transgression of his lips,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">12:13 </span><span class=\"ft\">Or </span><span class=\"fq\">In the transgression of the lips, there is an evil snare</span></span></span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PRO.12.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 21:23  </span></span><span class=\"content\">but the righteous escapes from trouble.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PRO.12.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PRO.12.14\"><span class=\"label\">14</span><span class=\"content\">From the fruit of his mouth </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 13:2; 14:14; 18:20 </span></span><span class=\"content\">a man is satisfied with good,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PRO.12.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 19:17; Isa. 3:10, 11; [Judg. 9:16, 56]  </span></span><span class=\"content\">and the work of a man&#8217;s hand comes back to him.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PRO.12.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PRO.12.15\"><span class=\"label\">15</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 3:7; 16:2; 21:2; 26:12; [ch. 14:12; 16:25]  </span></span><span class=\"content\">The way of a fool is right in his own eyes,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PRO.12.15\"><span class=\"content\">but a wise man listens to advice.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PRO.12.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PRO.12.16\"><span class=\"label\">16</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 14:33; 29:11]  </span></span><span class=\"content\">The vexation of a fool is known at once,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PRO.12.16\"><span class=\"content\">but the prudent ignores an insult.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PRO.12.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PRO.12.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 14:5   </span></span><span class=\"content\">Whoever speaks</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">12:17 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">breathes out</span></span></span><span class=\"content\"> the truth gives honest evidence,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PRO.12.17\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 6:19</span></span><span class=\"content\">a false witness utters deceit.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PRO.12.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PRO.12.18\"><span class=\"label\">18</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 57:4   </span></span><span class=\"content\">There is one whose rash words are like sword thrusts,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PRO.12.18\"><span class=\"content\">but the tongue of the wise brings </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 4:22</span></span><span class=\"content\">healing.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"PRO.12.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"PRO.12.19\"><span class=\"label\">19</span><span class=\"content\">Truthful lips endure forever,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"PRO.12.19\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 19:9; [Ps. 52:4, 5]</span></span><span class=\"content\">a lying tongue is but for a moment.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"PRO.12.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"PRO.12.20\"><span class=\"label\">20</span><span class=\"content\">Deceit is in the heart of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:29</span></span><span class=\"content\">those who devise evil,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"PRO.12.20\"><span class=\"content\">but those who plan peace have joy.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"PRO.12.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"PRO.12.21\"><span class=\"label\">21</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 91:10; [1 Pet. 3:13; 2 Pet. 2:9]  </span></span><span class=\"content\">No ill befalls the righteous,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"PRO.12.21\"><span class=\"content\">but the wicked are filled with trouble.</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"PRO.12.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"PRO.12.22\"><span class=\"label\">22</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Rev. 22:15]; See ch. 6:17   </span></span><span class=\"content\">Lying lips are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 11:20 </span></span><span class=\"content\">an abomination to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"PRO.12.22\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 11:1]  </span></span><span class=\"content\">but those who act faithfully are his delight.</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"PRO.12.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"PRO.12.23\"><span class=\"label\">23</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 13:16; 15:2]  </span></span><span class=\"content\">A prudent man conceals knowledge,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"PRO.12.23\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 13:16; 15:2]  </span></span><span class=\"content\">but the heart of fools proclaims folly.</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"PRO.12.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"PRO.12.24\"><span class=\"label\">24</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 10:4; 13:4]   </span></span><span class=\"content\">The hand of the diligent will rule,</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"PRO.12.24\"><span class=\"content\">while the slothful will be </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 49:15; 1 Kgs. 9:21]</span></span><span class=\"content\">put to forced labor.</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"PRO.12.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"PRO.12.25\"><span class=\"label\">25</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 15:13; [ch. 17:22]  </span></span><span class=\"content\">Anxiety in a man&#8217;s heart weighs him down,</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"PRO.12.25\"><span class=\"content\">but a good word makes him glad.</span></span></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"PRO.12.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"PRO.12.26\"><span class=\"label\">26</span><span class=\"content\">One who is righteous is a guide to his neighbor,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">12:26 </span><span class=\"ft\">Or </span><span class=\"fq\">The righteous chooses his friends carefully</span></span></span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"PRO.12.26\"><span class=\"content\">but the way of the wicked leads them astray.</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"PRO.12.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"PRO.12.27\"><span class=\"label\">27</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ver. 24]  </span></span><span class=\"content\">Whoever is slothful will not roast his game,</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"PRO.12.27\"><span class=\"content\">but the diligent man will get precious wealth.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">12:27 </span><span class=\"ft\">Or </span><span class=\"fq\">but diligence is precious wealth</span></span></span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"PRO.12.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"PRO.12.28\"><span class=\"label\">28</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 10:2  </span></span><span class=\"content\">In the path of righteousness is life,</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"PRO.12.28\"><span class=\"content\">and in its pathway there is no death.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PRO.13"], "human": "Proverbs 13", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PRO.11"], "human": "Proverbs 11", "toc": true, "version_id": 59}, "reference": {"usfm": ["PRO.12"], "human": "Proverbs 12", "version_id": 59}}, "usfm": "PRO.12.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p> \r\n<p>Sign up to receive news and updates about the ESV:</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway,