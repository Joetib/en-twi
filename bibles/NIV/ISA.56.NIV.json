{"pageProps": {"params": {"versionId": "59", "usfm": "ISA.56.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/ISA/56-abbfc69d385f86ad3316322ee1877c5e.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/ISA/56-abbfc69d385f86ad3316322ee1877c5e.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkISA\">\n        <div class=\"chapter ch56\" data-usfm=\"ISA.56\">\n            <div class=\"label\">56</div><div class=\"s1\"><span class=\"heading\">Salvation for Foreigners</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"ISA.56.1\"><span class=\"label\">1</span><span class=\"content\">Thus says the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">:</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"ISA.56.1\"><span class=\"content\">&#8220;Keep justice, and do righteousness,</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"ISA.56.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 46:12, 13; 51:5, 6  </span></span><span class=\"content\">for soon my salvation will come,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"ISA.56.1\"><span class=\"content\">and my righteousness be revealed.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"ISA.56.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"ISA.56.2\"><span class=\"label\">2</span><span class=\"content\">Blessed is the man who does this,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ISA.56.2\"><span class=\"content\">and the son of man who holds it fast,</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ISA.56.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 58:13  </span></span><span class=\"content\">who keeps the Sabbath, not profaning it,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ISA.56.2\"><span class=\"content\">and keeps his hand from doing any evil.&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ISA.56.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"ISA.56.3\"><span class=\"label\">3</span><span class=\"content\">Let not </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 14:1; [Deut. 23:7, 8] </span></span><span class=\"content\">the foreigner who has joined himself to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> say,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"ISA.56.3\"><span class=\"content\">&#8220;The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> will surely separate me from his people&#8221;;</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"ISA.56.3\"><span class=\"content\">and let not the eunuch say,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"ISA.56.3\"><span class=\"content\">&#8220;Behold, I am </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ezek. 17:24; 20:47]</span></span><span class=\"content\">a dry tree.&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"ISA.56.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"ISA.56.4\"><span class=\"label\">4</span><span class=\"content\">For thus says the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">:</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"ISA.56.4\"><span class=\"content\">&#8220;To the eunuchs </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 2 above]</span></span><span class=\"content\">who keep my Sabbaths,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"ISA.56.4\"><span class=\"content\">who choose the things that please me</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"ISA.56.4\"><span class=\"content\">and hold fast my covenant,</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"ISA.56.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"ISA.56.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [1 Tim. 3:15; Rev. 3:12]   </span></span><span class=\"content\">I will give in my house and within my walls</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ISA.56.5\"><span class=\"content\">a </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Sam. 18:18; John 1:12] </span></span><span class=\"content\">monument and a name</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ISA.56.5\"><span class=\"content\">better than sons and daughters;</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"ISA.56.5\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [2 Tim. 2:19]  </span></span><span class=\"content\">I will give them an everlasting name</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ISA.56.5\"><span class=\"content\">that shall not be cut off.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"ISA.56.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"ISA.56.6\"><span class=\"label\">6</span><span class=\"content\">&#8220;And </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 3 above] </span></span><span class=\"content\">the foreigners who join themselves to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ISA.56.6\"><span class=\"content\">to minister to him, to love the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ISA.56.6\"><span class=\"content\">and to be his servants,</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"ISA.56.6\"><span class=\"content\">everyone </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 2 above]</span></span><span class=\"content\">who keeps the Sabbath and does not profane it,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ISA.56.6\"><span class=\"content\">and holds fast my covenant&#8212;</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"ISA.56.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"ISA.56.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 65:1; [ch. 19:24, 25]   </span></span><span class=\"content\">these I will bring to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:2 </span></span><span class=\"content\">my holy mountain,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ISA.56.7\"><span class=\"content\">and make them joyful in my house of prayer;</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ISA.56.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Rom. 15:16]   </span></span><span class=\"content\">their burnt offerings and their sacrifices</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ISA.56.7\"><span class=\"content\">will be accepted on my altar;</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ISA.56.7\"><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Cited Matt. 21:13; Mark 11:17; Luke 19:46</span></span><span class=\"content\">my house shall be called a house of prayer</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ISA.56.7\"><span class=\"content\">for all peoples.&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ISA.56.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"ISA.56.8\"><span class=\"label\">8</span><span class=\"content\">The Lord </span><span class=\"nd\"><span class=\"content\">God</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"ISA.56.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 11:12   </span></span><span class=\"content\">who gathers the outcasts of Israel, declares,</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"ISA.56.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        John 10:16; Eph. 1:10; See Eph. 2:11-16  </span></span><span class=\"content\">&#8220;I will gather yet others to him</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"ISA.56.8\"><span class=\"content\">besides those already gathered.&#8221;</span></span></div><div class=\"s1\"><span class=\"heading\">Israel&#8217;s Irresponsible Leaders</span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"ISA.56.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"ISA.56.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Jer. 12:9; Ezek. 34:8  </span></span><span class=\"content\">All you beasts of the field, come to devour&#8212;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"ISA.56.9\"><span class=\"content\">all you beasts in the forest.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"ISA.56.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"ISA.56.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 62:6; Jer. 6:17   </span></span><span class=\"content\">His watchmen are blind;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"ISA.56.10\"><span class=\"content\">they are all without knowledge;</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"ISA.56.10\"><span class=\"content\">they are all silent </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Phil. 3:2]</span></span><span class=\"content\">dogs;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"ISA.56.10\"><span class=\"content\">they cannot bark,</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"ISA.56.10\"><span class=\"content\">dreaming, lying down,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"ISA.56.10\"><span class=\"content\">loving to slumber.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"ISA.56.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"ISA.56.11\"><span class=\"label\">11</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ezek. 34:2, 3   </span></span><span class=\"content\">The dogs have a mighty appetite;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"ISA.56.11\"><span class=\"content\">they never have enough.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"ISA.56.11\"><span class=\"content\">But </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Jer. 23:1] </span></span><span class=\"content\">they are shepherds who have no understanding;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"ISA.56.11\"><span class=\"content\">they have all turned to their own way,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"ISA.56.11\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Jer. 6:13\n        </span></span><span class=\"content\">each to his own gain, one and all.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"ISA.56.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"ISA.56.12\"><span class=\"label\">12</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 28:7]   </span></span><span class=\"content\">&#8220;Come,&#8221; they say, &#8220;let me get wine;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"ISA.56.12\"><span class=\"content\">let us fill ourselves with strong drink;</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"ISA.56.12\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 22:13; Prov. 23:35; Luke 12:19; 1 Cor. 15:32]  </span></span><span class=\"content\">and tomorrow will be like this day,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"ISA.56.12\"><span class=\"content\">great beyond measure.&#8221;</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["ISA.57"], "human": "Isaiah 57", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["ISA.55"], "human": "Isaiah 55", "toc": true, "version_id": 59}, "reference": {"usfm": ["ISA.56"], "human": "Isaiah 56", "version_id": 59}}, "usfm": "ISA.56.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_f