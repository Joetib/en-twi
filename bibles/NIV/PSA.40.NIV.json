{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.40.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/40-215b2256f347364eeae3fead9a845add.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/40-215b2256f347364eeae3fead9a845add.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch40\" data-usfm=\"PSA.40\">\n            <div class=\"label\">40</div><div class=\"s1\"><span class=\"heading\">My Help and My Deliverer</span></div><div class=\"d\"><span class=\"content\">To the choirmaster. A Psalm of David.</span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.40.1\"><span class=\"label\">1</span><span class=\"content\">I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 27:14; 37:7 </span></span><span class=\"content\">waited patiently for the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.40.1\"><span class=\"content\">he inclined to me and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 39:12</span></span><span class=\"content\">heard my cry.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.40.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.40.2\"><span class=\"label\">2</span><span class=\"content\">He drew me up from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Jer. 38:6] </span></span><span class=\"content\">the pit of destruction,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.40.2\"><span class=\"content\">out of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 69:2, 14 </span></span><span class=\"content\">the miry bog,</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.40.2\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 27:5 </span></span><span class=\"content\">set my feet upon a rock,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.40.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 37:23\n        </span></span><span class=\"content\">making my steps secure.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.40.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.40.3\"><span class=\"label\">3</span><span class=\"content\">He put </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 33:3 </span></span><span class=\"content\">a new song in my mouth,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.40.3\"><span class=\"content\">a song of praise to our God.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.40.3\"><span class=\"content\">Many will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 52:6; 64:8, 9; Deut. 13:11</span></span><span class=\"content\">see and fear,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.40.3\"><span class=\"content\">and put their trust in the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.40.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.40.4\"><span class=\"label\">4</span><span class=\"content\">Blessed is the man who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 2:12 </span></span><span class=\"content\">makes</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.40.4\"><span class=\"content\">the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> his trust,</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.40.4\"><span class=\"content\">who does not turn to the proud,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.40.4\"><span class=\"content\">to those who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 101:3; 125:5; Lev. 19:4; Deut. 29:18; Job 23:11; Hos. 3:1</span></span><span class=\"content\">go astray after a lie!</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.40.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.40.5\"><span class=\"label\">5</span><span class=\"content\">You have multiplied, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> my God,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.40.5\"><span class=\"content\">your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 9:1; Ex. 15:11 </span></span><span class=\"content\">wondrous deeds and your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 92:5; 139:17; Isa. 55:8 </span></span><span class=\"content\">thoughts toward us;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.40.5\"><span class=\"content\">none can compare with you!</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.40.5\"><span class=\"content\">I will proclaim and tell of them,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.40.5\"><span class=\"content\">yet they are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 71:15; 139:18</span></span><span class=\"content\">more than can be told.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.40.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.40.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 51:16; 1 Sam. 15:22; Cited Heb. 10:5-7; See Prov. 21:3   </span></span><span class=\"content\">In sacrifice and offering you have not delighted,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.40.6\"><span class=\"content\">but you have given me an open </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Job 33:16</span></span><span class=\"content\">ear.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">40:6 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">ears you have dug for me</span></span></span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.40.6\"><span class=\"content\">Burnt offering and sin offering</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.40.6\"><span class=\"content\">you have not required.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.40.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.40.7\"><span class=\"label\">7</span><span class=\"content\">Then I said, &#8220;Behold, I have come;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.40.7\"><span class=\"content\">in the scroll of the book it is written </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 24:44</span></span><span class=\"content\">of me:</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.40.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.40.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 119:16, 24, 35, 92; [John 4:34]   </span></span><span class=\"content\">I delight to do your will, O my God;</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.40.8\"><span class=\"content\">your law is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 37:31</span></span><span class=\"content\">within my heart.&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PSA.40.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PSA.40.9\"><span class=\"label\">9</span><span class=\"content\">I have told the glad news of deliverance</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">40:9 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">righteousness</span><span class=\"ft\">; also verse 10</span></span></span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PSA.40.9\"><span class=\"content\">in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 22:25 </span></span><span class=\"content\">the great congregation;</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.40.9\"><span class=\"content\">behold, I have not </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 119:13; [Acts 20:20, 27] </span></span><span class=\"content\">restrained my lips,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PSA.40.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Josh. 22:22\n        </span></span><span class=\"content\">as you know, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.40.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PSA.40.10\"><span class=\"label\">10</span><span class=\"content\">I have not hidden your deliverance within my heart;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PSA.40.10\"><span class=\"content\">I have spoken of your faithfulness and your salvation;</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PSA.40.10\"><span class=\"content\">I have not concealed your steadfast love and your faithfulness</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PSA.40.10\"><span class=\"content\">from the great congregation.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PSA.40.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PSA.40.11\"><span class=\"label\">11</span><span class=\"content\">As for you, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, you will not restrain</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.40.11\"><span class=\"content\">your mercy from me;</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.40.11\"><span class=\"content\">your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 57:3; 61:7; Prov. 20:28; See Ps. 36:5</span></span><span class=\"content\">steadfast love and your faithfulness will</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.40.11\"><span class=\"content\">ever preserve me!</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.40.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PSA.40.12\"><span class=\"label\">12</span><span class=\"content\">For evils have </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 116:3 </span></span><span class=\"content\">encompassed me</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.40.12\"><span class=\"content\">beyond number;</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.40.12\"><span class=\"content\">my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 38:4 </span></span><span class=\"content\">iniquities have overtaken me,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.40.12\"><span class=\"content\">and I cannot </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 38:10] </span></span><span class=\"content\">see;</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.40.12\"><span class=\"content\">they are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 69:4 </span></span><span class=\"content\">more than the hairs of my head;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.40.12\"><span class=\"content\">my heart </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 73:26</span></span><span class=\"content\">fails me.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.40.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PSA.40.13\"><span class=\"label\">13</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    For ver. 13-17, see Ps. 70:1-5   </span></span><span class=\"content\">Be pleased, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 22:20 </span></span><span class=\"content\">deliver me!</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.40.13\"><span class=\"content\">O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 22:19; 38:22; 71:12; 141:1</span></span><span class=\"content\">make haste to help me!</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PSA.40.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PSA.40.14\"><span class=\"label\">14</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 35:4, 26; 71:13   </span></span><span class=\"content\">Let those be put to shame and disappointed altogether</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.40.14\"><span class=\"content\">who seek to snatch away my life;</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.40.14\"><span class=\"content\">let those be </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 6:10</span></span><span class=\"content\">turned back and brought to dishonor</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.40.14\"><span class=\"content\">who delight in my hurt!</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.40.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PSA.40.15\"><span class=\"label\">15</span><span class=\"content\">Let those be appalled because of their shame</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PSA.40.15\"><span class=\"content\">who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 35:21, 25; 70:3</span></span><span class=\"content\">say to me, &#8220;Aha, Aha!&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PSA.40.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PSA.40.16\"><span class=\"label\">16</span><span class=\"content\">But may all who seek you</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PSA.40.16\"><span class=\"content\">rejoice and be glad in you;</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PSA.40.16\"><span class=\"content\">may those who love your salvation</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PSA.40.16\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 35:27\n        </span></span><span class=\"content\">say continually, &#8220;Great is the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PSA.40.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PSA.40.17\"><span class=\"label\">17</span><span class=\"content\">As for me, I am </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 86:1; 109:22 </span></span><span class=\"content\">poor and needy,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PSA.40.17\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Pet. 5:7]</span></span><span class=\"content\">the Lord takes thought for me.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PSA.40.17\"><span class=\"content\">You are my help and my deliverer;</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PSA.40.17\"><span class=\"content\">do not delay, O my God!</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PSA.41"], "human": "Psalm 41", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PSA.39"], "human": "Psalm 39", "toc": true, "version_id": 59}, "reference": {"usfm": ["PSA.40"], "human": "Psalm 40", "version_id": 59}}, "usfm": "PSA.40.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "re