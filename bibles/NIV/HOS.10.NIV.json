{"pageProps": {"params": {"versionId": "59", "usfm": "HOS.10.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/HOS/10-b6bec5e8217679ac63c699a6167dd8fa.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/HOS/10-b6bec5e8217679ac63c699a6167dd8fa.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkHOS\">\n        <div class=\"chapter ch10\" data-usfm=\"HOS.10\">\n            <div class=\"label\">10</div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"HOS.10.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 80:8-11   </span></span><span class=\"content\">Israel is a luxuriant vine</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"HOS.10.1\"><span class=\"content\">that yields its fruit.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"HOS.10.1\"><span class=\"content\">The more his fruit increased,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"HOS.10.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 8:11  </span></span><span class=\"content\">the more altars he built;</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"HOS.10.1\"><span class=\"content\">as his country improved,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"HOS.10.1\"><span class=\"content\">he improved his pillars.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"HOS.10.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"HOS.10.2\"><span class=\"label\">2</span><span class=\"content\">Their heart is false;</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"HOS.10.2\"><span class=\"content\">now they must bear their guilt.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"HOS.10.2\"><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">10:2 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">He</span></span></span><span class=\"content\"> will break down their altars</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"HOS.10.2\"><span class=\"content\">and destroy their pillars.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"HOS.10.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"HOS.10.3\"><span class=\"label\">3</span><span class=\"content\">For now they will say:</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"HOS.10.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ver. 7, 15; 1 Sam. 12:12]  </span></span><span class=\"content\">&#8220;We have no king,</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"HOS.10.3\"><span class=\"content\">for we do not fear the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"HOS.10.3\"><span class=\"content\">and a king&#8212;what could he do for us?&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"HOS.10.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"HOS.10.4\"><span class=\"label\">4</span><span class=\"content\">They utter </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 4:2] </span></span><span class=\"content\">mere words;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"HOS.10.4\"><span class=\"content\">with empty</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">10:4 </span><span class=\"ft\">Or </span><span class=\"fq\">vain </span><span class=\"ft\">(see Exodus 20:7)</span></span></span><span class=\"content\"> oaths they make covenants;</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"HOS.10.4\"><span class=\"content\">so </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Amos 5:7; 6:12 </span></span><span class=\"content\">judgment springs up like poisonous weeds</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"HOS.10.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 12:11  </span></span><span class=\"content\">in the furrows of the field.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"HOS.10.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"HOS.10.5\"><span class=\"label\">5</span><span class=\"content\">The inhabitants of Samaria tremble</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"HOS.10.5\"><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Kgs. 12:28 </span></span><span class=\"content\">the calf</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">10:5 </span><span class=\"ft\">Or </span><span class=\"fq\">calves</span></span></span><span class=\"content\"> of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 4:15 </span></span><span class=\"content\">Beth-aven.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"HOS.10.5\"><span class=\"content\">Its people mourn for it, and so do its idolatrous priests&#8212;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"HOS.10.5\"><span class=\"content\">those who rejoiced over it and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 9:11; [1 Sam. 4:21, 22]</span></span><span class=\"content\">over its glory&#8212;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"HOS.10.5\"><span class=\"content\">for it has departed</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">10:5 </span><span class=\"ft\">Or </span><span class=\"fq\">has gone into exile</span></span></span><span class=\"content\"> from them.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"HOS.10.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"HOS.10.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 46:2]   </span></span><span class=\"content\">The thing itself shall be carried to Assyria</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"HOS.10.6\"><span class=\"content\">as tribute to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 5:13 </span></span><span class=\"content\">the great king.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">10:6 </span><span class=\"ft\">Or </span><span class=\"fq\">to King Jareb</span></span></span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"HOS.10.6\"><span class=\"content\">Ephraim shall be put to shame,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"HOS.10.6\"><span class=\"content\">and Israel shall be ashamed </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 11:6</span></span><span class=\"content\">of his idol.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">10:6 </span><span class=\"ft\">Or </span><span class=\"fq\">counsel</span></span></span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"HOS.10.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"HOS.10.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ver. 3]  </span></span><span class=\"content\">Samaria&#8217;s king shall perish</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"HOS.10.7\"><span class=\"content\">like a twig on the face of the waters.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"HOS.10.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"HOS.10.8\"><span class=\"label\">8</span><span class=\"content\">The high places of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 5 above] </span></span><span class=\"content\">Aven, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Kgs. 12:30; Amos 8:14 </span></span><span class=\"content\">the sin of Israel,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"HOS.10.8\"><span class=\"content\">shall be destroyed.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"HOS.10.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 9:6]   </span></span><span class=\"content\">Thorn and thistle shall grow up</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"HOS.10.8\"><span class=\"content\">on their altars,</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"HOS.10.8\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 23:30; Rev. 6:16; [Isa. 2:19]</span></span><span class=\"content\">they shall say to the mountains, &#8220;Cover us,&#8221;</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"HOS.10.8\"><span class=\"content\">and to the hills, &#8220;Fall on us.&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"HOS.10.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"HOS.10.9\"><span class=\"label\">9</span><span class=\"content\">From </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 9:9</span></span><span class=\"content\">the days of Gibeah, you have sinned, O Israel;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"HOS.10.9\"><span class=\"content\">there they have continued.</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"HOS.10.9\"><span class=\"content\">Shall not the war against the unjust</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">10:9 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">the children of injustice</span></span></span><span class=\"content\"> overtake them in Gibeah?</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"HOS.10.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"HOS.10.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ex. 32:34]   </span></span><span class=\"content\">When I please, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 7:12 </span></span><span class=\"content\">I will discipline them,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"HOS.10.10\"><span class=\"content\">and nations shall be gathered against them</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"HOS.10.10\"><span class=\"content\">when they are bound up for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Kgs. 12:28]</span></span><span class=\"content\">their double iniquity.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"HOS.10.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"HOS.10.11\"><span class=\"label\">11</span><span class=\"content\">Ephraim was a trained calf</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"HOS.10.11\"><span class=\"content\">that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Deut. 25:4; 1 Cor. 9:9; 1 Tim. 5:18] </span></span><span class=\"content\">loved to thresh,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"HOS.10.11\"><span class=\"content\">and I spared her fair neck;</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"HOS.10.11\"><span class=\"content\">but I will put </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 6:4</span></span><span class=\"content\">Ephraim to the yoke;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"HOS.10.11\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 6:4  </span></span><span class=\"content\">Judah must plow;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"HOS.10.11\"><span class=\"content\">Jacob must harrow for himself.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"HOS.10.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"HOS.10.12\"><span class=\"label\">12</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 8:7; Gal. 6:8]   </span></span><span class=\"content\">Sow for yourselves righteousness;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"HOS.10.12\"><span class=\"content\">reap steadfast love;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"HOS.10.12\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Jer. 4:3   </span></span><span class=\"content\">break up your fallow ground,</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"HOS.10.12\"><span class=\"content\">for it is the time to seek the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"HOS.10.12\"><span class=\"content\">that he may come and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 45:8</span></span><span class=\"content\">rain righteousness upon you.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"HOS.10.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"HOS.10.13\"><span class=\"label\">13</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 8:7]  </span></span><span class=\"content\">You have plowed iniquity;</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"HOS.10.13\"><span class=\"content\">you have reaped injustice;</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"HOS.10.13\"><span class=\"content\">you have eaten the fruit of lies.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"HOS.10.13\"><span class=\"content\">Because you have trusted in your own way</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"HOS.10.13\"><span class=\"content\">and in the multitude of your warriors,</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"HOS.10.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"HOS.10.14\"><span class=\"label\">14</span><span class=\"content\">therefore </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 1:5] </span></span><span class=\"content\">the tumult of war shall arise among your people,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"HOS.10.14\"><span class=\"content\">and all your fortresses shall be destroyed,</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"HOS.10.14\"><span class=\"content\">as </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Kgs. 17:3 </span></span><span class=\"content\">Shalman destroyed Beth-arbel on the day of battle;</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"HOS.10.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 13:16]  </span></span><span class=\"content\">mothers were dashed in pieces with their children.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"HOS.10.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"HOS.10.15\"><span class=\"label\">15</span><span class=\"content\">Thus it shall be done to you, O </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 5] </span></span><span class=\"content\">Bethel,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"HOS.10.15\"><span class=\"content\">because of your great evil.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"HOS.10.15\"><span class=\"content\">At dawn </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 6 above]</span></span><span class=\"content\">the king of Israel</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"HOS.10.15\"><span class=\"content\">shall be utterly cut off.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["HOS.11"], "human": "Hosea 11", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["HOS.9"], "human": "Hosea 9", "toc": true, "version_id": 59}, "reference": {"usfm": ["HOS.10"], "human": "Hosea 10", "version_id": 59}}, "usfm": "HOS.10.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "Eng