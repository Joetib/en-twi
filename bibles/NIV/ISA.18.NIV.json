{"pageProps": {"params": {"versionId": "59", "usfm": "ISA.18.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/ISA/18-ab843263f41e5f04eadb952d770c1c20.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/ISA/18-ab843263f41e5f04eadb952d770c1c20.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkISA\">\n        <div class=\"chapter ch18\" data-usfm=\"ISA.18\">\n            <div class=\"label\">18</div><div class=\"s1\"><span class=\"heading\">An Oracle Concerning Cush</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"ISA.18.1\"><span class=\"label\">1</span><span class=\"content\">Ah, land of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 8:8; 17:12] </span></span><span class=\"content\">whirring wings</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"ISA.18.1\"><span class=\"content\">that is beyond the rivers of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Kgs. 19:9</span></span><span class=\"content\">Cush,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">18:1 </span><span class=\"ft\">Probably </span><span class=\"fq\">Nubia</span></span></span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"ISA.18.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"ISA.18.2\"><span class=\"label\">2</span><span class=\"content\">which </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 30:4 </span></span><span class=\"content\">sends ambassadors by the sea,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ISA.18.2\"><span class=\"content\">in vessels of papyrus on the waters!</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ISA.18.2\"><span class=\"content\">Go, you swift messengers,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ISA.18.2\"><span class=\"content\">to a nation </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 7 </span></span><span class=\"content\">tall and smooth,</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ISA.18.2\"><span class=\"content\">to a people feared near and far,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ISA.18.2\"><span class=\"content\">a nation </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Sam. 8:2]</span></span><span class=\"content\">mighty and conquering,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"ISA.18.2\"><span class=\"content\">whose land the rivers divide.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"ISA.18.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"ISA.18.3\"><span class=\"label\">3</span><span class=\"content\">All you inhabitants of the world,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"ISA.18.3\"><span class=\"content\">you who dwell on the earth,</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"ISA.18.3\"><span class=\"content\">when </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 5:26</span></span><span class=\"content\">a signal is raised on the mountains, look!</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"ISA.18.3\"><span class=\"content\">When a trumpet is blown, hear!</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"ISA.18.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"ISA.18.4\"><span class=\"label\">4</span><span class=\"content\">For thus the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> said to me:</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"ISA.18.4\"><span class=\"content\">&#8220;I will quietly look </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 11:4</span></span><span class=\"content\">from my dwelling</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"ISA.18.4\"><span class=\"content\">like clear heat in sunshine,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"ISA.18.4\"><span class=\"content\">like a cloud of dew in the heat of harvest.&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"ISA.18.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"ISA.18.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ezek. 31:3, 12, 13]  </span></span><span class=\"content\">For before the harvest, when the blossom is over,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ISA.18.5\"><span class=\"content\">and the flower becomes a ripening grape,</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"ISA.18.5\"><span class=\"content\">he cuts off the shoots with pruning hooks,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"ISA.18.5\"><span class=\"content\">and the spreading branches he lops off and clears away.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"ISA.18.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"ISA.18.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [See ver. 5 above]  </span></span><span class=\"content\">They shall all of them be left</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ISA.18.6\"><span class=\"content\">to the birds of prey of the mountains</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ISA.18.6\"><span class=\"content\">and to the beasts of the earth.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"ISA.18.6\"><span class=\"content\">And the birds of prey will summer on them,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"ISA.18.6\"><span class=\"content\">and all the beasts of the earth will winter on them.</span></span></div><div class=\"b\"></div><div class=\"p\"><span class=\"verse v6\" data-usfm=\"ISA.18.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"ISA.18.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 68:31   </span></span><span class=\"content\">At that time tribute will be brought to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> of hosts</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ISA.18.7\"><span class=\"content\">from a people </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 2 </span></span><span class=\"content\">tall and smooth,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ISA.18.7\"><span class=\"content\">from a people feared near and far,</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"ISA.18.7\"><span class=\"content\">a nation mighty and conquering,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"ISA.18.7\"><span class=\"content\">whose land the rivers divide,</span></span></div><div class=\"b\"></div><div class=\"m\"><span class=\"verse v7\" data-usfm=\"ISA.18.7\"><span class=\"content\">to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 25:10] </span></span><span class=\"content\">Mount Zion, the place of the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Sam. 7:13</span></span><span class=\"content\">name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> of hosts.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["ISA.19"], "human": "Isaiah 19", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["ISA.17"], "human": "Isaiah 17", "toc": true, "version_id": 59}, "reference": {"usfm": ["ISA.18"], "human": "Isaiah 18", "version_id": 59}}, "usfm": "ISA.18.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u0