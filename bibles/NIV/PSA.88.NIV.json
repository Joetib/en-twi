{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.88.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/88-7e713a7b68d421ad3ac02b5e179e6fa3.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/88-7e713a7b68d421ad3ac02b5e179e6fa3.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch88\" data-usfm=\"PSA.88\">\n            <div class=\"label\">88</div><div class=\"s1\"><span class=\"heading\">I Cry Out Day and Night Before You</span></div><div class=\"d\"><span class=\"content\">A Song. A Psalm of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 42, title </span></span><span class=\"content\">the Sons of Korah. To the choirmaster: according to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 53, title </span></span><span class=\"content\">Mahalath Leannoth. A Maskil</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">88:1 </span><span class=\"ft\">Probably musical or liturgical terms</span></span></span><span class=\"content\"> of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Kgs. 4:31; 1 Chr. 2:6</span></span><span class=\"content\">Heman the Ezrahite.</span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.88.1\"><span class=\"label\">1</span><span class=\"content\">O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 24:5 </span></span><span class=\"content\">God of my salvation,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.88.1\"><span class=\"content\">I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 22:2; Luke 18:7</span></span><span class=\"content\">cry out day and night before you.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.88.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.88.2\"><span class=\"label\">2</span><span class=\"content\">Let my prayer come before you;</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.88.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 31:2  </span></span><span class=\"content\">incline your ear to my cry!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.88.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.88.3\"><span class=\"label\">3</span><span class=\"content\">For my soul is full of troubles,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.88.3\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 107:18] </span></span><span class=\"content\">my life draws near to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 16:10</span></span><span class=\"content\">Sheol.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.88.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.88.4\"><span class=\"label\">4</span><span class=\"content\">I am counted among those who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 28:1</span></span><span class=\"content\">go down to the pit;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.88.4\"><span class=\"content\">I am a man who has no strength,</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.88.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.88.5\"><span class=\"label\">5</span><span class=\"content\">like one set loose among the dead,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.88.5\"><span class=\"content\">like the slain that lie in the grave,</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.88.5\"><span class=\"content\">like those whom </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 31:12] </span></span><span class=\"content\">you remember no more,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.88.5\"><span class=\"content\">for they are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 53:8</span></span><span class=\"content\">cut off from your hand.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.88.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.88.6\"><span class=\"label\">6</span><span class=\"content\">You have put me in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 63:9] </span></span><span class=\"content\">the depths of the pit,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.88.6\"><span class=\"content\">in the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 12, 18; Ps. 143:3; Lam. 3:6 </span></span><span class=\"content\">regions dark and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 69:15</span></span><span class=\"content\">deep.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.88.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.88.7\"><span class=\"label\">7</span><span class=\"content\">Your wrath </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 32:4] </span></span><span class=\"content\">lies heavy upon me,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.88.7\"><span class=\"content\">and you overwhelm me with </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 42:7</span></span><span class=\"content\">all your waves. </span><span class=\"qs\"><span class=\"content\">Selah</span></span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.88.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.88.8\"><span class=\"label\">8</span><span class=\"content\">You have caused </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 18; Ps. 142:4; See Job 19:13 </span></span><span class=\"content\">my companions to shun me;</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.88.8\"><span class=\"content\">you have made me </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 30:10 </span></span><span class=\"content\">a horror</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">88:8 </span><span class=\"ft\">Or </span><span class=\"fq\">an abomination</span></span></span><span class=\"content\"> to them.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PSA.88.8\"><span class=\"content\">I am </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jer. 32:2</span></span><span class=\"content\">shut in so that I cannot escape;</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.88.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PSA.88.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 6:7]   </span></span><span class=\"content\">my eye grows dim through sorrow.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.88.9\"><span class=\"content\">Every day I call upon you, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PSA.88.9\"><span class=\"content\">I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Job 11:13</span></span><span class=\"content\">spread out my hands to you.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.88.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PSA.88.10\"><span class=\"label\">10</span><span class=\"content\">Do you work wonders for the dead?</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PSA.88.10\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 6:5]  </span></span><span class=\"content\">Do the departed rise up to praise you? </span><span class=\"qs\"><span class=\"content\">Selah</span></span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PSA.88.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PSA.88.11\"><span class=\"label\">11</span><span class=\"content\">Is your steadfast love declared in the grave,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.88.11\"><span class=\"content\">or your faithfulness in Abaddon?</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.88.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PSA.88.12\"><span class=\"label\">12</span><span class=\"content\">Are your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 89:5 </span></span><span class=\"content\">wonders known in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 6; Job 10:21 </span></span><span class=\"content\">the darkness,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.88.12\"><span class=\"content\">or your righteousness in the land of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Eccles. 9:5]</span></span><span class=\"content\">forgetfulness?</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.88.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PSA.88.13\"><span class=\"label\">13</span><span class=\"content\">But I, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, cry </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 30:2 </span></span><span class=\"content\">to you;</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.88.13\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 5:3  </span></span><span class=\"content\">in the morning my prayer comes before you.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PSA.88.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PSA.88.14\"><span class=\"label\">14</span><span class=\"content\">O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, why </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 44:9 </span></span><span class=\"content\">do you cast my soul away?</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.88.14\"><span class=\"content\">Why </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Job 13:24</span></span><span class=\"content\">do you hide your face from me?</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.88.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PSA.88.15\"><span class=\"label\">15</span><span class=\"content\">Afflicted and close to death from my youth up,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PSA.88.15\"><span class=\"content\">I suffer your terrors; I am helpless.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">88:15 </span><span class=\"ft\">The meaning of the Hebrew word is uncertain</span></span></span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PSA.88.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PSA.88.16\"><span class=\"label\">16</span><span class=\"content\">Your wrath has swept over me;</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PSA.88.16\"><span class=\"content\">your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Job 6:4; 9:34</span></span><span class=\"content\">dreadful assaults destroy me.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PSA.88.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PSA.88.17\"><span class=\"label\">17</span><span class=\"content\">They </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 118:10-12 </span></span><span class=\"content\">surround me like a flood </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 86:3 </span></span><span class=\"content\">all day long;</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PSA.88.17\"><span class=\"content\">they </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 18:4; 22:16; [Ps. 118:10]</span></span><span class=\"content\">close in on me together.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PSA.88.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PSA.88.18\"><span class=\"label\">18</span><span class=\"content\">You have caused </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Job 19:13, 14</span></span><span class=\"content\">my beloved and my friend to shun me;</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PSA.88.18\"><span class=\"content\">my companions have become darkness.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">88:18 </span><span class=\"ft\">Or </span><span class=\"fq\">darkness has become my only companion</span></span></span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PSA.89"], "human": "Psalm 89", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PSA.87"], "human": "Psalm 87", "toc": true, "vers