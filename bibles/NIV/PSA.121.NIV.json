{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.121.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/121-112e617caed668d676890cc3aabd5bde.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/121-112e617caed668d676890cc3aabd5bde.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch121\" data-usfm=\"PSA.121\">\n            <div class=\"label\">121</div><div class=\"s1\"><span class=\"heading\">My Help Comes from the </span><span class=\"nd\"><span class=\"heading\">Lord</span></span></div><div class=\"d\"><span class=\"content\">A Song of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See Ps. 120, title]</span></span><span class=\"content\">Ascents.</span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.121.1\"><span class=\"label\">1</span><span class=\"content\">I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 123:1 </span></span><span class=\"content\">lift up my eyes to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 87:1; 133:3; Jer. 3:23; [Ps. 48:1]</span></span><span class=\"content\">the hills.</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.121.1\"><span class=\"content\">From where does my help come?</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.121.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.121.2\"><span class=\"label\">2</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 124:8; [Ps. 20:2]   </span></span><span class=\"content\">My help comes from the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.121.2\"><span class=\"content\">who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 115:15</span></span><span class=\"content\">made heaven and earth.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.121.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.121.3\"><span class=\"label\">3</span><span class=\"content\">He will not </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 66:9; Prov. 3:23, 26; [1 Sam. 2:9] </span></span><span class=\"content\">let your foot be moved;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.121.3\"><span class=\"content\">he who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 41:2; 127:1; [Isa. 27:3]; See Ps. 97:10</span></span><span class=\"content\">keeps you will not slumber.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.121.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.121.4\"><span class=\"label\">4</span><span class=\"content\">Behold, he who keeps Israel</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.121.4\"><span class=\"content\">will neither slumber nor sleep.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.121.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.121.5\"><span class=\"label\">5</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is your keeper;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.121.5\"><span class=\"content\">the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 91:1 </span></span><span class=\"content\">shade on your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 16:8</span></span><span class=\"content\">right hand.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.121.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.121.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 49:10; Rev. 7:16   </span></span><span class=\"content\">The sun shall not </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Kgs. 4:19; Jonah 4:8</span></span><span class=\"content\">strike you by day,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.121.6\"><span class=\"content\">nor the moon by night.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.121.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.121.7\"><span class=\"label\">7</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 3 above]</span></span><span class=\"content\">keep you from all evil;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.121.7\"><span class=\"content\">he will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 3 above]</span></span><span class=\"content\">keep your life.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.121.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.121.8\"><span class=\"label\">8</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> will keep</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.121.8\"><span class=\"content\">your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 28:6; 31:2; [Num. 27:17; 1 Sam. 29:6; 1 Kgs. 3:7; Acts 1:21]</span></span><span class=\"content\">going out and your coming in</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.121.8\"><span class=\"content\">from this time forth and forevermore.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PSA.122"], "human": "Psalm 122", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PSA.120"], "human": "Psalm 120", "toc": true, "version_id": 59}, "reference": {"usfm": ["PSA.121"], "human": "Psalm 121", "version_id": 59}}, "usfm": "PSA.121.NI