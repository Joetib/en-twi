{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.105.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/105-36f3c7a641118e8b01d7a455b65e06dc.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/105-36f3c7a641118e8b01d7a455b65e06dc.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch105\" data-usfm=\"PSA.105\">\n            <div class=\"label\">105</div><div class=\"s1\"><span class=\"heading\">Tell of All His Wondrous Works</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.105.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 106:1; 1 Chr. 16:34; Isa. 12:4; For ver. 1-15, see 1 Chr. 16:8-22   </span></span><span class=\"content\">Oh give thanks to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">; </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 99:6; 116:13, 17; [Gen. 4:26] </span></span><span class=\"content\">call upon his name;</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.105.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 145:4, 5, 11, 12  </span></span><span class=\"content\">make known his deeds among the peoples!</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.105.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.105.2\"><span class=\"label\">2</span><span class=\"content\">Sing to him, sing praises to him;</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.105.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 77:12\n        </span></span><span class=\"content\">tell of all his wondrous works!</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.105.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.105.3\"><span class=\"label\">3</span><span class=\"content\">Glory in his holy name;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.105.3\"><span class=\"content\">let the hearts of those who seek the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> rejoice!</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.105.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.105.4\"><span class=\"label\">4</span><span class=\"content\">Seek the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> and his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 78:61 </span></span><span class=\"content\">strength;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.105.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 27:8]  </span></span><span class=\"content\">seek his presence continually!</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.105.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.105.5\"><span class=\"label\">5</span><span class=\"content\">Remember the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 77:11; See Ps. 72:18 </span></span><span class=\"content\">wondrous works that he has done,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.105.5\"><span class=\"content\">his miracles, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 6:6; 7:4</span></span><span class=\"content\">the judgments he uttered,</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.105.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.105.6\"><span class=\"label\">6</span><span class=\"content\">O offspring of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 42 </span></span><span class=\"content\">Abraham, his servant,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.105.6\"><span class=\"content\">children of Jacob, his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 43; Ps. 106:5; [Ps. 135:4]</span></span><span class=\"content\">chosen ones!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.105.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.105.7\"><span class=\"label\">7</span><span class=\"content\">He is the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> our God;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.105.7\"><span class=\"content\">his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 26:9</span></span><span class=\"content\">judgments are in all the earth.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.105.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.105.8\"><span class=\"label\">8</span><span class=\"content\">He </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 42; Ps. 106:45; 111:5; Luke 1:72 </span></span><span class=\"content\">remembers his covenant forever,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.105.8\"><span class=\"content\">the word that he commanded, for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 7:9</span></span><span class=\"content\">a thousand generations,</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PSA.105.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PSA.105.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Gen. 17:2; See Gen. 22:15-18   </span></span><span class=\"content\">the covenant that he made with Abraham,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PSA.105.9\"><span class=\"content\">his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 26:3</span></span><span class=\"content\">sworn promise to Isaac,</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.105.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PSA.105.10\"><span class=\"label\">10</span><span class=\"content\">which he confirmed to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 28:13, 14; 35:11, 12</span></span><span class=\"content\">Jacob as a statute,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PSA.105.10\"><span class=\"content\">to Israel as an everlasting covenant,</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PSA.105.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PSA.105.11\"><span class=\"label\">11</span><span class=\"content\">saying, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 13:15; 15:18 </span></span><span class=\"content\">&#8220;To you I will give the land of Canaan</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.105.11\"><span class=\"content\">as </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 78:55</span></span><span class=\"content\">your portion for an inheritance.&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.105.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PSA.105.12\"><span class=\"label\">12</span><span class=\"content\">When they were </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 34:30; Deut. 7:7; 26:5 </span></span><span class=\"content\">few in number,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.105.12\"><span class=\"content\">of little account, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Heb. 11:9</span></span><span class=\"content\">sojourners in it,</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.105.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PSA.105.13\"><span class=\"label\">13</span><span class=\"content\">wandering from nation to nation,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.105.13\"><span class=\"content\">from one kingdom to another people,</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PSA.105.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PSA.105.14\"><span class=\"label\">14</span><span class=\"content\">he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 35:5] </span></span><span class=\"content\">allowed no one to oppress them;</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.105.14\"><span class=\"content\">he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 12:17; 20:3</span></span><span class=\"content\">rebuked kings on their account,</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.105.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PSA.105.15\"><span class=\"label\">15</span><span class=\"content\">saying, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 20:6, 7; [Gen. 26:11]</span></span><span class=\"content\">&#8220;Touch not my anointed ones,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PSA.105.15\"><span class=\"content\">do my prophets no harm!&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PSA.105.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PSA.105.16\"><span class=\"label\">16</span><span class=\"content\">When he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 41:54; [2 Kgs. 8:1; Hag. 1:11] </span></span><span class=\"content\">summoned a famine on the land</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PSA.105.16\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Lev. 26:26; Isa. 3:1; Ezek. 4:16; [Ps. 104:15]</span></span><span class=\"content\">broke all supply</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">105:16 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">staff</span></span></span><span class=\"content\"> of bread,</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PSA.105.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PSA.105.17\"><span class=\"label\">17</span><span class=\"content\">he had </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 45:5; 50:20 </span></span><span class=\"content\">sent a man ahead of them,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PSA.105.17\"><span class=\"content\">Joseph, who was </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 37:28, 36; Acts 7:9</span></span><span class=\"content\">sold as a slave.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PSA.105.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PSA.105.18\"><span class=\"label\">18</span><span class=\"content\">His </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 39:20]</span></span><span class=\"content\">feet were hurt with fetters;</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PSA.105.18\"><span class=\"content\">his neck was put in a collar of iron;</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"PSA.105.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"PSA.105.19\"><span class=\"label\">19</span><span class=\"content\">until </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 40:20, 21; 41:53, 54 </span></span><span class=\"content\">what he had said came to pass,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"PSA.105.19\"><span class=\"content\">the word of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Judg. 7:4]</span></span><span class=\"content\">tested him.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"PSA.105.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"PSA.105.20\"><span class=\"label\">20</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Gen. 41:14   </span></span><span class=\"content\">The king sent and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 146:7</span></span><span class=\"content\">released him;</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"PSA.105.20\"><span class=\"content\">the ruler of the peoples set him free;</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"PSA.105.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"PSA.105.21\"><span class=\"label\">21</span><span class=\"content\">he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 41:40</span></span><span class=\"content\">made him lord of his house</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"PSA.105.21\"><span class=\"content\">and ruler of all his possessions,</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"PSA.105.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"PSA.105.22\"><span class=\"label\">22</span><span class=\"content\">to bind</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">105:22 </span><span class=\"ft\">Septuagint, Syriac, Jerome </span><span class=\"fq\">instruct</span></span></span><span class=\"content\"> his princes at his pleasure</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"PSA.105.22\"><span class=\"content\">and to teach his elders wisdom.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"PSA.105.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"PSA.105.23\"><span class=\"label\">23</span><span class=\"content\">Then </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 46:6; Acts 7:15 </span></span><span class=\"content\">Israel came to Egypt;</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"PSA.105.23\"><span class=\"content\">Jacob </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Acts 13:17 </span></span><span class=\"content\">sojourned in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 106:22; [Ps. 78:51]</span></span><span class=\"content\">the land of Ham.</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"PSA.105.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"PSA.105.24\"><span class=\"label\">24</span><span class=\"content\">And the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 1:7; Deut. 26:5</span></span><span class=\"content\">made his people very fruitful</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"PSA.105.24\"><span class=\"content\">and made them stronger than their foes.</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"PSA.105.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"PSA.105.25\"><span class=\"label\">25</span><span class=\"content\">He </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ex. 9:12; Rom. 11:8]; See Ex. 1:8-14 </span></span><span class=\"content\">turned their hearts to hate his people,</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"PSA.105.25\"><span class=\"content\">to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 1:10; Acts 7:19</span></span><span class=\"content\">deal craftily with his servants.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"PSA.105.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"PSA.105.26\"><span class=\"label\">26</span><span class=\"content\">He </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 3:10; 4:12 </span></span><span class=\"content\">sent Moses, his servant,</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"PSA.105.26\"><span class=\"content\">and Aaron, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Num. 16:5; 17:5</span></span><span class=\"content\">whom he had chosen.</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"PSA.105.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"PSA.105.27\"><span class=\"label\">27</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    For ver. 27-36, see Ps. 78:43-51   </span></span><span class=\"content\">They performed his signs among them</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"PSA.105.27\"><span class=\"content\">and miracles in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 23 above]</span></span><span class=\"content\">the land of Ham.</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"PSA.105.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"PSA.105.28\"><span class=\"label\">28</span><span class=\"content\">He </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 10:21-23 </span></span><span class=\"content\">sent darkness, and made the land dark;</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"PSA.105.28\"><span class=\"content\">they </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 99:7</span></span><span class=\"content\">did not rebel</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">105:28 </span><span class=\"ft\">Septuagint, Syriac omit </span><span class=\"fq\">not</span></span></span><span class=\"content\"> against his words.</span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"PSA.105.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"PSA.105.29\"><span class=\"label\">29</span><span class=\"content\">He turned their waters into blood</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"PSA.105.29\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 7:21</span></span><span class=\"content\">caused their fish to die.</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"PSA.105.29\"><span class=\"content\">  </span></span><span class=\"verse v30\" data-usfm=\"PSA.105.30\"><span class=\"label\">30</span><span class=\"content\">Their land swarmed with frogs,</span></span></div><div class=\"q2\"><span class=\"verse v30\" data-usfm=\"PSA.105.30\"><span class=\"content\">even in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 8:3</span></span><span class=\"content\">the chambers of their kings.</span></span></div><div class=\"q1\"><span class=\"verse v30\" data-usfm=\"PSA.105.30\"><span class=\"content\">  </span></span><span class=\"verse v31\" data-usfm=\"PSA.105.31\"><span class=\"label\">31</span><span class=\"content\">He spoke, and there came </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 8:21 </span></span><span class=\"content\">swarms of flies,</span></span></div><div class=\"q2\"><span class=\"verse v31\" data-usfm=\"PSA.105.31\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ex. 8:16\n        </span></span><span class=\"content\">and gnats throughout their country.</span></span></div><div class=\"q1\"><span class=\"verse v31\" data-usfm=\"PSA.105.31\"><span class=\"content\">  </span></span><span class=\"verse v32\" data-usfm=\"PSA.105.32\"><span class=\"label\">32</span><span class=\"content\">He gave them hail for rain,</span></span></div><div class=\"q2\"><span class=\"verse v32\" data-usfm=\"PSA.105.32\"><span class=\"content\">and fiery </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 9:23</span></span><span class=\"content\">lightning bolts through their land.</span></span></div><div class=\"q1\"><span class=\"verse v32\" data-usfm=\"PSA.105.32\"><span class=\"content\">  </span></span><span class=\"verse v33\" data-usfm=\"PSA.105.33\"><span class=\"label\">33</span><span class=\"content\">He struck down their vines and fig trees,</span></span></div><div class=\"q2\"><span class=\"verse v33\" data-usfm=\"PSA.105.33\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 9:25</span></span><span class=\"content\">shattered the trees of their country.</span></span></div><div class=\"q1\"><span class=\"verse v33\" data-usfm=\"PSA.105.33\"><span class=\"content\">  </span></span><span class=\"verse v34\" data-usfm=\"PSA.105.34\"><span class=\"label\">34</span><span class=\"content\">He spoke, and the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ex. 10:12-15</span></span><span class=\"content\">locusts came,</span></span></div><div class=\"q2\"><span class=\"verse v34\" data-usfm=\"PSA.105.34\"><span class=\"content\">young locusts without number,</span></span></div><div class=\"q1\"><span class=\"verse v34\" data-usfm=\"PSA.105.34\"><span class=\"content\">  </span></span><span class=\"verse v35\" data-usfm=\"PSA.105.35\"><span class=\"label\">35</span><span class=\"content\">which devoured all the vegetation in their land</span></span></div><div class=\"q2\"><span class=\"verse v35\" data-usfm=\"PSA.105.35\"><span class=\"content\">and ate up the fruit of their ground.</span></span></div><div class=\"q1\"><span class=\"verse v35\" data-usfm=\"PSA.105.35\"><span class=\"content\">  </span></span><span class=\"verse v36\" data-usfm=\"PSA.105.36\"><span class=\"label\">36</span><span class=\"content\">He </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 78:51</span></span><span class=\"content\">struck down all the firstborn in their land,</span></span></div><div class=\"q2\"><span class=\"verse v36\" data-usfm=\"PSA.105.36\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 78:51  </span></span><span class=\"content\">the firstfruits of all their strength.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v36\" data-usfm=\"PSA.105.36\"><span class=\"content\">  </span></span><span class=\"verse v37\" data-usfm=\"PSA.105.37\"><span class=\"label\">37</span><span class=\"content\">Then he brought out Israel with </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 12:35, 36</span></span><span class=\"content\">silver and gold,</span></span></div><div class=\"q2\"><span class=\"verse v37\" data-usfm=\"PSA.105.37\"><span class=\"content\">and there was none among his tribes who stumbled.</span></span></div><div class=\"q1\"><span class=\"verse v37\" data-usfm=\"PSA.105.37\"><span class=\"content\">  </span></span><span class=\"verse v38\" data-usfm=\"PSA.105.38\"><span class=\"label\">38</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ex. 12:23   </span></span><span class=\"content\">Egypt was glad when they departed,</span></span></div><div class=\"q2\"><span class=\"verse v38\" data-usfm=\"PSA.105.38\"><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 15:16</span></span><span class=\"content\">dread of them had fallen upon it.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v38\" data-usfm=\"PSA.105.38\"><span class=\"content\">  </span></span><span class=\"verse v39\" data-usfm=\"PSA.105.39\"><span class=\"label\">39</span><span class=\"content\">He </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Job 36:20; Isa. 4:5]; See Ex. 13:21</span></span><span class=\"content\">spread a cloud for a covering,</span></span></div><div class=\"q2\"><span class=\"verse v39\" data-usfm=\"PSA.105.39\"><span class=\"content\">and fire to give light by night.</span></span></div><div class=\"q1\"><span class=\"verse v39\" data-usfm=\"PSA.105.39\"><span class=\"content\">  </span></span><span class=\"verse v40\" data-usfm=\"PSA.105.40\"><span class=\"label\">40</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 78:18, 27   </span></span><span class=\"content\">They asked, and he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 16:13 </span></span><span class=\"content\">brought quail,</span></span></div><div class=\"q2\"><span class=\"verse v40\" data-usfm=\"PSA.105.40\"><span class=\"content\">and gave them </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 78:24, 25; [John 6:31]</span></span><span class=\"content\">bread from heaven in abundance.</span></span></div><div class=\"q1\"><span class=\"verse v40\" data-usfm=\"PSA.105.40\"><span class=\"content\">  </span></span><span class=\"verse v41\" data-usfm=\"PSA.105.41\"><span class=\"label\">41</span><span class=\"content\">He opened the rock, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 78:15 </span></span><span class=\"content\">water gushed out;</span></span></div><div class=\"q2\"><span class=\"verse v41\" data-usfm=\"PSA.105.41\"><span class=\"content\">it flowed through </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 63:1</span></span><span class=\"content\">the desert like a river.</span></span></div><div class=\"q1\"><span class=\"verse v41\" data-usfm=\"PSA.105.41\"><span class=\"content\">  </span></span><span class=\"verse v42\" data-usfm=\"PSA.105.42\"><span class=\"label\">42</span><span class=\"content\">For he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 8, 9; Ex. 2:24 </span></span><span class=\"content\">remembered his holy promise,</span></span></div><div class=\"q2\"><span class=\"verse v42\" data-usfm=\"PSA.105.42\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 15:14]; See ver. 6</span></span><span class=\"content\">Abraham, his servant.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v42\" data-usfm=\"PSA.105.42\"><span class=\"content\">  </span></span><span class=\"verse v43\" data-usfm=\"PSA.105.43\"><span class=\"label\">43</span><span class=\"content\">So he brought his people out with joy,</span></span></div><div class=\"q2\"><span class=\"verse v43\" data-usfm=\"PSA.105.43\"><span class=\"content\">his </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 42 above] </span></span><span class=\"content\">chosen ones with </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 35:10]; See Ex. 15:1-21</span></span><span class=\"content\">singing.</span></span></div><div class=\"q1\"><span class=\"verse v43\" data-usfm=\"PSA.105.43\"><span class=\"content\">  </span></span><span class=\"verse v44\" data-usfm=\"PSA.105.44\"><span class=\"label\">44</span><span class=\"content\">And he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Josh. 24:13; [Ps. 78:55]</span></span><span class=\"content\">gave them the lands of the nations,</span></span></div><div class=\"q2\"><span class=\"verse v44\" data-usfm=\"PSA.105.44\"><span class=\"content\">and they took possession of the fruit of the peoples&#8217; toil,</span></span></div><div class=\"q1\"><span class=\"verse v44\" data-usfm=\"PSA.105.44\"><span class=\"content\">  </span></span><span class=\"verse v45\" data-usfm=\"PSA.105.45\"><span class=\"label\">45</span><span class=\"content\">that they might </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Deut. 4:1, 40 </span></span><span class=\"content\">keep his statutes</span></span></div><div class=\"q2\"><span class=\"verse v45\" data-usfm=\"PSA.105.45\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 78:7 </span></span><span class=\"content\">observe his laws.</span></span></div><div class=\"q1\"><span class=\"verse v45\" data-usfm=\"PSA.105.45\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 104:35  </span></span><span class=\"content\">Praise the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u0