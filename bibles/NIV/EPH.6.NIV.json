{"pageProps": {"params": {"versionId": "59", "usfm": "EPH.6.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/EPH/6-31c64a455aad1ad5dee56fa2d3395b06.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/EPH/6-31c64a455aad1ad5dee56fa2d3395b06.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}, {"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1668/32k/EPH/6-d1b72823e98a073f29c0883f79dab559.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1668/m4a/32k/EPH/6-d1b72823e98a073f29c0883f79dab559.m3u8?version_id=59"}, "id": 1668, "version_id": 59, "title": "Living Water Bible - ESV Music Project by Lutheran Bible Translators", "timing_available": false, "dramatized": true, "default": false}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkEPH\">\n        <div class=\"chapter ch6\" data-usfm=\"EPH.6\">\n            <div class=\"label\">6</div><div class=\"s1\"><span class=\"heading\">Children and Parents</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"EPH.6.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Prov. 1:8; 6:20; 23:22  </span></span><span class=\"content\">Children, obey your parents in the Lord, for this is right. </span></span><span class=\"verse v2\" data-usfm=\"EPH.6.2\"><span class=\"label\">2</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Cited from Ex. 20:12</span></span><span class=\"content\">&#8220;Honor your father and mother&#8221; (this is the first commandment with a promise), </span></span><span class=\"verse v3\" data-usfm=\"EPH.6.3\"><span class=\"label\">3</span><span class=\"content\">&#8220;that it may go well with you and that you may live long in the land.&#8221; </span></span><span class=\"verse v4\" data-usfm=\"EPH.6.4\"><span class=\"label\">4</span><span class=\"content\">Fathers, do not provoke your children to anger, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 18:19; Deut. 4:9; 6:7; 11:19; Ps. 78:4; Prov. 19:18; 22:6; 29:17; [2 Tim. 3:15]</span></span><span class=\"content\">but bring them up in the discipline and instruction of the Lord.</span></span></div><div class=\"s1\"><span class=\"heading\">Bondservants and Masters</span></div><div class=\"p\"><span class=\"verse v4\" data-usfm=\"EPH.6.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"EPH.6.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See 1 Pet. 2:18   </span></span><span class=\"content\">Bondservants,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:5 </span><span class=\"ft\">For the contextual rendering of the Greek word </span><span class=\"fq\">doulos</span><span class=\"ft\">, see Preface; also verse 6; likewise for </span><span class=\"fq\">bondservant </span><span class=\"ft\">in verse 8</span></span></span><span class=\"content\"> obey your earthly masters</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:5 </span><span class=\"ft\">Or </span><span class=\"fq\">your masters according to the flesh</span></span></span><span class=\"content\"> with fear and trembling, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Cor. 11:3] </span></span><span class=\"content\">with a sincere heart, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 5:22]</span></span><span class=\"content\">as you would Christ, </span></span><span class=\"verse v6\" data-usfm=\"EPH.6.6\"><span class=\"label\">6</span><span class=\"content\">not by the way of eye-service, as </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Gal. 1:10</span></span><span class=\"content\">people-pleasers, but as bondservants of Christ, doing the will of God from the heart, </span></span><span class=\"verse v7\" data-usfm=\"EPH.6.7\"><span class=\"label\">7</span><span class=\"content\">rendering service with a good will as to the Lord and not to man, </span></span><span class=\"verse v8\" data-usfm=\"EPH.6.8\"><span class=\"label\">8</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 62:12 </span></span><span class=\"content\">knowing that whatever good anyone does, this he will receive back from the Lord, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gal. 3:28; Col. 3:11</span></span><span class=\"content\">whether he is a bondservant or is free. </span></span><span class=\"verse v9\" data-usfm=\"EPH.6.9\"><span class=\"label\">9</span><span class=\"content\">Masters, do the same to them, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Lev. 25:43 </span></span><span class=\"content\">and stop your threatening, knowing that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">John 13:13; [Job 31:13-15] </span></span><span class=\"content\">he who is both their Master</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:9 </span><span class=\"ft\">Greek </span><span class=\"fq\">Lord</span></span></span><span class=\"content\"> and yours is in heaven, and that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Deut. 10:17</span></span><span class=\"content\">there is no partiality with him.</span></span></div><div class=\"s1\"><span class=\"heading\">The Whole Armor of God</span></div><div class=\"p\"><span class=\"verse v9\" data-usfm=\"EPH.6.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"EPH.6.10\"><span class=\"label\">10</span><span class=\"content\">Finally, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Rom. 4:20 (Gk.); 2 Tim. 2:1; [1 John 2:14]; See ch. 3:16 </span></span><span class=\"content\">be strong in the Lord and in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:19</span></span><span class=\"content\">the strength of his might. </span></span><span class=\"verse v11\" data-usfm=\"EPH.6.11\"><span class=\"label\">11</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 14; Job 29:14; See Rom. 13:12 </span></span><span class=\"content\">Put on </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 13; [2 Cor. 10:4] </span></span><span class=\"content\">the whole armor of God, that you may be able to stand against </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:14</span></span><span class=\"content\">the schemes of the devil. </span></span><span class=\"verse v12\" data-usfm=\"EPH.6.12\"><span class=\"label\">12</span><span class=\"content\">For </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Cor. 9:25 </span></span><span class=\"content\">we do not wrestle against flesh and blood, but against </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:21 </span></span><span class=\"content\">the rulers, against the authorities, against </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 2:2 </span></span><span class=\"content\">the cosmic powers over </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 22:53; Col. 1:13 </span></span><span class=\"content\">this present darkness, against </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 3:10] </span></span><span class=\"content\">the spiritual forces of evil </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:3</span></span><span class=\"content\">in the heavenly places. </span></span><span class=\"verse v13\" data-usfm=\"EPH.6.13\"><span class=\"label\">13</span><span class=\"content\">Therefore </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Pet. 4:1] </span></span><span class=\"content\">take up the whole armor of God, that you may be able to withstand in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 5:16</span></span><span class=\"content\">the evil day, and having done all, to stand firm. </span></span><span class=\"verse v14\" data-usfm=\"EPH.6.14\"><span class=\"label\">14</span><span class=\"content\">Stand therefore, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Pet. 1:13; [Isa. 11:5]; See Luke 12:35 </span></span><span class=\"content\">having fastened on the belt of truth, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 59:17; 1 Thess. 5:8; [Isa. 61:10; 2 Cor. 6:7]</span></span><span class=\"content\">having put on the breastplate of righteousness, </span></span><span class=\"verse v15\" data-usfm=\"EPH.6.15\"><span class=\"label\">15</span><span class=\"content\">and, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 52:7; Rom. 10:15; [Ex. 12:11]</span></span><span class=\"content\">as shoes for your feet, having put on the readiness given by the gospel of peace. </span></span><span class=\"verse v16\" data-usfm=\"EPH.6.16\"><span class=\"label\">16</span><span class=\"content\">In all circumstances take up </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 John 5:4] </span></span><span class=\"content\">the shield of faith, with which you can extinguish all </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 120:4] </span></span><span class=\"content\">the flaming darts of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Matt. 13:19</span></span><span class=\"content\">the evil one; </span></span><span class=\"verse v17\" data-usfm=\"EPH.6.17\"><span class=\"label\">17</span><span class=\"content\">and take </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 14 above] </span></span><span class=\"content\">the helmet of salvation, and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Heb. 4:12; [Isa. 49:2; Hos. 6:5; 2 Cor. 6:7]</span></span><span class=\"content\">the sword of the Spirit, which is the word of God, </span></span><span class=\"verse v18\" data-usfm=\"EPH.6.18\"><span class=\"label\">18</span><span class=\"content\">praying </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 18:1 </span></span><span class=\"content\">at all times </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jude 20; See Rom. 8:26 </span></span><span class=\"content\">in the Spirit, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 4:2-4 </span></span><span class=\"content\">with all prayer and supplication. To that end, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Mark 13:33 </span></span><span class=\"content\">keep alert with all perseverance, making </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Tim. 2:1</span></span><span class=\"content\">supplication for all the saints, </span></span><span class=\"verse v19\" data-usfm=\"EPH.6.19\"><span class=\"label\">19</span><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 4:3; 1 Thess. 5:25; 2 Thess. 3:1; [Isa. 50:4] </span></span><span class=\"content\">also for me, that words may be given to me in opening my mouth </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Acts 4:29 </span></span><span class=\"content\">boldly to proclaim </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:3</span></span><span class=\"content\">the mystery of the gospel, </span></span><span class=\"verse v20\" data-usfm=\"EPH.6.20\"><span class=\"label\">20</span><span class=\"content\">for which I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 2 Cor. 5:20 </span></span><span class=\"content\">am an ambassador </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Acts 28:20</span></span><span class=\"content\">in chains, that I may declare it boldly, as I ought to speak.</span></span></div><div class=\"s1\"><span class=\"heading\">Final Greetings</span></div><div class=\"p\"><span class=\"verse v20\" data-usfm=\"EPH.6.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"EPH.6.21\"><span class=\"label\">21</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Col. 4:7-9   </span></span><span class=\"content\">So that you also may know how I am and what I am doing, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Acts 20:4; 2 Tim. 4:12; Titus 3:12</span></span><span class=\"content\">Tychicus the beloved brother and faithful minister in the Lord will tell you everything. </span></span><span class=\"verse v22\" data-usfm=\"EPH.6.22\"><span class=\"label\">22</span><span class=\"content\">I have sent him to you for this very purpose, that you may know how we are, and that he may </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 2:2</span></span><span class=\"content\">encourage your hearts.</span></span></div><div class=\"p\"><span class=\"verse v22\" data-usfm=\"EPH.6.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"EPH.6.23\"><span class=\"label\">23</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Gal. 6:16; 2 Thess. 3:16; 1 Pet. 5:14   </span></span><span class=\"content\">Peace be to the brothers,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:23 </span><span class=\"ft\">Or </span><span class=\"fq\">brothers and sisters</span></span></span><span class=\"content\"> and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gal. 5:6; 1 Thess. 5:8]</span></span><span class=\"content\">love with faith, from God the Father and the Lord Jesus Christ. </span></span><span class=\"verse v24\" data-usfm=\"EPH.6.24\"><span class=\"label\">24</span><span class=\"content\">Grace be with all who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Cor. 16:22]</span></span><span class=\"content\">love our Lord Jesus Christ with love incorruptible.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PHP.1"], "human": "Philippians 1", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["EPH.5"], "human": "Ephesians 5", "toc": true, "version_id": 59}, "reference": {"usfm": ["EPH.6"], "human": "Ephesians 6", "version_id": 59}}, "usfm": "EPH.6.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p> \r\n<p>Sign up to receive news and updates about the ESV:</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers. \r\nSign up to receive news and updates about the ESV:"}, "reader_footer_url": "https://mailchi.mp/23d38157d688/dfka2d5wyd"}, "_nextI18Next": {"initialI18nStore": {"en": {"common": {"app_download_open": "App Download or Open Button", "average_rating_stars": "Average rating: {{star_count}} stars.", "bible": "Bible", "bibles": "Bibles", "choose_your_language": "Choose your language", "close": "Close", "get_the_app": "Get the app", "download": "Download", "free": "100