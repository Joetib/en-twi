{"pageProps": {"params": {"versionId": "59", "usfm": "PRO.15.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PRO/15-b313b3fba065a637bad80c2785c67069.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PRO/15-b313b3fba065a637bad80c2785c67069.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPRO\">\n        <div class=\"chapter ch15\" data-usfm=\"PRO.15\">\n            <div class=\"label\">15</div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PRO.15.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 25:15]; See Judg. 8:1-3   </span></span><span class=\"content\">A soft answer turns away wrath,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PRO.15.1\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Sam. 25:10-13; 1 Kgs. 12:13-16</span></span><span class=\"content\">a harsh word stirs up anger.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PRO.15.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PRO.15.2\"><span class=\"label\">2</span><span class=\"content\">The tongue of the wise commends knowledge,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PRO.15.2\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 28; ch. 12:23; 13:16; 18:2]</span></span><span class=\"content\">the mouths of fools pour out folly.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PRO.15.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PRO.15.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Job 31:4  </span></span><span class=\"content\">The eyes of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> are in every place,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PRO.15.3\"><span class=\"content\">keeping watch on the evil and the good.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PRO.15.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PRO.15.4\"><span class=\"label\">4</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 12:18]   </span></span><span class=\"content\">A gentle</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">15:4 </span><span class=\"ft\">Or </span><span class=\"fq\">healing</span></span></span><span class=\"content\"> tongue is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 3:18 </span></span><span class=\"content\">a tree of life,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PRO.15.4\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 11:3</span></span><span class=\"content\">perverseness in it breaks the spirit.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PRO.15.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PRO.15.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 10:1]   </span></span><span class=\"content\">A fool </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 107:11] </span></span><span class=\"content\">despises his father&#8217;s instruction,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PRO.15.5\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 13:18]</span></span><span class=\"content\">whoever heeds reproof is prudent.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PRO.15.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PRO.15.6\"><span class=\"label\">6</span><span class=\"content\">In the house of the righteous there is much treasure,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PRO.15.6\"><span class=\"content\">but trouble befalls the income of the wicked.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PRO.15.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PRO.15.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 12:34, 35]  </span></span><span class=\"content\">The lips of the wise spread knowledge;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PRO.15.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Matt. 12:34, 35]  </span></span><span class=\"content\">not so the hearts of fools.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">15:7 </span><span class=\"ft\">Or </span><span class=\"fq\">the hearts of fools are not steadfast</span></span></span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PRO.15.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PRO.15.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 21:27; Eccles. 5:1; Isa. 1:11, 15   </span></span><span class=\"content\">The sacrifice of the wicked is an abomination to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PRO.15.8\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ver. 29]</span></span><span class=\"content\">the prayer of the upright is acceptable to him.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PRO.15.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PRO.15.9\"><span class=\"label\">9</span><span class=\"content\">The way of the wicked is an abomination to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PRO.15.9\"><span class=\"content\">but he loves him </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 21:21; 1 Tim. 6:11; [ch. 11:19]</span></span><span class=\"content\">who pursues righteousness.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PRO.15.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PRO.15.10\"><span class=\"label\">10</span><span class=\"content\">There is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Isa. 1:5] </span></span><span class=\"content\">severe discipline for him who forsakes the way;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PRO.15.10\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 12:1  </span></span><span class=\"content\">whoever hates reproof will die.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PRO.15.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PRO.15.11\"><span class=\"label\">11</span><span class=\"content\">Sheol and Abaddon lie open before the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PRO.15.11\"><span class=\"content\">how much more </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Chr. 6:30; Ps. 44:21; John 2:24; See 1 Sam. 16:7</span></span><span class=\"content\">the hearts of the children of man!</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PRO.15.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PRO.15.12\"><span class=\"label\">12</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 1:1   </span></span><span class=\"content\">A scoffer </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Amos 5:10</span></span><span class=\"content\">does not like to be reproved;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PRO.15.12\"><span class=\"content\">he will not go to the wise.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PRO.15.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PRO.15.13\"><span class=\"label\">13</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ver. 15; ch. 17:22]   </span></span><span class=\"content\">A glad heart makes a cheerful face,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PRO.15.13\"><span class=\"content\">but by </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 12:25 </span></span><span class=\"content\">sorrow of heart the spirit is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 18:14</span></span><span class=\"content\">crushed.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PRO.15.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PRO.15.14\"><span class=\"label\">14</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 14:6; 19:24  </span></span><span class=\"content\">The heart of him who has understanding seeks knowledge,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PRO.15.14\"><span class=\"content\">but the mouths of fools feed on folly.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PRO.15.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PRO.15.15\"><span class=\"label\">15</span><span class=\"content\">All the days of the afflicted are evil,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PRO.15.15\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 13</span></span><span class=\"content\">the cheerful of heart has a continual feast.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PRO.15.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PRO.15.16\"><span class=\"label\">16</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 16:8; Ps. 37:16; [1 Tim. 6:6]  </span></span><span class=\"content\">Better is a little with the fear of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PRO.15.16\"><span class=\"content\">than great treasure and trouble with it.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PRO.15.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PRO.15.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 17:1   </span></span><span class=\"content\">Better is a dinner of herbs where love is</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PRO.15.17\"><span class=\"content\">than </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Matt. 22:4; Luke 15:23]</span></span><span class=\"content\">a fattened ox and hatred with it.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PRO.15.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PRO.15.18\"><span class=\"label\">18</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 29:22; [ch. 16:28; 26:21]   </span></span><span class=\"content\">A hot-tempered man </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 28:25 </span></span><span class=\"content\">stirs up strife,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PRO.15.18\"><span class=\"content\">but he who is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 14:29</span></span><span class=\"content\">slow to anger quiets contention.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"PRO.15.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"PRO.15.19\"><span class=\"label\">19</span><span class=\"content\">The way of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 19:24; 22:13 </span></span><span class=\"content\">a sluggard is like a hedge of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 22:5 </span></span><span class=\"content\">thorns,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"PRO.15.19\"><span class=\"content\">but the path of the upright is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jer. 18:15</span></span><span class=\"content\">a level highway.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"PRO.15.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"PRO.15.20\"><span class=\"label\">20</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 29:3  </span></span><span class=\"content\">A wise son makes a glad father,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"PRO.15.20\"><span class=\"content\">but a foolish man despises his mother.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"PRO.15.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"PRO.15.21\"><span class=\"label\">21</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 10:23   </span></span><span class=\"content\">Folly is a joy to him who lacks sense,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"PRO.15.21\"><span class=\"content\">but a man of understanding </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Eph. 5:15]</span></span><span class=\"content\">walks straight ahead.</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"PRO.15.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"PRO.15.22\"><span class=\"label\">22</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 11:14; [ch. 20:18]  </span></span><span class=\"content\">Without counsel plans fail,</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"PRO.15.22\"><span class=\"content\">but with many advisers they succeed.</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"PRO.15.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"PRO.15.23\"><span class=\"label\">23</span><span class=\"content\">To make an apt answer is a joy to a man,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"PRO.15.23\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 25:11; [Isa. 50:4]</span></span><span class=\"content\">a word in season, how good it is!</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"PRO.15.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"PRO.15.24\"><span class=\"label\">24</span><span class=\"content\">The path of life leads upward </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 3:1, 2; [ch. 2:18, 19; Phil. 3:20]</span></span><span class=\"content\">for the prudent,</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"PRO.15.24\"><span class=\"content\">that he may turn away from Sheol beneath.</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"PRO.15.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"PRO.15.25\"><span class=\"label\">25</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> tears down the house of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 29:23] </span></span><span class=\"content\">the proud</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"PRO.15.25\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 23:10] </span></span><span class=\"content\">maintains </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 68:5; 146:9]</span></span><span class=\"content\">the widow&#8217;s boundaries.</span></span></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"PRO.15.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"PRO.15.26\"><span class=\"label\">26</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 6:16, 18   </span></span><span class=\"content\">The thoughts of the wicked are an abomination to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">,</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"PRO.15.26\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 16:24</span></span><span class=\"content\">gracious words are pure.</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"PRO.15.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"PRO.15.27\"><span class=\"label\">27</span><span class=\"content\">Whoever is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:19; [Isa. 5:8; Jer. 17:11] </span></span><span class=\"content\">greedy for unjust gain </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 11:29; [Josh. 7:25] </span></span><span class=\"content\">troubles his own household,</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"PRO.15.27\"><span class=\"content\">but he who hates </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 17:23</span></span><span class=\"content\">bribes will live.</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"PRO.15.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"PRO.15.28\"><span class=\"label\">28</span><span class=\"content\">The heart of the righteous </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 37:30 </span></span><span class=\"content\">ponders how to answer,</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"PRO.15.28\"><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Pet. 3:15]; See ver. 2</span></span><span class=\"content\">the mouth of the wicked pours out evil things.</span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"PRO.15.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"PRO.15.29\"><span class=\"label\">29</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 18:41; 34:16] </span></span><span class=\"content\">far from the wicked,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"PRO.15.29\"><span class=\"content\">but he </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 145:18, 19; [ver. 8]</span></span><span class=\"content\">hears the prayer of the righteous.</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"PRO.15.29\"><span class=\"content\">  </span></span><span class=\"verse v30\" data-usfm=\"PRO.15.30\"><span class=\"label\">30</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 38:10   </span></span><span class=\"content\">The light of the eyes rejoices the heart,</span></span></div><div class=\"q2\"><span class=\"verse v30\" data-usfm=\"PRO.15.30\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 25:25]</span></span><span class=\"content\">good news refreshes</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">15:30 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">makes fat</span></span></span><span class=\"content\"> the bones.</span></span></div><div class=\"q1\"><span class=\"verse v30\" data-usfm=\"PRO.15.30\"><span class=\"content\">  </span></span><span class=\"verse v31\" data-usfm=\"PRO.15.31\"><span class=\"label\">31</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 5; ch. 20:12; 25:12   </span></span><span class=\"content\">The ear that listens to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 6:23]</span></span><span class=\"content\">life-giving reproof</span></span></div><div class=\"q2\"><span class=\"verse v31\" data-usfm=\"PRO.15.31\"><span class=\"content\">will dwell among the wise.</span></span></div><div class=\"q1\"><span class=\"verse v31\" data-usfm=\"PRO.15.31\"><span class=\"content\">  </span></span><span class=\"verse v32\" data-usfm=\"PRO.15.32\"><span class=\"label\">32</span><span class=\"content\">Whoever </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 8:33] </span></span><span class=\"content\">ignores instruction </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 8:36 </span></span><span class=\"content\">despises himself,</span></span></div><div class=\"q2\"><span class=\"verse v32\" data-usfm=\"PRO.15.32\"><span class=\"content\">but he who listens to reproof </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 19:8]</span></span><span class=\"content\">gains intelligence.</span></span></div><div class=\"q1\"><span class=\"verse v32\" data-usfm=\"PRO.15.32\"><span class=\"content\">  </span></span><span class=\"verse v33\" data-usfm=\"PRO.15.33\"><span class=\"label\">33</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See ch. 1:7   </span></span><span class=\"content\">The fear of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is instruction in wisdom,</span></span></div><div class=\"q2\"><span class=\"verse v33\" data-usfm=\"PRO.15.33\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 18:12</span></span><span class=\"content\">humility comes before honor.</span></span></div><div class=\"b\"></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PRO.16"], "human": "Proverbs 16", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PRO.14"], "human": "Proverbs 14", "toc": true, "version_id": 59}, "reference": {"usfm": ["PRO.15"], "human": "Proverbs 15", "version_id": 59}}, "usfm": "PRO.15.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright 