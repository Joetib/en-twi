{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.118.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/118-c3a9323ae6d9b68d9e39ada0c2941a92.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/118-c3a9323ae6d9b68d9e39ada0c2941a92.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch118\" data-usfm=\"PSA.118\">\n            <div class=\"label\">118</div><div class=\"s1\"><span class=\"heading\">His Steadfast Love Endures Forever</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.118.1\"><span class=\"label\">1</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 29; See Ps. 100:5  </span></span><span class=\"content\">Oh give thanks to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, for he is good;</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.118.1\"><span class=\"content\">for his steadfast love endures forever!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"PSA.118.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.118.2\"><span class=\"label\">2</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 115:9, 10, 11]  </span></span><span class=\"content\">Let Israel say,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.118.2\"><span class=\"content\">&#8220;His steadfast love endures forever.&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.118.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.118.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [See ver. 2 above]  </span></span><span class=\"content\">Let the house of Aaron say,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.118.3\"><span class=\"content\">&#8220;His steadfast love endures forever.&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.118.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.118.4\"><span class=\"label\">4</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [See ver. 2 above]  </span></span><span class=\"content\">Let those who fear the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> say,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.118.4\"><span class=\"content\">&#8220;His steadfast love endures forever.&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.118.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.118.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Jonah 2:1]   </span></span><span class=\"content\">Out of my distress I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 116:4] </span></span><span class=\"content\">called on the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.118.5\"><span class=\"content\">the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> answered me and set me </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 18:19</span></span><span class=\"content\">free.</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.118.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.118.6\"><span class=\"label\">6</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 56:9; Cited Heb. 13:6   </span></span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is on my side; </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 23:4; 56:4, 11</span></span><span class=\"content\">I will not fear.</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.118.6\"><span class=\"content\">What can man do to me?</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.118.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.118.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 54:4   </span></span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is on my side as my helper;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.118.7\"><span class=\"content\">I shall </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 54:7</span></span><span class=\"content\">look in triumph on those who hate me.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.118.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.118.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 40:4; 62:8]   </span></span><span class=\"content\">It is better to take refuge in the </span><span class=\"nd\"><span class=\"content\">Lord</span></span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.118.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 146:3\n        </span></span><span class=\"content\">than to trust in man.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"PSA.118.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"PSA.118.9\"><span class=\"label\">9</span><span class=\"content\">It is better to take refuge in the </span><span class=\"nd\"><span class=\"content\">Lord</span></span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"PSA.118.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [See ver. 8 above]  </span></span><span class=\"content\">than to trust in princes.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"PSA.118.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"PSA.118.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 88:17]  </span></span><span class=\"content\">All nations surrounded me;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"PSA.118.10\"><span class=\"content\">in the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> I cut them off!</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"PSA.118.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"PSA.118.11\"><span class=\"label\">11</span><span class=\"content\">They surrounded me, surrounded me on every side;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"PSA.118.11\"><span class=\"content\">in the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> I cut them off!</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"PSA.118.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"PSA.118.12\"><span class=\"label\">12</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Deut. 1:44   </span></span><span class=\"content\">They surrounded me like bees;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.118.12\"><span class=\"content\">they went out like </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 58:9]</span></span><span class=\"content\">a fire among thorns;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"PSA.118.12\"><span class=\"content\">in the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> I cut them off!</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"PSA.118.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"PSA.118.13\"><span class=\"label\">13</span><span class=\"content\">I was </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 140:4]</span></span><span class=\"content\">pushed hard,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">118:13 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">You </span><span class=\"ft\">(that is, the enemy) </span><span class=\"fq\">pushed me hard</span></span></span><span class=\"content\"> so that I was falling,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"PSA.118.13\"><span class=\"content\">but the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> helped me.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"PSA.118.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"PSA.118.14\"><span class=\"label\">14</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is my strength and my song;</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"PSA.118.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ps. 27:1  </span></span><span class=\"content\">he has become my salvation.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"PSA.118.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"PSA.118.15\"><span class=\"label\">15</span><span class=\"content\">Glad songs of salvation</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PSA.118.15\"><span class=\"content\">are in the tents of the righteous:</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"PSA.118.15\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ex. 15:6; Luke 1:51   </span></span><span class=\"content\">&#8220;The right hand of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 60:12</span></span><span class=\"content\">does valiantly,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"PSA.118.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"PSA.118.16\"><span class=\"label\">16</span><span class=\"content\">the right hand of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> exalts,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"PSA.118.16\"><span class=\"content\">the right hand of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 15 above]</span></span><span class=\"content\">does valiantly!&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"PSA.118.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"PSA.118.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Hab. 1:12]   </span></span><span class=\"content\">I shall not die, but I shall live,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"PSA.118.17\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 73:28; 107:22; [Ps. 6:5]</span></span><span class=\"content\">recount the deeds of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"PSA.118.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"PSA.118.18\"><span class=\"label\">18</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Jer. 30:11; 2 Cor. 6:9]</span></span><span class=\"content\">disciplined me severely,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"PSA.118.18\"><span class=\"content\">but he has not given me over to death.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"PSA.118.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"PSA.118.19\"><span class=\"label\">19</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 26:2; [Ps. 24:7, 9]  </span></span><span class=\"content\">Open to me the gates of righteousness,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"PSA.118.19\"><span class=\"content\">that I may enter through them</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"PSA.118.19\"><span class=\"content\">and give thanks to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"PSA.118.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"PSA.118.20\"><span class=\"label\">20</span><span class=\"content\">This is the gate of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"PSA.118.20\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Rev. 21:27; 22:14; [Isa. 35:8]  </span></span><span class=\"content\">the righteous shall enter through it.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"PSA.118.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"PSA.118.21\"><span class=\"label\">21</span><span class=\"content\">I thank you that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 116:1 </span></span><span class=\"content\">you have answered me</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"PSA.118.21\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [See ver. 14 above]  </span></span><span class=\"content\">and have become my salvation.</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"PSA.118.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"PSA.118.22\"><span class=\"label\">22</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    Cited Matt. 21:42; Mark 12:10, 11; Luke 20:17; [Isa. 28:16]; Acts 4:11; Eph. 2:20; 1 Pet. 2:4-7  </span></span><span class=\"content\">The stone that the builders rejected</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"PSA.118.22\"><span class=\"content\">has become the cornerstone.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">118:22 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">the head of the corner</span></span></span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"PSA.118.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"PSA.118.23\"><span class=\"label\">23</span><span class=\"content\">This is the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">&#8217;s doing;</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"PSA.118.23\"><span class=\"content\">it is marvelous in our eyes.</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"PSA.118.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"PSA.118.24\"><span class=\"label\">24</span><span class=\"content\">This is the day that the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> has made;</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"PSA.118.24\"><span class=\"content\">let us rejoice and be glad in it.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"PSA.118.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"PSA.118.25\"><span class=\"label\">25</span><span class=\"content\">Save us, we pray, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"PSA.118.25\"><span class=\"content\">O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, we pray, give us success!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"PSA.118.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"PSA.118.26\"><span class=\"label\">26</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Matt. 21:9; 23:39; Mark 11:9; Luke 13:35; 19:38   </span></span><span class=\"content\">Blessed is he who comes in the name of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"PSA.118.26\"><span class=\"content\">We </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 129:8</span></span><span class=\"content\">bless you from the house of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"PSA.118.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"PSA.118.27\"><span class=\"label\">27</span><span class=\"content\">The </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is God,</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"PSA.118.27\"><span class=\"content\">and he has made </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 18:28; 97:11; [Esth. 8:16; 1 Pet. 2:9] </span></span><span class=\"content\">his light to shine upon us.</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"PSA.118.27\"><span class=\"content\">Bind the festal sacrifice with cords,</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"PSA.118.27\"><span class=\"content\">up to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ex. 27:2</span></span><span class=\"content\">the horns of the altar!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"PSA.118.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"PSA.118.28\"><span class=\"label\">28</span><span class=\"content\">You are my God, and I will give thanks to you;</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"PSA.118.28\"><span class=\"content\">you are my God; I will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 99:5</span></span><span class=\"content\">extol you.</span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"PSA.118.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"PSA.118.29\"><span class=\"label\">29</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ver. 1  </span></span><span class=\"content\">Oh give thanks to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, for he is good;</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"PSA.118.29\"><span class=\"content\">for his steadfast love endures forever!</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["PSA.119"], "human": "Psalm 119", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["PSA.117"], "human": "Psalm 117", "toc": true, "version_id": 59}, "reference": {"usfm": ["PSA.118"], "human": "Psalm 118", "version_id": 59}}, "usfm": "PSA.118.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p> \r\n<p>Sign up to r