{"pageProps": {"params": {"versionId": "59", "usfm": "MIC.7.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/MIC/7-6ddaa117d927e340a62c10546ede878b.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/MIC/7-6ddaa117d927e340a62c10546ede878b.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkMIC\">\n        <div class=\"chapter ch7\" data-usfm=\"MIC.7\">\n            <div class=\"label\">7</div><div class=\"s1\"><span class=\"heading\">Wait for the God of Salvation</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"MIC.7.1\"><span class=\"label\">1</span><span class=\"content\">Woe is me! For I have become</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"MIC.7.1\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 24:13; [Isa. 17:6]   </span></span><span class=\"content\">as when the summer fruit has been gathered,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"MIC.7.1\"><span class=\"content\">as when the grapes have been gleaned:</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"MIC.7.1\"><span class=\"content\">there is no cluster to eat,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"MIC.7.1\"><span class=\"content\">no </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Hos. 9:10</span></span><span class=\"content\">first-ripe fig that my soul desires.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"MIC.7.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"MIC.7.2\"><span class=\"label\">2</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 12:1; Isa. 57:1]   </span></span><span class=\"content\">The godly has perished from the earth,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"MIC.7.2\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 14:1, 3 </span></span><span class=\"content\">there is no one upright among mankind;</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"MIC.7.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 10:9; Hos. 6:8, 9]   </span></span><span class=\"content\">they all lie in wait for blood,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"MIC.7.2\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 9:19</span></span><span class=\"content\">each hunts the other with a net.</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"MIC.7.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"MIC.7.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Zeph. 3:7]   </span></span><span class=\"content\">Their hands are on what is evil, to do it well;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"MIC.7.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 82:1, 2]   </span></span><span class=\"content\">the prince and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:11</span></span><span class=\"content\">the judge ask for a bribe,</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"MIC.7.3\"><span class=\"content\">and the great man utters the evil desire of his soul;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"MIC.7.3\"><span class=\"content\">thus they weave it together.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"MIC.7.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"MIC.7.4\"><span class=\"label\">4</span><span class=\"content\">The best of them is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Sam. 23:6, 7; Nah. 1:10]; See Ezek. 2:6 </span></span><span class=\"content\">like a brier,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"MIC.7.4\"><span class=\"content\">the most upright of them a thorn hedge.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"MIC.7.4\"><span class=\"content\">The day of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ezek. 33:2 </span></span><span class=\"content\">your watchmen, of your punishment, has come;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"MIC.7.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 3:6, 7; Isa. 22:5]  </span></span><span class=\"content\">now their confusion is at hand.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"MIC.7.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"MIC.7.5\"><span class=\"label\">5</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Jer. 9:4   </span></span><span class=\"content\">Put no trust in a neighbor;</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"MIC.7.5\"><span class=\"content\">have no confidence in a friend;</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"MIC.7.5\"><span class=\"content\">guard </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 141:3]</span></span><span class=\"content\">the doors of your mouth</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"MIC.7.5\"><span class=\"content\">from her who lies in your arms;</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">7:5 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">bosom</span></span></span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"MIC.7.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"MIC.7.6\"><span class=\"label\">6</span><span class=\"content\">for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ezek. 22:7; [Matt. 10:21, 35; Luke 12:53] </span></span><span class=\"content\">the son treats the father with contempt,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"MIC.7.6\"><span class=\"content\">the daughter rises up against her mother,</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"MIC.7.6\"><span class=\"content\">the daughter-in-law against her mother-in-law;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"MIC.7.6\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    Cited Matt. 10:36  </span></span><span class=\"content\">a man&#8217;s enemies are the men of his own house.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"MIC.7.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"MIC.7.7\"><span class=\"label\">7</span><span class=\"content\">But as for me, I will look to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"MIC.7.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Lam. 3:26]  </span></span><span class=\"content\">I will wait for the God of my salvation;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"MIC.7.7\"><span class=\"content\">my God will hear me.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"MIC.7.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"MIC.7.8\"><span class=\"label\">8</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Jer. 50:11; Lam. 4:21]   </span></span><span class=\"content\">Rejoice not over me, O </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 10 </span></span><span class=\"content\">my enemy;</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"MIC.7.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 37:24   </span></span><span class=\"content\">when I fall, I shall rise;</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"MIC.7.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 112:4\n        </span></span><span class=\"content\">when I sit in darkness,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"MIC.7.8\"><span class=\"content\">the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> will be a light to me.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"MIC.7.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"MIC.7.9\"><span class=\"label\">9</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Jer. 10:19]   </span></span><span class=\"content\">I will bear the indignation of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"MIC.7.9\"><span class=\"content\">because I have sinned against him,</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"MIC.7.9\"><span class=\"content\">until </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Sam. 24:15 </span></span><span class=\"content\">he pleads my cause</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"MIC.7.9\"><span class=\"content\">and executes judgment for me.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"MIC.7.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 37:6\n        </span></span><span class=\"content\">He will bring me out to the light;</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"MIC.7.9\"><span class=\"content\">I shall look upon his vindication.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"MIC.7.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"MIC.7.10\"><span class=\"label\">10</span><span class=\"content\">Then </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 8 </span></span><span class=\"content\">my enemy will see,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"MIC.7.10\"><span class=\"content\">and shame will cover her who </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Joel 2:17 </span></span><span class=\"content\">said to me,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"MIC.7.10\"><span class=\"content\">&#8220;Where is the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> your God?&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"MIC.7.10\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 4:11   </span></span><span class=\"content\">My eyes will look upon her;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"MIC.7.10\"><span class=\"content\">now she will be trampled down</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"MIC.7.10\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 18:42; See 2 Sam. 22:43  </span></span><span class=\"content\">like the mire of the streets.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"MIC.7.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"MIC.7.11\"><span class=\"label\">11</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ps. 102:13]  </span></span><span class=\"content\">A day for the building of your walls!</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"MIC.7.11\"><span class=\"content\">In that day the boundary shall be far extended.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"MIC.7.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"MIC.7.12\"><span class=\"label\">12</span><span class=\"content\">In that day they</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">7:12 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">he</span></span></span><span class=\"content\"> will come to you,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"MIC.7.12\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 11:11, 16; 19:23, 24; 27:13; Hos. 11:11; Zech. 10:10]   </span></span><span class=\"content\">from Assyria and the cities of Egypt,</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"MIC.7.12\"><span class=\"content\">and from Egypt to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Gen. 31:21 </span></span><span class=\"content\">the River,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">7:12 </span><span class=\"ft\">That is, the Euphrates</span></span></span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"MIC.7.12\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Zech. 9:10\n        </span></span><span class=\"content\">from sea to sea and from mountain to mountain.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"MIC.7.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"MIC.7.13\"><span class=\"label\">13</span><span class=\"content\">But </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 6:13</span></span><span class=\"content\">the earth will be desolate</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"MIC.7.13\"><span class=\"content\">because of its inhabitants,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"MIC.7.13\"><span class=\"content\">for the fruit of their deeds.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"MIC.7.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"MIC.7.14\"><span class=\"label\">14</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 28:9; [ch. 5:4]   </span></span><span class=\"content\">Shepherd your people </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 23:4 </span></span><span class=\"content\">with your staff,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"MIC.7.14\"><span class=\"content\">the flock of your inheritance,</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"MIC.7.14\"><span class=\"content\">who dwell alone in a forest</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"MIC.7.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Jer. 50:19; [Zech. 10:10]   </span></span><span class=\"content\">in the midst of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Josh. 19:26</span></span><span class=\"content\">a garden land;</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">7:14 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">of Carmel</span></span></span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"MIC.7.14\"><span class=\"content\">let them graze in Bashan and Gilead</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"MIC.7.14\"><span class=\"content\">as in the days of old.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"MIC.7.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"MIC.7.15\"><span class=\"label\">15</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 78:12; See Isa. 11:16  </span></span><span class=\"content\">As in the days when you came out of the land of Egypt,</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"MIC.7.15\"><span class=\"content\">I will show them</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">7:15 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">him</span></span></span><span class=\"content\"> marvelous things.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"MIC.7.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"MIC.7.16\"><span class=\"label\">16</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 26:11; 52:15]   </span></span><span class=\"content\">The nations shall see and be ashamed of all their might;</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"MIC.7.16\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Judg. 18:19  </span></span><span class=\"content\">they shall lay their hands on their mouths;</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"MIC.7.16\"><span class=\"content\">their ears shall be deaf;</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"MIC.7.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"MIC.7.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 72:9; Isa. 49:23   </span></span><span class=\"content\">they shall lick the dust like a serpent,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"MIC.7.17\"><span class=\"content\">like the crawling things of the earth;</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"MIC.7.17\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 18:45   </span></span><span class=\"content\">they shall come trembling out of their strongholds;</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"MIC.7.17\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 4:1]  </span></span><span class=\"content\">they shall turn in dread to the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> our God,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"MIC.7.17\"><span class=\"content\">and they shall be in fear of you.</span></span></div><div class=\"s1\"><span class=\"heading\">God&#8217;s Steadfast Love and Compassion</span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"MIC.7.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"MIC.7.18\"><span class=\"label\">18</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Ex. 15:11   </span></span><span class=\"content\">Who is a God like you, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jer. 50:20; See Ex. 34:7 </span></span><span class=\"content\">pardoning iniquity</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"MIC.7.18\"><span class=\"content\">and passing over transgression</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"MIC.7.18\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Jer. 50:20; See Ex. 34:7   </span></span><span class=\"content\">for the remnant of his inheritance?</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"MIC.7.18\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 103:9\n        </span></span><span class=\"content\">He does not retain his anger forever,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"MIC.7.18\"><span class=\"content\">because he delights in steadfast love.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"MIC.7.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"MIC.7.19\"><span class=\"label\">19</span><span class=\"content\">He will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 80:14 </span></span><span class=\"content\">again have compassion on us;</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"MIC.7.19\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Rom. 6:14]   </span></span><span class=\"content\">he will tread our iniquities underfoot.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"MIC.7.19\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 38:17]  </span></span><span class=\"content\">You will cast all our</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">7:19 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">their</span></span></span><span class=\"content\"> sins</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"MIC.7.19\"><span class=\"content\">into the depths of the sea.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"MIC.7.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"MIC.7.20\"><span class=\"label\">20</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Luke 1:72, 73]   </span></span><span class=\"content\">You will show faithfulness to Jacob</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"MIC.7.20\"><span class=\"content\">and steadfast love to Abraham,</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"MIC.7.20\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 105:9, 10  </span></span><span class=\"content\">as you have sworn to our fathers</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"MIC.7.20\"><span class=\"content\">from the days of old.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["NAM.1"], "human": "Nahum 1", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["MIC.6"], "human": "Micah 6", "toc": true, "version_id": 59}, "reference": {"usfm": ["MIC.7"], "human": "Micah 7", "version_id": 59}}, "usfm": "MIC.7.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"