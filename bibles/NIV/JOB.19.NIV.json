{"pageProps": {"params": {"versionId": "59", "usfm": "JOB.19.NIV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/JOB/19-3d4405fde457df7aa8c072a1f38d9fbd.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/JOB/19-3d4405fde457df7aa8c072a1f38d9fbd.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkJOB\">\n        <div class=\"chapter ch19\" data-usfm=\"JOB.19\">\n            <div class=\"label\">19</div><div class=\"s1\"><span class=\"heading\">Job Replies: My Redeemer Lives</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"JOB.19.1\"><span class=\"label\">1</span><span class=\"content\">Then Job answered and said:</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"JOB.19.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"JOB.19.2\"><span class=\"label\">2</span><span class=\"content\">&#8220;How long will you torment me</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"JOB.19.2\"><span class=\"content\">and break me in pieces with words?</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"JOB.19.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"JOB.19.3\"><span class=\"label\">3</span><span class=\"content\">These </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Gen. 31:7</span></span><span class=\"content\">ten times you have cast reproach upon me;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"JOB.19.3\"><span class=\"content\">are you not ashamed to wrong me?</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"JOB.19.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"JOB.19.4\"><span class=\"label\">4</span><span class=\"content\">And even if it be true that I have erred,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"JOB.19.4\"><span class=\"content\">my error remains with myself.</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"JOB.19.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"JOB.19.5\"><span class=\"label\">5</span><span class=\"content\">If indeed you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 35:26; 38:16; 55:12</span></span><span class=\"content\">magnify yourselves against me</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"JOB.19.5\"><span class=\"content\">and make my disgrace an argument against me,</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"JOB.19.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"JOB.19.6\"><span class=\"label\">6</span><span class=\"content\">know then that God has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 8:3; 34:12; Lam. 3:36]</span></span><span class=\"content\">put me in the wrong</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"JOB.19.6\"><span class=\"content\">and closed his net about me.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"JOB.19.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"JOB.19.7\"><span class=\"label\">7</span><span class=\"content\">Behold, I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 24:12; Hab. 1:2; [Lam. 3:8]</span></span><span class=\"content\">cry out, &#8216;Violence!&#8217; but I am not answered;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"JOB.19.7\"><span class=\"content\">I call for help, but there is no justice.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"JOB.19.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"JOB.19.8\"><span class=\"label\">8</span><span class=\"content\">He has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Lam. 3:7, 9; Hos. 2:6; [ch. 3:23; 13:27]</span></span><span class=\"content\">walled up my way, so that I cannot pass,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"JOB.19.8\"><span class=\"content\">and he has set darkness upon my paths.</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"JOB.19.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"JOB.19.9\"><span class=\"label\">9</span><span class=\"content\">He has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 89:44 </span></span><span class=\"content\">stripped from me my glory</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"JOB.19.9\"><span class=\"content\">and taken the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 89:39; Lam. 5:16; [ch. 29:14]</span></span><span class=\"content\">crown from my head.</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"JOB.19.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"JOB.19.10\"><span class=\"label\">10</span><span class=\"content\">He breaks me down on every side, and I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 27:21; [ch. 10:21; 14:20]</span></span><span class=\"content\">am gone,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"JOB.19.10\"><span class=\"content\">and my hope has he pulled up like a tree.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"JOB.19.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"JOB.19.11\"><span class=\"label\">11</span><span class=\"content\">He has kindled his wrath against me</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"JOB.19.11\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 13:24</span></span><span class=\"content\">counts me as his adversary.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"JOB.19.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"JOB.19.12\"><span class=\"label\">12</span><span class=\"content\">His </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 10:17; 25:2] </span></span><span class=\"content\">troops come on together;</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"JOB.19.12\"><span class=\"content\">they have </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 30:12</span></span><span class=\"content\">cast up their siege ramp</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">19:12 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">their way</span></span></span><span class=\"content\"> against me</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"JOB.19.12\"><span class=\"content\">and encamp around my tent.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"JOB.19.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"JOB.19.13\"><span class=\"label\">13</span><span class=\"content\">&#8220;He has put my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 69:8; [ch. 6:15] </span></span><span class=\"content\">brothers far from me,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"JOB.19.13\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 31:11; 88:8, 18]</span></span><span class=\"content\">those who knew me are wholly estranged from me.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"JOB.19.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"JOB.19.14\"><span class=\"label\">14</span><span class=\"content\">My relatives </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 38:11 </span></span><span class=\"content\">have failed me,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"JOB.19.14\"><span class=\"content\">my close </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 55:13</span></span><span class=\"content\">friends have forgotten me.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"JOB.19.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"JOB.19.15\"><span class=\"label\">15</span><span class=\"content\">The guests </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Gen. 17:27; Matt. 10:36]</span></span><span class=\"content\">in my house and my maidservants count me as a stranger;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"JOB.19.15\"><span class=\"content\">I have become a foreigner in their eyes.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"JOB.19.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"JOB.19.16\"><span class=\"label\">16</span><span class=\"content\">I call to my servant, but he gives me no answer;</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"JOB.19.16\"><span class=\"content\">I must plead with him with my mouth for mercy.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"JOB.19.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"JOB.19.17\"><span class=\"label\">17</span><span class=\"content\">My breath is strange to my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 2:9 </span></span><span class=\"content\">wife,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"JOB.19.17\"><span class=\"content\">and I am a stench to the children of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 3:10</span></span><span class=\"content\">my own mother.</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"JOB.19.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"JOB.19.18\"><span class=\"label\">18</span><span class=\"content\">Even young </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Kgs. 2:23]</span></span><span class=\"content\">children despise me;</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"JOB.19.18\"><span class=\"content\">when I rise they talk against me.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"JOB.19.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"JOB.19.19\"><span class=\"label\">19</span><span class=\"content\">All my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 41:9; 55:13, 14]</span></span><span class=\"content\">intimate friends abhor me,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"JOB.19.19\"><span class=\"content\">and those whom I loved have turned against me.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"JOB.19.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"JOB.19.20\"><span class=\"label\">20</span><span class=\"content\">My </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 102:5; [Lam. 4:8]</span></span><span class=\"content\">bones stick to my skin and to my flesh,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"JOB.19.20\"><span class=\"content\">and I have escaped by the skin of my teeth.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"JOB.19.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"JOB.19.21\"><span class=\"label\">21</span><span class=\"content\">Have mercy on me, have mercy on me, O you my friends,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"JOB.19.21\"><span class=\"content\">for the hand of God has </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 1:11; Isa. 53:4</span></span><span class=\"content\">touched me!</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"JOB.19.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"JOB.19.22\"><span class=\"label\">22</span><span class=\"content\">Why do you, like God, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 69:26]</span></span><span class=\"content\">pursue me?</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"JOB.19.22\"><span class=\"content\">Why are you not satisfied with my flesh?</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"JOB.19.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"JOB.19.23\"><span class=\"label\">23</span><span class=\"content\">&#8220;Oh that my words were written!</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"JOB.19.23\"><span class=\"content\">Oh that they were </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 30:8</span></span><span class=\"content\">inscribed in a book!</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"JOB.19.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"JOB.19.24\"><span class=\"label\">24</span><span class=\"content\">Oh that with an iron </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Jer. 17:1</span></span><span class=\"content\">pen and lead</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"JOB.19.24\"><span class=\"content\">they were engraved in the rock forever!</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"JOB.19.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"JOB.19.25\"><span class=\"label\">25</span><span class=\"content\">For I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 30:23 </span></span><span class=\"content\">know that my </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 43:14; 44:6, 24; 49:7; [Gen. 48:16; Ps. 19:14; 103:4; 1 Thess. 1:10] </span></span><span class=\"content\">Redeemer lives,</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"JOB.19.25\"><span class=\"content\">and at the last he will stand upon the </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 41:33</span></span><span class=\"content\">earth.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">19:25 </span><span class=\"ft\">Hebrew </span><span class=\"fq\">dust</span></span></span></span></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"JOB.19.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"JOB.19.26\"><span class=\"label\">26</span><span class=\"content\">And after my skin has been thus destroyed,</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"JOB.19.26\"><span class=\"content\">yet in</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">19:26 </span><span class=\"ft\">Or </span><span class=\"fq\">without</span></span></span><span class=\"content\"> my flesh I shall </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 17:15; 1 Cor. 13:12; 1 John 3:2</span></span><span class=\"content\">see God,</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"JOB.19.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"JOB.19.27\"><span class=\"label\">27</span><span class=\"content\">whom I shall see for myself,</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"JOB.19.27\"><span class=\"content\">and my eyes shall behold, and not </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Prov. 27:2] </span></span><span class=\"content\">another.</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"JOB.19.27\"><span class=\"content\">My heart </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 73:26]</span></span><span class=\"content\">faints within me!</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"JOB.19.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"JOB.19.28\"><span class=\"label\">28</span><span class=\"content\">If you say, &#8216;How we will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 22 above]</span></span><span class=\"content\">pursue him!&#8217;</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"JOB.19.28\"><span class=\"content\">and, &#8216;The root of the matter is found in him,&#8217;</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">19:28 </span><span class=\"ft\">Many Hebrew manuscripts </span><span class=\"fq\">in me</span></span></span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"JOB.19.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"JOB.19.29\"><span class=\"label\">29</span><span class=\"content\">be afraid of the sword,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"JOB.19.29\"><span class=\"content\">for wrath brings the punishment of the sword,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"JOB.19.29\"><span class=\"content\">that you may know there is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Eccles. 12:14; See Ps. 58:11</span></span><span class=\"content\">a judgment.&#8221;</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["JOB.20"], "human": "Job 20", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["JOB.18"], "human": "Job 18", "toc": true, "version_id": 59}, "reference": {"usfm": ["JOB.19"], "human": "Job 19", "version_id": 59}}, "usfm": "JOB.19.NIV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The 