{"pageProps": {"params": {"versionId": "59", "usfm": "PSA.130.ESV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/PSA/130-08984887819c05259b7b95028ff79e2b.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/PSA/130-08984887819c05259b7b95028ff79e2b.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkPSA\">\n        <div class=\"chapter ch130\" data-usfm=\"PSA.130\">\n            <div class=\"label\">130</div><div class=\"s1\"><span class=\"heading\">My Soul Waits for the Lord</span></div><div class=\"d\"><span class=\"content\">A Song of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See Ps. 120, title]</span></span><span class=\"content\">Ascents.</span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"PSA.130.1\"><span class=\"label\">1</span><span class=\"content\">Out of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 69:2, 14; Lam. 3:55; Jonah 2:2</span></span><span class=\"content\">the depths I cry to you, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"PSA.130.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"PSA.130.2\"><span class=\"label\">2</span><span class=\"content\">O Lord, hear my voice!</span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.130.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 86:6; 2 Chr. 6:40   </span></span><span class=\"content\">Let your ears be attentive</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"PSA.130.2\"><span class=\"content\">to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 140:6</span></span><span class=\"content\">the voice of my pleas for mercy!</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"PSA.130.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"PSA.130.3\"><span class=\"label\">3</span><span class=\"content\">If you, O </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, should </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 90:8]; See Job 10:14 </span></span><span class=\"content\">mark iniquities,</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"PSA.130.3\"><span class=\"content\">O Lord, who could </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 76:7; Amos 2:15; Nah. 1:6; Mal. 3:2; Eph. 6:13; Rev. 6:17; [Ps. 143:2]</span></span><span class=\"content\">stand?</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"PSA.130.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"PSA.130.4\"><span class=\"label\">4</span><span class=\"content\">But with you there is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 7; Isa. 55:7; Dan. 9:9; See Ps. 86:5, 15 </span></span><span class=\"content\">forgiveness,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"PSA.130.4\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        1 Kgs. 8:39, 40; Jer. 33:8, 9; [Rom. 2:4]  </span></span><span class=\"content\">that you may be feared.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"PSA.130.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"PSA.130.5\"><span class=\"label\">5</span><span class=\"content\">I </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 40:1; Isa. 8:17; 26:8 </span></span><span class=\"content\">wait for the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 33:20 </span></span><span class=\"content\">my soul waits,</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"PSA.130.5\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 119:74, 81</span></span><span class=\"content\">in his word I hope;</span></span></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"PSA.130.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"PSA.130.6\"><span class=\"label\">6</span><span class=\"content\">my soul </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 123:2] </span></span><span class=\"content\">waits for the Lord</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.130.6\"><span class=\"content\">more than </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Ps. 63:6; 119:147] </span></span><span class=\"content\">watchmen for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Ps. 5:3</span></span><span class=\"content\">the morning,</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"PSA.130.6\"><span class=\"content\">more than watchmen for the morning.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"PSA.130.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"PSA.130.7\"><span class=\"label\">7</span><span class=\"content\">O Israel, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 131:3 </span></span><span class=\"content\">hope in the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">!</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.130.7\"><span class=\"content\">For </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ver. 4</span></span><span class=\"content\">with the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> there is steadfast love,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"PSA.130.7\"><span class=\"content\">and with him is plentiful redemption.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"PSA.130.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"PSA.130.8\"><span class=\"label\">8</span><span class=\"content\">And he will </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ps. 111:9; Luke 1:68; Titus 2:14; [Matt. 1:21]; See Ps. 25:22</span></span><span class=\"content\">redeem Israel</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"PSA.130.8\"><span class=\"content\">from all his iniquities.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyrigh