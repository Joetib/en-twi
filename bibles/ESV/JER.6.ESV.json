{"pageProps": {"params": {"versionId": "59", "usfm": "JER.6.ESV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/JER/6-40627515d7e47fd0f13345a5e6ed3de8.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/JER/6-40627515d7e47fd0f13345a5e6ed3de8.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bkJER\">\n        <div class=\"chapter ch6\" data-usfm=\"JER.6\">\n            <div class=\"label\">6</div><div class=\"s1\"><span class=\"heading\">Impending Disaster for Jerusalem</span></div><div class=\"q1\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"JER.6.1\"><span class=\"label\">1</span><span class=\"content\">Flee for safety, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Judg. 1:21] </span></span><span class=\"content\">O people of Benjamin,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"JER.6.1\"><span class=\"content\">from the midst of Jerusalem!</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"JER.6.1\"><span class=\"content\">Blow the trumpet in </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 2 Sam. 14:2 </span></span><span class=\"content\">Tekoa,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"JER.6.1\"><span class=\"content\">and raise a signal on </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Neh. 3:14 </span></span><span class=\"content\">Beth-haccherem,</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"JER.6.1\"><span class=\"content\">for disaster looms </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:14</span></span><span class=\"content\">out of the north,</span></span></div><div class=\"q2\"><span class=\"verse v1\" data-usfm=\"JER.6.1\"><span class=\"content\">and great destruction.</span></span></div><div class=\"q1\"><span class=\"verse v1\" data-usfm=\"JER.6.1\"><span class=\"content\">  </span></span><span class=\"verse v2\" data-usfm=\"JER.6.2\"><span class=\"label\">2</span><span class=\"content\">The lovely and delicately bred I will destroy,</span></span></div><div class=\"q2\"><span class=\"verse v2\" data-usfm=\"JER.6.2\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See 2 Kgs. 19:21  </span></span><span class=\"content\">the daughter of Zion.</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">6:2 </span><span class=\"ft\">Or </span><span class=\"fq\">I have likened the daughter of Zion to the loveliest pasture</span></span></span></span></div><div class=\"q1\"><span class=\"verse v2\" data-usfm=\"JER.6.2\"><span class=\"content\">  </span></span><span class=\"verse v3\" data-usfm=\"JER.6.3\"><span class=\"label\">3</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 23:1]   </span></span><span class=\"content\">Shepherds with their flocks shall come against her;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"JER.6.3\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 4:17  </span></span><span class=\"content\">they shall pitch their tents around her;</span></span></div><div class=\"q2\"><span class=\"verse v3\" data-usfm=\"JER.6.3\"><span class=\"content\">they shall pasture, each in his place.</span></span></div><div class=\"q1\"><span class=\"verse v3\" data-usfm=\"JER.6.3\"><span class=\"content\">  </span></span><span class=\"verse v4\" data-usfm=\"JER.6.4\"><span class=\"label\">4</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 22:7; Joel 3:9; [ch. 51:27]   </span></span><span class=\"content\">&#8220;Prepare war against her;</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"JER.6.4\"><span class=\"content\">arise, and let us attack </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 15:8</span></span><span class=\"content\">at noon!</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"JER.6.4\"><span class=\"content\">Woe to us, for the day declines,</span></span></div><div class=\"q2\"><span class=\"verse v4\" data-usfm=\"JER.6.4\"><span class=\"content\">for the shadows of evening lengthen!</span></span></div><div class=\"q1\"><span class=\"verse v4\" data-usfm=\"JER.6.4\"><span class=\"content\">  </span></span><span class=\"verse v5\" data-usfm=\"JER.6.5\"><span class=\"label\">5</span><span class=\"content\">Arise, and let us attack by night</span></span></div><div class=\"q2\"><span class=\"verse v5\" data-usfm=\"JER.6.5\"><span class=\"content\">and destroy her palaces!&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v5\" data-usfm=\"JER.6.5\"><span class=\"content\">  </span></span><span class=\"verse v6\" data-usfm=\"JER.6.6\"><span class=\"label\">6</span><span class=\"content\">For thus says the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> of hosts:</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"JER.6.6\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Deut. 20:20]   </span></span><span class=\"content\">&#8220;Cut down her trees;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"JER.6.6\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        2 Kgs. 19:32; Isa. 37:33; Ezek. 26:8; Luke 19:43   </span></span><span class=\"content\">cast up a siege mound against Jerusalem.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"JER.6.6\"><span class=\"content\">This is the city that must be </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 19:44</span></span><span class=\"content\">punished;</span></span></div><div class=\"q2\"><span class=\"verse v6\" data-usfm=\"JER.6.6\"><span class=\"content\">there is nothing but oppression within her.</span></span></div><div class=\"q1\"><span class=\"verse v6\" data-usfm=\"JER.6.6\"><span class=\"content\">  </span></span><span class=\"verse v7\" data-usfm=\"JER.6.7\"><span class=\"label\">7</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 57:20   </span></span><span class=\"content\">As a well keeps its water fresh,</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"JER.6.7\"><span class=\"content\">so she keeps fresh her evil;</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"JER.6.7\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 55:9; Ezek. 7:11, 23  </span></span><span class=\"content\">violence and destruction are heard within her;</span></span></div><div class=\"q2\"><span class=\"verse v7\" data-usfm=\"JER.6.7\"><span class=\"content\">sickness and wounds are ever before me.</span></span></div><div class=\"q1\"><span class=\"verse v7\" data-usfm=\"JER.6.7\"><span class=\"content\">  </span></span><span class=\"verse v8\" data-usfm=\"JER.6.8\"><span class=\"label\">8</span><span class=\"content\">Be warned, O Jerusalem,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"JER.6.8\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ezek. 23:18; [Hos. 9:12]   </span></span><span class=\"content\">lest I turn from you in disgust,</span></span></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"JER.6.8\"><span class=\"content\">lest I make you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 4:7</span></span><span class=\"content\">a desolation,</span></span></div><div class=\"q2\"><span class=\"verse v8\" data-usfm=\"JER.6.8\"><span class=\"content\">an uninhabited land.&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v8\" data-usfm=\"JER.6.8\"><span class=\"content\">  </span></span><span class=\"verse v9\" data-usfm=\"JER.6.9\"><span class=\"label\">9</span><span class=\"content\">Thus says the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> of hosts:</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"JER.6.9\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Deut. 24:21]  </span></span><span class=\"content\">&#8220;They shall glean thoroughly as a vine</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"JER.6.9\"><span class=\"content\">the remnant of Israel;</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"JER.6.9\"><span class=\"content\">like a grape gatherer pass your hand again</span></span></div><div class=\"q2\"><span class=\"verse v9\" data-usfm=\"JER.6.9\"><span class=\"content\">over its branches.&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v9\" data-usfm=\"JER.6.9\"><span class=\"content\">  </span></span><span class=\"verse v10\" data-usfm=\"JER.6.10\"><span class=\"label\">10</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 28:9; 53:1   </span></span><span class=\"content\">To whom shall I speak and give warning,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"JER.6.10\"><span class=\"content\">that they may hear?</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"JER.6.10\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Ex. 6:12; Acts 7:51]   </span></span><span class=\"content\">Behold, their ears are uncircumcised,</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"JER.6.10\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 7:26   </span></span><span class=\"content\">they cannot listen;</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"JER.6.10\"><span class=\"content\">behold, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 20:8</span></span><span class=\"content\">the word of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> is to them an object of scorn;</span></span></div><div class=\"q2\"><span class=\"verse v10\" data-usfm=\"JER.6.10\"><span class=\"content\">they take no pleasure in it.</span></span></div><div class=\"q1\"><span class=\"verse v10\" data-usfm=\"JER.6.10\"><span class=\"content\">  </span></span><span class=\"verse v11\" data-usfm=\"JER.6.11\"><span class=\"label\">11</span><span class=\"content\">Therefore I am full of the wrath of the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">;</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"JER.6.11\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 20:9   </span></span><span class=\"content\">I am weary of holding it in.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"JER.6.11\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 9:21   </span></span><span class=\"content\">&#8220;Pour it out upon the children in the street,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"JER.6.11\"><span class=\"content\">and upon the gatherings of young men, also;</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"JER.6.11\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Lam. 2:21]   </span></span><span class=\"content\">both husband and wife </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 8:9</span></span><span class=\"content\">shall be taken,</span></span></div><div class=\"q2\"><span class=\"verse v11\" data-usfm=\"JER.6.11\"><span class=\"content\">the elderly and the very aged.</span></span></div><div class=\"q1\"><span class=\"verse v11\" data-usfm=\"JER.6.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"JER.6.12\"><span class=\"label\">12</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    For ver. 12-15, see ch. 8:10-12  </span></span><span class=\"content\">Their houses shall be turned over to others,</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"JER.6.12\"><span class=\"content\">their fields and wives together,</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"JER.6.12\"><span class=\"content\">for I will stretch out my hand</span></span></div><div class=\"q2\"><span class=\"verse v12\" data-usfm=\"JER.6.12\"><span class=\"content\">against the inhabitants of the land,&#8221;</span></span></div><div class=\"qr\"><span class=\"verse v12\" data-usfm=\"JER.6.12\"><span class=\"content\">declares the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.</span></span></div><div class=\"q1\"><span class=\"verse v12\" data-usfm=\"JER.6.12\"><span class=\"content\">  </span></span><span class=\"verse v13\" data-usfm=\"JER.6.13\"><span class=\"label\">13</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 31:34; 44:12; Jonah 3:5]   </span></span><span class=\"content\">&#8220;For from the least to the greatest of them,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"JER.6.13\"><span class=\"content\">everyone </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 56:11 </span></span><span class=\"content\">is greedy for unjust gain;</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"JER.6.13\"><span class=\"content\">and from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 14:18; 23:11; Mic. 3:11; See ch. 5:31</span></span><span class=\"content\">prophet to priest,</span></span></div><div class=\"q2\"><span class=\"verse v13\" data-usfm=\"JER.6.13\"><span class=\"content\">everyone deals falsely.</span></span></div><div class=\"q1\"><span class=\"verse v13\" data-usfm=\"JER.6.13\"><span class=\"content\">  </span></span><span class=\"verse v14\" data-usfm=\"JER.6.14\"><span class=\"label\">14</span><span class=\"content\">They have healed the wound of my people lightly,</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"JER.6.14\"><span class=\"content\">saying, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:10; 14:13; 23:17; Ezek. 13:10; Mic. 3:5; [John 14:27] </span></span><span class=\"content\">&#8216;Peace, peace,&#8217;</span></span></div><div class=\"q2\"><span class=\"verse v14\" data-usfm=\"JER.6.14\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 48:22; 57:21; Ezek. 7:25  </span></span><span class=\"content\">when there is no peace.</span></span></div><div class=\"q1\"><span class=\"verse v14\" data-usfm=\"JER.6.14\"><span class=\"content\">  </span></span><span class=\"verse v15\" data-usfm=\"JER.6.15\"><span class=\"label\">15</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ch. 3:3; 8:12]   </span></span><span class=\"content\">Were they ashamed when they committed abomination?</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"JER.6.15\"><span class=\"content\">No, they were not at all ashamed;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"JER.6.15\"><span class=\"content\">they did not know how to blush.</span></span></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"JER.6.15\"><span class=\"content\">Therefore they shall fall among those who fall;</span></span></div><div class=\"q2\"><span class=\"verse v15\" data-usfm=\"JER.6.15\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [ver. 6]  </span></span><span class=\"content\">at the time that I punish them, they shall be overthrown,&#8221;</span></span></div><div class=\"qr\"><span class=\"verse v15\" data-usfm=\"JER.6.15\"><span class=\"content\">says the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v15\" data-usfm=\"JER.6.15\"><span class=\"content\">  </span></span><span class=\"verse v16\" data-usfm=\"JER.6.16\"><span class=\"label\">16</span><span class=\"content\">Thus says the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">:</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"JER.6.16\"><span class=\"content\">&#8220;Stand by the roads, and look,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"JER.6.16\"><span class=\"content\">and ask for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 18:15; [Isa. 8:20; Mal. 4:4; Luke 16:29] </span></span><span class=\"content\">the ancient paths,</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"JER.6.16\"><span class=\"content\">where the good way is; and walk in it,</span></span></div><div class=\"q2\"><span class=\"verse v16\" data-usfm=\"JER.6.16\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Matt. 11:29; [Ps. 116:7]  </span></span><span class=\"content\">and find rest for your souls.</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"JER.6.16\"><span class=\"content\">But they said, &#8216;We will not walk in it.&#8217;</span></span></div><div class=\"q1\"><span class=\"verse v16\" data-usfm=\"JER.6.16\"><span class=\"content\">  </span></span><span class=\"verse v17\" data-usfm=\"JER.6.17\"><span class=\"label\">17</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 56:10; [Isa. 21:11]   </span></span><span class=\"content\">I set watchmen over you, saying,</span></span></div><div class=\"q2\"><span class=\"verse v17\" data-usfm=\"JER.6.17\"><span class=\"content\">&#8216;Pay attention to </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 58:1; [ch. 4:19] </span></span><span class=\"content\">the sound of the trumpet!&#8217;</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"JER.6.17\"><span class=\"content\">But they said, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 44:16</span></span><span class=\"content\">&#8216;We will not pay attention.&#8217;</span></span></div><div class=\"q1\"><span class=\"verse v17\" data-usfm=\"JER.6.17\"><span class=\"content\">  </span></span><span class=\"verse v18\" data-usfm=\"JER.6.18\"><span class=\"label\">18</span><span class=\"content\">Therefore hear, O nations,</span></span></div><div class=\"q2\"><span class=\"verse v18\" data-usfm=\"JER.6.18\"><span class=\"content\">and know, O congregation, what will happen to them.</span></span></div><div class=\"q1\"><span class=\"verse v18\" data-usfm=\"JER.6.18\"><span class=\"content\">  </span></span><span class=\"verse v19\" data-usfm=\"JER.6.19\"><span class=\"label\">19</span><span class=\"content\">Hear, O earth; behold, I am bringing disaster upon this people,</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"JER.6.19\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Prov. 1:31\n        </span></span><span class=\"content\">the fruit of their devices,</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"JER.6.19\"><span class=\"content\">because they have not paid attention to my words;</span></span></div><div class=\"q2\"><span class=\"verse v19\" data-usfm=\"JER.6.19\"><span class=\"content\">and as for my law, they have rejected it.</span></span></div><div class=\"q1\"><span class=\"verse v19\" data-usfm=\"JER.6.19\"><span class=\"content\">  </span></span><span class=\"verse v20\" data-usfm=\"JER.6.20\"><span class=\"label\">20</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 1:11   </span></span><span class=\"content\">What use to me is </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 43:23; 60:6 </span></span><span class=\"content\">frankincense that comes from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Kgs. 10:1 </span></span><span class=\"content\">Sheba,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"JER.6.20\"><span class=\"content\">or sweet cane from a distant land?</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"JER.6.20\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 7:21, 22; 14:12; Ps. 40:6; Isa. 1:11; Amos 5:21  </span></span><span class=\"content\">Your burnt offerings are not acceptable,</span></span></div><div class=\"q2\"><span class=\"verse v20\" data-usfm=\"JER.6.20\"><span class=\"content\">nor your sacrifices pleasing to me.</span></span></div><div class=\"q1\"><span class=\"verse v20\" data-usfm=\"JER.6.20\"><span class=\"content\">  </span></span><span class=\"verse v21\" data-usfm=\"JER.6.21\"><span class=\"label\">21</span><span class=\"content\">Therefore thus says the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">:</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"JER.6.21\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ezek. 3:20\n        </span></span><span class=\"content\">&#8216;Behold, I will lay before this people</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"JER.6.21\"><span class=\"content\">stumbling blocks against which they shall stumble;</span></span></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"JER.6.21\"><span class=\"content\">fathers and sons together,</span></span></div><div class=\"q2\"><span class=\"verse v21\" data-usfm=\"JER.6.21\"><span class=\"content\">neighbor and friend shall perish.&#8217;&#8221;</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v21\" data-usfm=\"JER.6.21\"><span class=\"content\">  </span></span><span class=\"verse v22\" data-usfm=\"JER.6.22\"><span class=\"label\">22</span><span class=\"content\">Thus says the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\">:</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"JER.6.22\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    For ver. 22-24, see ch. 50:41-43   </span></span><span class=\"content\">&#8220;Behold, a people is coming </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:13 </span></span><span class=\"content\">from the north country,</span></span></div><div class=\"q2\"><span class=\"verse v22\" data-usfm=\"JER.6.22\"><span class=\"content\">a great nation is stirring from </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 25:32; 31:8</span></span><span class=\"content\">the farthest parts of the earth.</span></span></div><div class=\"q1\"><span class=\"verse v22\" data-usfm=\"JER.6.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"JER.6.23\"><span class=\"label\">23</span><span class=\"content\">They lay hold on bow and javelin;</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"JER.6.23\"><span class=\"content\">they are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 13:9, 18 </span></span><span class=\"content\">cruel and have no mercy;</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"JER.6.23\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 17:12\n        </span></span><span class=\"content\">the sound of them is like the roaring sea;</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"JER.6.23\"><span class=\"content\">they ride on horses,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"JER.6.23\"><span class=\"content\">set in array as a man for battle,</span></span></div><div class=\"q2\"><span class=\"verse v23\" data-usfm=\"JER.6.23\"><span class=\"content\">against you, O daughter of Zion!&#8221;</span></span></div><div class=\"q1\"><span class=\"verse v23\" data-usfm=\"JER.6.23\"><span class=\"content\">  </span></span><span class=\"verse v24\" data-usfm=\"JER.6.24\"><span class=\"label\">24</span><span class=\"content\">We have heard the report of it;</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"JER.6.24\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 38:4; 49:24; Ezek. 21:7; See 2 Sam. 4:1; Ezek. 7:17   </span></span><span class=\"content\">our hands fall helpless;</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"JER.6.24\"><span class=\"content\">anguish has taken hold of us,</span></span></div><div class=\"q2\"><span class=\"verse v24\" data-usfm=\"JER.6.24\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Isa. 13:8  </span></span><span class=\"content\">pain as of a woman in labor.</span></span></div><div class=\"q1\"><span class=\"verse v24\" data-usfm=\"JER.6.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"JER.6.25\"><span class=\"label\">25</span><span class=\"content\">Go not out into the field,</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"JER.6.25\"><span class=\"content\">nor walk on the road,</span></span></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"JER.6.25\"><span class=\"content\">for the enemy has a sword;</span></span></div><div class=\"q2\"><span class=\"verse v25\" data-usfm=\"JER.6.25\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Ps. 31:13; Lam. 2:22; [Job 18:11]  </span></span><span class=\"content\">terror is on every side.</span></span></div><div class=\"q1\"><span class=\"verse v25\" data-usfm=\"JER.6.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"JER.6.26\"><span class=\"label\">26</span><span class=\"content\">O daughter of my people, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 4:8; Esth. 4:1 </span></span><span class=\"content\">put on sackcloth,</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"JER.6.26\"><span class=\"content\">and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 25:34; Ezek. 27:30; [Lam. 3:16; Mic. 1:10] </span></span><span class=\"content\">roll in ashes;</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"JER.6.26\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Amos 8:10; Zech. 12:10  </span></span><span class=\"content\">make mourning as for an only son,</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"JER.6.26\"><span class=\"content\">most bitter lamentation,</span></span></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"JER.6.26\"><span class=\"content\">for suddenly the destroyer</span></span></div><div class=\"q2\"><span class=\"verse v26\" data-usfm=\"JER.6.26\"><span class=\"content\">will come upon us.</span></span></div><div class=\"b\"></div><div class=\"q1\"><span class=\"verse v26\" data-usfm=\"JER.6.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"JER.6.27\"><span class=\"label\">27</span><span class=\"content\">&#8220;I have made you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[ch. 1:18] </span></span><span class=\"content\">a tester of metals among my people,</span></span></div><div class=\"q2\"><span class=\"verse v27\" data-usfm=\"JER.6.27\"><span class=\"content\">that you may know and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 9:7</span></span><span class=\"content\">test their ways.</span></span></div><div class=\"q1\"><span class=\"verse v27\" data-usfm=\"JER.6.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"JER.6.28\"><span class=\"label\">28</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 5:23   </span></span><span class=\"content\">They are all stubbornly rebellious,</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"JER.6.28\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    ch. 9:4; [Lev. 19:16]   </span></span><span class=\"content\">going about with slanders;</span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"JER.6.28\"><span class=\"content\">they are </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ezek. 22:18, 20</span></span><span class=\"content\">bronze and iron;</span></span></div><div class=\"q2\"><span class=\"verse v28\" data-usfm=\"JER.6.28\"><span class=\"content\">all of them act corruptly.</span></span></div><div class=\"q1\"><span class=\"verse v28\" data-usfm=\"JER.6.28\"><span class=\"content\">  </span></span><span class=\"verse v29\" data-usfm=\"JER.6.29\"><span class=\"label\">29</span><span class=\"content\">The </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[See ver. 28 above] </span></span><span class=\"content\">bellows blow fiercely;</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"JER.6.29\"><span class=\"content\">the lead is consumed by the fire;</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"JER.6.29\"><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    [Isa. 1:25]  </span></span><span class=\"content\">in vain the refining goes on,</span></span></div><div class=\"q2\"><span class=\"verse v29\" data-usfm=\"JER.6.29\"><span class=\"content\">for the wicked are not removed.</span></span></div><div class=\"q1\"><span class=\"verse v29\" data-usfm=\"JER.6.29\"><span class=\"content\">  </span></span><span class=\"verse v30\" data-usfm=\"JER.6.30\"><span class=\"label\">30</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        Isa. 1:22; Ezek. 22:19, 20  </span></span><span class=\"content\">Rejected silver they are called,</span></span></div><div class=\"q2\"><span class=\"verse v30\" data-usfm=\"JER.6.30\"><span class=\"content\">for the </span><span class=\"nd\"><span class=\"content\">Lord</span></span><span class=\"content\"> has rejected them.&#8221;</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["JER.7"], "human": "Jeremiah 7", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["JER.5"], "human": "Jeremiah 5", "toc": true, "version_id": 59}, "reference": {"usfm": ["JER.6"], "human": "Jeremiah 6", "version_id": 59}}, "usfm": "JER.6.ESV", "