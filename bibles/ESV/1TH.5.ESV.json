{"pageProps": {"params": {"versionId": "59", "usfm": "1TH.5.ESV"}, "audioVersionInfo": {"title": "ESV Hear the Word Audio Bible", "copyright_long": {"text": "English: ESV Audio Old and New Testament", "html": "English: ESV Audio Old and New Testament"}, "copyright_short": {"text": "\u2117 2016 Crossway", "html": "<p>\u2117 2016 Crossway</p>"}, "version_id": 59, "id": 1, "publisher_link": "", "dramatized": false, "publisher": {"id": 575, "name": "Hear Book Audio", "local_name": "Hear Book Audio", "url": null, "description": null}}, "type": "chapter", "chapterInfo": {"audioChapterInfo": [{"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1/32k/1TH/5-df5b6efebbc6d6043d88b85331985bd3.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1/m4a/32k/1TH/5-df5b6efebbc6d6043d88b85331985bd3.m3u8?version_id=59"}, "id": 1, "version_id": 59, "title": "ESV Hear the Word Audio Bible", "timing_available": true, "dramatized": false, "default": true}, {"download_urls": {"format_mp3_32k": "//audio-bible-cdn.youversionapi.com/1668/32k/1TH/5-10f6f9aa288c5198977ec51b7d7af6ca.mp3?version_id=59", "format_hls": "//audio-hls.youversionapi.com/1668/m4a/32k/1TH/5-10f6f9aa288c5198977ec51b7d7af6ca.m3u8?version_id=59"}, "id": 1668, "version_id": 59, "title": "Living Water Bible - ESV Music Project by Lutheran Bible Translators", "timing_available": false, "dramatized": true, "default": false}], "content": "<div class=\"version vid59 iso6393eng\" data-vid=\"59\" data-iso6393=\"eng\">\n    <div class=\"book bk1TH\">\n        <div class=\"chapter ch5\" data-usfm=\"1TH.5\">\n            <div class=\"label\">5</div><div class=\"s1\"><span class=\"heading\">The Day of the Lord</span></div><div class=\"p\"><span class=\"content\">  </span><span class=\"verse v1\" data-usfm=\"1TH.5.1\"><span class=\"label\">1</span><span class=\"content\">Now concerning </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Dan. 2:21; Acts 1:7 </span></span><span class=\"content\">the times and the seasons, brothers,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">5:1 </span><span class=\"ft\">Or </span><span class=\"fq\">brothers and sisters</span><span class=\"ft\">; also verses 4, 12, 14, 25, 26, 27</span></span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">ch. 4:9</span></span><span class=\"content\">you have no need to have anything written to you. </span></span><span class=\"verse v2\" data-usfm=\"1TH.5.2\"><span class=\"label\">2</span><span class=\"content\">For you yourselves are fully aware that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[2 Thess. 2:2]; See Matt. 24:43; Luke 17:24</span></span><span class=\"content\">the day of the Lord will come like a thief in the night. </span></span><span class=\"verse v3\" data-usfm=\"1TH.5.3\"><span class=\"label\">3</span><span class=\"content\">While people are saying, &#8220;There is peace and security,&#8221; then </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 21:34; [Ps. 35:8; Luke 17:26-30; 2 Thess. 1:9] </span></span><span class=\"content\">sudden destruction will come upon them </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Isa. 13:8</span></span><span class=\"content\">as labor pains come upon a pregnant woman, and they will not escape. </span></span><span class=\"verse v4\" data-usfm=\"1TH.5.4\"><span class=\"label\">4</span><span class=\"content\">But you </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 John 2:8</span></span><span class=\"content\">are not in darkness, brothers, for that day to surprise you like a thief. </span></span><span class=\"verse v5\" data-usfm=\"1TH.5.5\"><span class=\"label\">5</span><span class=\"content\">For you are all </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Luke 16:8</span></span><span class=\"content\">children</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">5:5 </span><span class=\"ft\">Or </span><span class=\"fq\">sons</span><span class=\"ft\">; twice in this verse</span></span></span><span class=\"content\"> of light, children of the day. We are not of the night or of the darkness. </span></span><span class=\"verse v6\" data-usfm=\"1TH.5.6\"><span class=\"label\">6</span><span class=\"content\">So then </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Mark 13:36]; See Rom. 13:11-13 </span></span><span class=\"content\">let us not sleep, as others do, but let us </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Matt. 24:42 </span></span><span class=\"content\">keep awake and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Pet. 1:13</span></span><span class=\"content\">be sober. </span></span><span class=\"verse v7\" data-usfm=\"1TH.5.7\"><span class=\"label\">7</span><span class=\"content\">For those who sleep, sleep at night, and those who get drunk, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Acts 2:15; 2 Pet. 2:13]</span></span><span class=\"content\">are drunk at night. </span></span><span class=\"verse v8\" data-usfm=\"1TH.5.8\"><span class=\"label\">8</span><span class=\"content\">But since we belong to the day, let us be sober, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 59:17; Eph. 6:14, 17 </span></span><span class=\"content\">having put on the breastplate of </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Eph. 6:23]</span></span><span class=\"content\">faith and love, and for a helmet the hope of salvation. </span></span><span class=\"verse v9\" data-usfm=\"1TH.5.9\"><span class=\"label\">9</span><span class=\"content\">For God has not destined us for </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 1:10 </span></span><span class=\"content\">wrath, but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Thess. 2:13, 14; [Heb. 10:39]</span></span><span class=\"content\">to obtain salvation through our Lord Jesus Christ, </span></span><span class=\"verse v10\" data-usfm=\"1TH.5.10\"><span class=\"label\">10</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Rom. 14:9; [2 Tim. 2:11]</span></span><span class=\"content\">who died for us so that whether we are awake or asleep we might live with him. </span></span><span class=\"verse v11\" data-usfm=\"1TH.5.11\"><span class=\"label\">11</span><span class=\"content\">Therefore encourage one another and build one another up, just as you are doing.</span></span></div><div class=\"s1\"><span class=\"heading\">Final Instructions and Benediction</span></div><div class=\"p\"><span class=\"verse v11\" data-usfm=\"1TH.5.11\"><span class=\"content\">  </span></span><span class=\"verse v12\" data-usfm=\"1TH.5.12\"><span class=\"label\">12</span><span class=\"content\">We ask you, brothers, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Cor. 16:18; Phil. 2:29 </span></span><span class=\"content\">to respect those who labor among you and </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Cor. 16:16; Heb. 13:17</span></span><span class=\"content\">are over you in the Lord and admonish you, </span></span><span class=\"verse v13\" data-usfm=\"1TH.5.13\"><span class=\"label\">13</span><span class=\"content\">and to esteem them very highly in love because of their work. </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Mark 9:50</span></span><span class=\"content\">Be at peace among yourselves. </span></span><span class=\"verse v14\" data-usfm=\"1TH.5.14\"><span class=\"label\">14</span><span class=\"content\">And we urge you, brothers, admonish </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Thess. 3:6, 7, 11 </span></span><span class=\"content\">the idle,</span><span class=\"note f\"><span class=\"label\">#</span><span class=\" body\"><span class=\"fr\">5:14 </span><span class=\"ft\">Or </span><span class=\"fq\">disorderly</span><span class=\"ft\">, or </span><span class=\"fq\">undisciplined</span></span></span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Isa. 35:4; [Heb. 12:12] </span></span><span class=\"content\">encourage the fainthearted, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Acts 20:35; See Rom. 15:1 </span></span><span class=\"content\">help the weak, </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Cor. 13:4</span></span><span class=\"content\">be patient with them all. </span></span><span class=\"verse v15\" data-usfm=\"1TH.5.15\"><span class=\"label\">15</span><span class=\"content\">See that </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 Pet. 3:9; See Rom. 12:17 </span></span><span class=\"content\">no one repays anyone evil for evil, but always </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Rom. 12:9]; See Gal. 6:10</span></span><span class=\"content\">seek to do good to one another and to everyone. </span></span><span class=\"verse v16\" data-usfm=\"1TH.5.16\"><span class=\"label\">16</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Phil. 4:4</span></span><span class=\"content\">Rejoice always, </span></span><span class=\"verse v17\" data-usfm=\"1TH.5.17\"><span class=\"label\">17</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Luke 18:1</span></span><span class=\"content\">pray without ceasing, </span></span><span class=\"verse v18\" data-usfm=\"1TH.5.18\"><span class=\"label\">18</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Eph. 5:20</span></span><span class=\"content\">give thanks in all circumstances; for this is the will of God in Christ Jesus for you. </span></span><span class=\"verse v19\" data-usfm=\"1TH.5.19\"><span class=\"label\">19</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[1 Cor. 14:30; Eph. 4:30; 1 Tim. 4:14; 2 Tim. 1:6]</span></span><span class=\"content\">Do not quench the Spirit. </span></span><span class=\"verse v20\" data-usfm=\"1TH.5.20\"><span class=\"label\">20</span><span class=\"content\">Do not despise </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Cor. 11:4</span></span><span class=\"content\">prophecies, </span></span><span class=\"verse v21\" data-usfm=\"1TH.5.21\"><span class=\"label\">21</span><span class=\"content\">but </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">1 John 4:1; [Job 34:4]; See Eph. 5:10</span></span><span class=\"content\">test everything; hold fast what is good. </span></span><span class=\"verse v22\" data-usfm=\"1TH.5.22\"><span class=\"label\">22</span><span class=\"content\">Abstain from every form of evil.</span></span></div><div class=\"p\"><span class=\"verse v22\" data-usfm=\"1TH.5.22\"><span class=\"content\">  </span></span><span class=\"verse v23\" data-usfm=\"1TH.5.23\"><span class=\"label\">23</span><span class=\"content\">Now may </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See Rom. 15:33 </span></span><span class=\"content\">the God of peace himself </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Ex. 31:13; John 17:17 </span></span><span class=\"content\">sanctify you completely, and may your </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">2 Pet. 3:14; Jude 1 </span></span><span class=\"content\">whole </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Luke 1:46, 47; Heb. 4:12; [1 Cor. 14:14] </span></span><span class=\"content\">spirit and soul and body be kept blameless at </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See ch. 2:19</span></span><span class=\"content\">the coming of our Lord Jesus Christ. </span></span><span class=\"verse v24\" data-usfm=\"1TH.5.24\"><span class=\"label\">24</span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">See 1 Cor. 1:9 </span></span><span class=\"content\">He who calls you is faithful; </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">[Phil. 1:6]</span></span><span class=\"content\">he will surely do it.</span></span></div><div class=\"p\"><span class=\"verse v24\" data-usfm=\"1TH.5.24\"><span class=\"content\">  </span></span><span class=\"verse v25\" data-usfm=\"1TH.5.25\"><span class=\"label\">25</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    \n        2 Thess. 3:1; Heb. 13:18  </span></span><span class=\"content\">Brothers, pray for us.</span></span></div><div class=\"p\"><span class=\"verse v25\" data-usfm=\"1TH.5.25\"><span class=\"content\">  </span></span><span class=\"verse v26\" data-usfm=\"1TH.5.26\"><span class=\"label\">26</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Rom. 16:16  </span></span><span class=\"content\">Greet all the brothers with a holy kiss.</span></span></div><div class=\"p\"><span class=\"verse v26\" data-usfm=\"1TH.5.26\"><span class=\"content\">  </span></span><span class=\"verse v27\" data-usfm=\"1TH.5.27\"><span class=\"label\">27</span><span class=\"content\">I put you under oath before the Lord to have </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">Col. 4:16</span></span><span class=\"content\">this letter read to all the brothers.</span></span></div><div class=\"p\"><span class=\"verse v27\" data-usfm=\"1TH.5.27\"><span class=\"content\">  </span></span><span class=\"verse v28\" data-usfm=\"1TH.5.28\"><span class=\"label\">28</span><span class=\"content\">  </span><span class=\"note x\"><span class=\"label\">#</span><span class=\" body\">    See Rom. 16:20  </span></span><span class=\"content\">The grace of our Lord Jesus Christ be with you.</span></span></div>\n        </div>\n    </div>\n</div>", "copyright": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "next": {"canonical": true, "usfm": ["2TH.1"], "human": "2 Thessalonians 1", "toc": true, "version_id": 59}, "previous": {"canonical": true, "usfm": ["1TH.4"], "human": "1 Thessalonians 4", "toc": true, "version_id": 59}, "reference": {"usfm": ["1TH.5"], "human": "1 Thessalonians 5", "version_id": 59}}, "usfm": "1TH.5.ESV", "locale": "en", "versionData": {"audio": true, "copyright_short": {"html": "<p>The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers.</p>", "text": "The Holy Bible, English Standard Version\u00ae (ESV\u00ae), copyright \u00a9 2001 by Crossway, a publishing ministry of Good News Publishers."}, "id": 59, "language": {"iso_639_1": "en", "iso_639_3": "eng", "language_tag": "eng", "local_name": "English", "text_direction": "ltr"}, "local_abbreviation": "ESV", "local_title": "English Standard Version 2016", "publisher": {"name": "Crossway / Good News Publishers"}, "reader_footer": {"html": "<p>The Holy Bible, English Stand